<%- include('partials/header', { title: 'إدارة التصنيفات' , pageTitle: 'التصنيفات' , page: 'categories' }) %>

    <div class="card">
        <div class="card-header">
            <h2 class="card-title">
                <i class="fas fa-tags"></i> جميع التصنيفات
            </h2>
            <button onclick="showAddForm()" class="btn btn-primary">
                <i class="fas fa-plus"></i> إضافة تصنيف جديد
            </button>
        </div>

        <!-- Add Form (hidden by default) -->
        <div id="addForm"
            style="display: none; margin-bottom: 2rem; padding: 1.5rem; background: var(--light-gray); border-radius: var(--radius-md);">
            <h3 style="margin-bottom: 1rem; color: var(--dark-gray);">
                <i class="fas fa-plus"></i> إضافة تصنيف جديد
            </h3>
            <form method="POST" action="/admin/categories" enctype="multipart/form-data">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="two-col-grid">
                    <div class="form-group">
                        <label class="form-label">اسم التصنيف <span style="color: var(--danger);">*</span></label>
                        <input type="text" name="name" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label">الصورة</label>
                        <input type="file" name="image" class="form-control" accept="image/*">
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">الوصف</label>
                    <textarea name="description" class="form-control" rows="2"></textarea>
                </div>
                <div style="display: flex; gap: 0.5rem;">
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="fas fa-save"></i> إضافة
                    </button>
                    <button type="button" onclick="hideAddForm()" class="btn btn-secondary btn-sm">إلغاء</button>
                </div>
            </form>
        </div>

        <% if (categories && categories.length> 0) { %>
            <p style="font-size: 0.85rem; color: var(--medium-gray); margin-bottom: 1rem;">
                <i class="fas fa-arrows-alt"></i> رتّب زي ما تحب: اسحب الكارت على الكمبيوتر، أو استخدم أزرار <i class="fas fa-arrow-up"></i><i class="fas fa-arrow-down"></i> على الموبايل — الترتيب بيتحفظ تلقائي.
            </p>
            <div id="categoryGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.5rem;">
                <% categories.forEach((category, idx)=> { %>
                    <div class="card category-card" draggable="true" data-id="<%= category.id %>" data-sort="<%= category.sort_order %>"
                        style="margin: 0; transition: transform var(--transition-fast); cursor: grab; position: relative;">
                        <div style="position: absolute; top: 0.75rem; right: 0.75rem; display: flex; gap: 0.35rem; z-index: 5;">
                            <span class="order-badge" style="background: var(--primary-color); color: #fff; font-weight: bold; font-size: 0.75rem; border-radius: 999px; min-width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; padding: 0 8px;">#<%= idx + 1 %></span>
                            <button type="button" class="btn btn-secondary btn-sm move-btn" data-dir="-1" title="انقل للأعلى"
                                style="width: 28px; height: 28px; padding: 0; border-radius: 999px; display: inline-flex; align-items: center; justify-content: center;">
                                <i class="fas fa-arrow-up"></i>
                            </button>
                            <button type="button" class="btn btn-secondary btn-sm move-btn" data-dir="1" title="انقل للأسفل"
                                style="width: 28px; height: 28px; padding: 0; border-radius: 999px; display: inline-flex; align-items: center; justify-content: center;">
                                <i class="fas fa-arrow-down"></i>
                            </button>
                        </div>
                        <% if (category.image) { %>
                            <div
                                style="height: 150px; border-radius: var(--radius-md); overflow: hidden; margin-bottom: 1rem;">
                                <img src="<%= category.image %>" alt="<%= category.name %>"
                                    style="width: 100%; height: 100%; object-fit: cover;">
                            </div>
                            <% } else { %>
                                <div
                                    style="height: 150px; border-radius: var(--radius-md); background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary-color) 100%); display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
                                    <i class="fas fa-folder"
                                        style="font-size: 3rem; color: var(--dark); opacity: 0.3;"></i>
                                </div>
                                <% } %>

                                    <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--dark-gray);">
                                        <%= category.name %>
                                    </h3>

                                    <p style="font-size: 0.85rem; color: var(--medium-gray); margin-bottom: 1rem;">
                                        <%= category.description || 'لا يوجد وصف' %>
                                    </p>

                                    <div style="display: flex; gap: 0.5rem;">
                                        <a href="/admin/categories/<%= category.id %>/edit" class="btn btn-secondary btn-sm"
                                            style="flex: 1;">
                                            <i class="fas fa-edit"></i> تعديل
                                        </a>
                                        <button
                                            onclick="handleDelete('/admin/categories/<%= category.id %>', 'هذا التصنيف')"
                                            class="btn btn-danger btn-sm">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                    </div>
                    <% }) %>
            </div>
            <% } else { %>
                <div class="text-center" style="padding: 3rem; color: var(--medium-gray);">
                    <i class="fas fa-tags" style="font-size: 4rem; margin-bottom: 1rem; opacity: 0.3;"></i>
                    <p style="font-size: 1.1rem;">لا توجد تصنيفات حتى الآن</p>
                    <button onclick="showAddForm()" class="btn btn-primary" style="margin-top: 1rem;">
                        <i class="fas fa-plus"></i> إضافة أول تصنيف
                    </button>
                </div>
                <% } %>
    </div>

    <script>
        function showAddForm() {
            document.getElementById('addForm').style.display = 'block';
        }

        function hideAddForm() {
            document.getElementById('addForm').style.display = 'none';
        }

        // Override handleDelete for categories (uses POST to /categories/:id/delete)
        async function handleDelete(url, itemName) {
            showConfirm(`هل أنت متأكد من حذف ${itemName}؟`, async () => {
                try {
                    const res = await fetch(url, {
                        method: 'DELETE',
                        headers: {
                            'X-CSRF-Token': '<%= csrfToken %>'
                        }
                    });
                    const data = await res.json();
                    if (data.success) {
                        showToast('تم الحذف بنجاح', 'success');
                        setTimeout(() => window.location.reload(), 1000);
                    } else {
                        showToast(data.message || 'فشل الحذف', 'error');
                    }
                } catch (err) {
                    showToast('حدث خطأ أثناء الحذف', 'error');
                }
            });
        }

        // ===== Reorder (drag on desktop + arrow buttons on touch) =====
        (function () {
            const grid = document.getElementById('categoryGrid');
            if (!grid) return;
            let dragEl = null;

            function refreshBadges() {
                [...grid.querySelectorAll('.category-card')].forEach((c, i) => {
                    const badge = c.querySelector('.order-badge');
                    if (badge) badge.textContent = '#' + (i + 1);
                });
            }

            grid.addEventListener('dragstart', (e) => {
                const card = e.target.closest('.category-card');
                if (!card) return;
                dragEl = card;
                card.style.opacity = '0.4';
                e.dataTransfer.effectAllowed = 'move';
                try { e.dataTransfer.setData('text/plain', card.dataset.id); } catch (err) { }
            });

            grid.addEventListener('dragend', () => {
                if (dragEl) {
                    dragEl.style.opacity = '';
                    dragEl = null;
                    refreshBadges();
                    persistOrder();
                }
            });

            grid.addEventListener('dragover', (e) => {
                e.preventDefault();
                e.dataTransfer.dropEffect = 'move';
                if (!dragEl) return;
                const target = e.target.closest('.category-card');
                if (!target || target === dragEl) return;
                const rect = target.getBoundingClientRect();
                const isAfter = (e.clientX - rect.left) > rect.width / 2;
                grid.insertBefore(dragEl, isAfter ? target.nextSibling : target);
            });

            // Arrow buttons: work everywhere (touch + desktop)
            grid.addEventListener('click', (e) => {
                const btn = e.target.closest('.move-btn');
                if (!btn) return;
                const card = btn.closest('.category-card');
                if (!card) return;
                const dir = parseInt(btn.dataset.dir, 10);
                if (dir < 0 && card.previousElementSibling) {
                    grid.insertBefore(card, card.previousElementSibling);
                } else if (dir > 0 && card.nextElementSibling) {
                    grid.insertBefore(card.nextElementSibling, card);
                } else {
                    return;
                }
                refreshBadges();
                persistOrder();
            });

            async function persistOrder() {
                const cards = [...grid.querySelectorAll('.category-card')];
                const payload = cards.map((c, i) => ({ id: c.dataset.id, sort_order: i + 1 }));
                try {
                    const res = await fetch('/admin/categories/reorder', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'CSRF-Token': '<%= csrfToken %>'
                        },
                        body: JSON.stringify({ categories: payload })
                    });
                    const data = await res.json();
                    if (data.success) {
                        showToast('تم حفظ الترتيب بنجاح', 'success');
                    } else {
                        showToast(data.message || 'فشل حفظ الترتيب', 'error');
                    }
                } catch (err) {
                    showToast('حدث خطأ أثناء حفظ الترتيب', 'error');
                }
            }
        })();
    </script>

    <%- include('partials/footer') %>