<%- include('partials/header', { title: 'إدارة المستخدمين' , pageTitle: 'المستخدمين' , page: 'users' }) %>

    <div class="card">
        <div class="card-header">
            <h2 class="card-title">
                <i class="fas fa-users"></i> جميع المستخدمين
            </h2>
            <span class="badge badge-info" style="font-size:0.85rem;"><%= pagination ? pagination.total : (users ? users.length : 0) %> مستخدم</span>
        </div>

        <form method="GET" action="/admin/users" class="users-toolbar" role="search">
            <label for="users-search" class="visually-hidden">بحث عن مستخدم</label>
            <input id="users-search" type="search" name="q" value="<%= search || '' %>"
                class="form-control" placeholder="ابحث بالاسم أو البريد أو الهاتف">
            <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> بحث</button>
            <% if (search) { %>
                <a href="/admin/users" class="btn btn-secondary">مسح</a>
            <% } %>
        </form>

        <% if (users && users.length > 0) { %>
            <div class="table-responsive">
                <table class="modern-table" style="width:100%;">
                    <thead>
                        <tr>
                            <th>المستخدم</th>
                            <th>البريد الإلكتروني</th>
                            <th>رقم الهاتف</th>
                            <th>الحالة</th>
                            <th>تاريخ التسجيل</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(user => { %>
                            <tr>
                                <td data-label="المستخدم">
                                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                                        <% if (user.avatar_url) { %>
                                            <img src="<%= user.avatar_url %>" alt="<%= user.name %>"
                                                style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover; flex-shrink:0;">
                                        <% } else { %>
                                            <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--brand-light); display: flex; align-items: center; justify-content: center; font-weight: bold; color: var(--brand-primary); flex-shrink:0;">
                                                <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
                                            </div>
                                        <% } %>
                                        <span style="font-weight: 700; font-size:0.9rem;">
                                            <%= user.name || 'غير متوفر' %>
                                        </span>
                                    </div>
                                </td>
                                <td data-label="البريد الإلكتروني" style="direction:ltr; text-align:right;">
                                    <%= user.email || '—' %>
                                </td>
                                <td data-label="رقم الهاتف" style="direction:ltr; text-align:right; font-weight:700;">
                                    <%= user.phone || '—' %>
                                </td>
                                <td data-label="الحالة">
                                    <span class="badge <%= user.is_phone_verified ? 'badge-success' : 'badge-warning' %>">
                                        <%= user.is_phone_verified ? '✓ موثق' : 'غير موثق' %>
                                    </span>
                                </td>
                                <td data-label="تاريخ التسجيل">
                                    <%= new Date(user.created_at).toLocaleDateString('ar-EG') %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% if (pagination && pagination.totalPages > 1) { %>
                <nav class="pagination-bar" aria-label="صفحات المستخدمين">
                    <a class="btn btn-secondary <%= pagination.page <= 1 ? 'disabled' : '' %>"
                        href="/admin/users?page=<%= pagination.page - 1 %>&q=<%= encodeURIComponent(search || '') %>"
                        <%= pagination.page <= 1 ? 'aria-disabled="true" tabindex="-1"' : '' %>>السابق</a>
                    <span>صفحة <%= pagination.page %> من <%= pagination.totalPages %></span>
                    <a class="btn btn-secondary <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>"
                        href="/admin/users?page=<%= pagination.page + 1 %>&q=<%= encodeURIComponent(search || '') %>"
                        <%= pagination.page >= pagination.totalPages ? 'aria-disabled="true" tabindex="-1"' : '' %>>التالي</a>
                </nav>
            <% } %>
        <% } else { %>
            <div class="text-center" style="padding: 3rem; color: var(--text-muted);">
                <i class="fas fa-users" style="font-size: 4rem; margin-bottom: 1rem; opacity: 0.3; display:block;"></i>
                <p style="font-size: 1.1rem;">لا يوجد مستخدمين حتى الآن</p>
            </div>
        <% } %>
    </div>

    <%- include('partials/footer') %>