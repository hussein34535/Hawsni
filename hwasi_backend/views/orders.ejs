                <div>
                    <div style="color:rgba(255,255,255,0.7); font-size:0.75rem; font-weight:700; margin-bottom:4px;">📦 تتبع الشحنة</div>
                    <div id="trackingModalNumber" style="color:white; font-size:1.1rem; font-weight:900; letter-spacing:2px;"></div>
                </div>
                <button onclick="closeTrackingModal()" style="background:rgba(255,255,255,0.2); border:none; color:white; width:36px; height:36px; border-radius:50%; cursor:pointer; font-size:1.1rem; display:flex; align-items:center; justify-content:center;">✕</button>
            </div>
            <!-- Modal Body -->
            <div id="trackingModalBody" style="padding:24px; min-height:150px; display:flex; align-items:center; justify-content:center;">
                <div style="text-align:center; color:#94a3b8;">
                    <div style="font-size:2rem; margin-bottom:8px;">⏳</div>
                    <div style="font-weight:700;">جاري جلب بيانات التتبع...</div>
                </div>
            </div>
        </div>
    </div>

    <script>
    let currentTrackingNumber = null;

    function openTrackingModal() {
        const trackingNumEl = document.getElementById('bostaTrackingNumber');
        if (!trackingNumEl) return;
        // Read from data attribute first, fallback to stripping non-digits from text
        const num = trackingNumEl.dataset.trackingNum || trackingNumEl.textContent.replace(/[^0-9]/g, '');
        if (!num) {
            alert('لا يوجد رقم تتبع لهذا الطلب بعد.');
            return;
        }
        currentTrackingNumber = num;
        document.getElementById('trackingModalNumber').textContent = num;
        document.getElementById('bostaTrackingModal').style.display = 'flex';
        loadTrackingData(num);
    }

    function closeTrackingModal() {
        document.getElementById('bostaTrackingModal').style.display = 'none';
    }

    async function loadTrackingData(trackingNumber) {
        const body = document.getElementById('trackingModalBody');
        body.innerHTML = '<div style="text-align:center; color:#94a3b8; padding:20px;"><div style="font-size:2rem; margin-bottom:8px;">⏳</div><div style="font-weight:700;">جاري جلب بيانات التتبع...</div></div>';

        try {
            const res = await fetch('/api/track/' + trackingNumber);
            const json = await res.json();

            if (!res.ok || !json.success) {
                body.innerHTML = '<div style="text-align:center; color:#ef4444; padding:20px;"><div style="font-size:2rem; margin-bottom:8px;">⚠️</div><div style="font-weight:700;">' + (json.message || 'لم يتم العثور على الشحنة') + '</div></div>';
                return;
            }

            const t = json.data;
            const statusColor = t.isDelivered ? '#15803d' : t.isCancelled ? '#dc2626' : '#0E4435';

            let timelineHtml = '';
            if (t.timeline && t.timeline.length > 0) {
                timelineHtml = '<div style="margin-top:20px; border-top:1px solid #f1f5f9; padding-top:16px;"><div style="font-size:0.7rem; font-weight:800; color:#94a3b8; letter-spacing:1px; margin-bottom:12px;">سجل التتبع</div>';
                t.timeline.slice(0, 6).forEach((ev, i) => {
                    const dot = i === 0 ? '#0E4435' : '#e2e8f0';
                    const dateStr = ev.timestamp ? new Date(ev.timestamp).toLocaleString('ar-EG', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '';
                    timelineHtml += `<div style="display:flex; gap:12px; margin-bottom:12px; align-items:flex-start;">
                        <div style="width:9px; height:9px; border-radius:50%; background:${dot}; flex-shrink:0; margin-top:5px;"></div>
                        <div>
                            <div style="font-size:0.85rem; font-weight:800; color:${i===0?'#0E4435':'#475569'};">${ev.status}</div>
                            ${dateStr ? `<div style="font-size:0.72rem; color:#94a3b8; margin-top:2px;">${dateStr}</div>` : ''}
                        </div>
                    </div>`;
                });
                timelineHtml += '</div>';
            } else {
                timelineHtml = '<div style="margin-top:16px; text-align:center; color:#94a3b8; font-size:0.85rem;">الشحنة في مرحلة الاستلام، التفاصيل ستظهر قريباً...</div>';
            }

            body.innerHTML = `
                <div>
                    <div style="background:#f8fffe; border:1.5px solid #e0f0ea; border-radius:14px; padding:16px; margin-bottom:4px;">
                        <div style="font-size:1rem; font-weight:900; color:${statusColor}; margin-bottom:6px;">${t.status}</div>
                        ${t.city ? `<div style="font-size:0.8rem; color:#64748b;">📍 ${t.city}</div>` : ''}
                    </div>
                    ${timelineHtml}
                </div>`;
        } catch(e) {
            body.innerHTML = '<div style="text-align:center; color:#ef4444; padding:20px;"><div style="font-size:2rem; margin-bottom:8px;">❌</div><div style="font-weight:700;">خطأ في الاتصال بالسيرفر</div></div>';
        }
    }

    // Close modal on backdrop click
    document.getElementById('bostaTrackingModal').addEventListener('click', function(e) {
        if (e.target === this) closeTrackingModal();
    });
    </script>

