<%- include('partials/header', { title: 'إدارة الطلبات' , pageTitle: 'الطلبات' , page: 'orders' }) %>

    <!-- Summary Stats -->
    <div class="stats-grid">
        <% const totalRevenue=orders.reduce((acc, o)=> acc + parseFloat(o.total || 0), 0);
            const pendingOrders = orders.filter(o => o.status === 'Processing').length;
            const completedOrders = orders.filter(o => o.status === 'Delivered').length;
            %>
            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon" style="background: var(--brand-light); color: var(--brand-primary);"><i class="fas fa-dollar-sign"></i></div>
                    <div class="stat-label">إجمالي المبيعات</div>
                </div>
                <div class="stat-value">
                    <%= totalRevenue.toLocaleString() %> ج.م
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon" style="background: rgba(251, 191, 36, 0.18); color: var(--warning);"><i class="fas fa-clock"></i></div>
                    <div class="stat-label">طلبات قيد المعالجة</div>
                </div>
                <div class="stat-value">
                    <%= pendingOrders %>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon" style="background: rgba(52, 211, 153, 0.18); color: var(--success);"><i class="fas fa-check-circle"></i></div>
                    <div class="stat-label">طلبات مكتملة</div>
                </div>
                <div class="stat-value">
                    <%= completedOrders %>
                </div>
            </div>
            <div class="stat-card" onclick="togglePendingFilter()" style="cursor:pointer; transition:0.2s;" id="pendingReceiptCard" title="عرض طلبات بانتظار التأكيد">
                <div class="stat-header">
                    <div class="stat-icon" style="background:#ffedd5; color:#c2410c;"><i class="fas fa-file-invoice-dollar"></i></div>
                    <div class="stat-label">بانتظار التأكيد</div>
                </div>
                <div class="stat-value" id="pendingReceiptCount" style="color:#c2410c;">
                    <%= orders.filter(o => o.deposit_receipt_url && o.status !== 'Confirmed' && o.status !== 'Cancelled' && o.status !== 'Delivered').length %>
                </div>
            </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h2 class="card-title">
                <i class="fas fa-list-ul"></i> قائمة الطلبات الحالية
            </h2>

            <div id="bulkBar" class="bulk-actions-bar" style="display:none; align-items: center; gap: 1rem; flex-wrap: wrap;">
                <span id="selectedCount" class="badge badge-info" style="font-size: 0.9rem;">0 محدد</span>
                <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                    <select id="bulkStatusSelect" class="form-control" style="width: auto; height: 38px;">
                        <option value="">-- تغيير الحالة --</option>
                        <option value="Processing">قيد المعالجة</option>
                        <option value="Confirmed">تم التأكيد</option>
                        <option value="In Transit">مع شركة الشحن</option>
                        <option value="Shipped">في الطريق</option>
                        <option value="Delivered">تم التوصيل</option>
                        <option value="Cancelled">ملغي</option>
                    </select>
                    <label style="display:flex; align-items:center; gap:4px; margin:0; font-size: 0.85rem; font-weight:bold; color: #475569; cursor: pointer;">
                        <input type="checkbox" id="bulkSkipEmail" style="width:16px; height:16px; cursor: pointer;"> بدون إيميل
                    </label>
                    <button onclick="bulkChangeStatus()" class="btn btn-primary btn-sm" style="flex:1;">تطبيق</button>
                    <button onclick="bulkDelete()" class="btn btn-danger btn-sm" style="flex:1;"><i class="fas fa-trash"></i> حذف</button>
                    <button onclick="clearSelection()" class="btn btn-secondary btn-sm" style="flex:1;">إلغاء</button>
                </div>
            </div>
        </div>

        <% if (orders && orders.length> 0) { %>
            <div class="table-responsive">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th style="width:40px;">
                                <input type="checkbox" id="selectAll" onchange="toggleAll(this)">
                            </th>
                            <th>المنتج</th>
                            <th>العميل</th>
                            <th>رقم الطلب</th>
                            <th>المبلغ</th>
                            <th>الحالة</th>
                            <th>التاريخ</th>
                            <th style="width: 150px;">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% orders.forEach(order=> { %>
                            <% let cName='غير معروف' ; let cPhone='-' ; let cAddr='بدون عنوان' ; if (order.users) {
                                cName=order.users.name || cName; cPhone=order.users.phone || cPhone; } let
                                ship=order.shipping_address; if (typeof ship==='string' && ship.trim().startsWith('{'))
                                { try { ship=JSON.parse(ship); } catch (e) { } } if (typeof ship==='object' && ship
                                !==null) { cName=ship.name || ship.guestName || cName; cPhone=ship.phone ||
                                ship.guestPhone || cPhone; cAddr=ship.address || ship.shippingAddress || cAddr; } else
                                if (typeof ship==='string' && ship.trim() !=='' ) { cAddr=ship; } const
                                sMap={ 'Processing' : 'warning', 'Confirmed': 'primary', 'In Transit' : 'info'
                                , 'Shipped' : 'info', 'Delivered' : 'success' , 'Cancelled' : 'danger' };
                                const sClass = sMap[order.status] || 'warning'; 
                                const tMap = { 
                                    'Processing' : 'قيد المعالجة', 
                                    'Confirmed': 'تم التأكيد',
                                    'In Transit' : 'مع شركة الشحن', 
                                    'Shipped' : 'في الطريق',
                                    'Delivered' : 'تم التوصيل', 
                                    'Cancelled' : 'ملغي' 
                                };
                                const displayStatus = tMap[order.status] || (order.status ? order.status : 'غير محدد'); %>
                                <tr id="row-<%= order.id %>" class="order-row"
                                    onclick="showOrderDetails('<%= order.id %>')">
                                    <td data-label="تحديد" onclick="event.stopPropagation()">
                                        <input type="checkbox" class="order-checkbox" value="<%= order.id %>"
                                            onchange="updateBulkBar()">
                                    </td>
                                    <td data-label="المنتج">
                                        <div class="product-cell">
                                            <% if (order.product_image) { %>
                                                <img src="<%= order.product_image %>" class="product-img-lg">
                                                <% } else { %>
                                                    <div class="product-img-placeholder"><i class="fas fa-box"></i>
                                                    </div>
                                                    <% } %>
                                                        <div>
                                                            <div class="product-title">
                                                                <%= order.product_name %>
                                                            </div>
                                                            <% if (order.items_count> 1) { %>
                                                                 <div class="product-count">+ <%= order.items_count - 1
                                                                         %> منتجات أخرى</div>
                                                                 <% } %>
                                                             <% if (order.deposit_receipt_url && order.status !== 'Confirmed' && order.status !== 'Cancelled' && order.status !== 'Delivered') { %>
                                                                 <div class="receipt-badge"><i class="fas fa-file-invoice-dollar"></i> إيصال</div>
                                                             <% } %>
                                                        </div>
                                        </div>
                                    </td>
                                    <td data-label="العميل">
                                        <div class="customer-cell">
                                            <div class="avatar-small">
                                                <%= cName==='غير معروف' ? '?' : cName.charAt(0) %>
                                            </div>
                                            <div>
                                                <div class="customer-name">
                                                    <%= cName %>
                                                </div>
                                                <div class="customer-phone" style="display: flex; align-items: center; gap: 8px;">
                                                    <%= cPhone %>
                                                    <% 
                                                       let cp = (typeof cPhone === 'string' ? cPhone : '').replace(/\D/g, '');
                                                       if (cp.startsWith('01') && cp.length === 11) cp = '2' + cp;
                                                    %>
                                                    <a href="/admin/chat?sessionId=<%= cp %>" onclick="event.stopPropagation()" title="فتح المحادثة" style="color: #25d366; text-decoration: none;">
                                                       <i class="fab fa-whatsapp"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td data-label="رقم الطلب">
                                        <span class="order-id">#<%= order.id.substring(0, 8) %></span>
                                    </td>
                                    <td data-label="المبلغ">
                                        <% 
                                            const total = parseFloat(order.total || 0);
                                            const displayTotal = isNaN(total) ? '0.00' : total.toFixed(2);
                                        %>
                                        <span class="order-amount">
                                            <%= displayTotal %> ج.م
                                        </span>
                                    </td>
                                    <td data-label="الحالة">
                                        <span class="badge badge-<%= sClass %>">
                                            <%= displayStatus %>
                                        </span>
                                    </td>
                                    <td data-label="التاريخ">
                                        <div class="date-cell">
                                            <%= new Date(order.created_at).toLocaleDateString('ar-EG', { day: 'numeric'
                                                , month: 'short' }) %>
                                                <span>
                                                    <%= new Date(order.created_at).getFullYear() %>
                                                </span>
                                        </div>
                                    </td>
                                    <td data-label="تحكم" onclick="event.stopPropagation()">
                                        <div class="action-cell">
                                            <form method="POST" action="/admin/orders/<%= order.id %>/status">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <select name="status" class="status-select select-<%= sClass %>"
                                                    onchange="this.form.submit()">
                                                    <% if (!['Processing', 'Confirmed', 'In Transit', 'Shipped', 'Delivered', 'Cancelled'].includes(order.status)) { %>
                                                        <option value="" selected disabled>-- اختيار الحالة --</option>
                                                    <% } %>
                                                    <option value="Processing" <%=order.status==='Processing'
                                                        ? 'selected' : '' %>>قيد المعالجة</option>
                                                    <option value="Confirmed" <%=order.status==='Confirmed'
                                                        ? 'selected' : '' %>>تم التأكيد</option>
                                                    <option value="In Transit" <%=order.status==='In Transit'
                                                        ? 'selected' : '' %>>مع شركة الشحن</option>
                                                    <option value="Shipped" <%=order.status==='Shipped'
                                                        ? 'selected' : '' %>>في الطريق</option>
                                                    <option value="Delivered" <%=order.status==='Delivered' ? 'selected'
                                                        : '' %>>تم التوصيل</option>
                                                    <option value="Cancelled" <%=order.status==='Cancelled' ? 'selected'
                                                        : '' %>>ملغي</option>
                                                </select>
                                             </form>
                                              <% 
                                                  let cleanActionPhone = (typeof cPhone === 'string' ? cPhone : '').replace(/\D/g, '');
                                                  if (cleanActionPhone.startsWith('01') && cleanActionPhone.length === 11) cleanActionPhone = '2' + cleanActionPhone;
                                               %>
                                              <a href="/admin/chat?sessionId=<%= cleanActionPhone %>" onclick="event.stopPropagation()" class="btn-icon" title="دردشة واتساب" style="color: #25d366; text-decoration: none; display: inline-flex; align-items: center; justify-content: center;">
                                                 <i class="fab fa-whatsapp"></i>
                                              </a>
                                              <button class="btn-icon" onclick="event.stopPropagation(); openEditModal('<%= order.id %>')" title="تعديل الطلب" style="color: var(--info);">
                                                <i class="fas fa-edit"></i>
                                             </button>
                                             <button class="btn-icon text-danger"
                                                 onclick="deleteOrder('<%= order.id %>')" title="حذف الطلب">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                            <button class="btn-icon" onclick="showOrderDetails('<%= order.id %>')">
                                                <i class="fas fa-chevron-left"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-shopping-cart"></i>
                    <p>لا توجد طلبات حتى الآن</p>
                </div>
                <% } %>
        
        <!-- Pagination UI -->
        <% if (pagination && pagination.totalPages > 1) { %>
            <div class="pagination-container" style="display: flex; justify-content: center; align-items: center; gap: 10px; margin-top: 30px; padding: 20px;">
                <% if (pagination.page > 1) { %>
                    <a href="/admin/orders?page=<%= pagination.page - 1 %>&limit=<%= pagination.limit %>" class="btn btn-secondary btn-sm" style="background: white; color: var(--brand-primary); border: 1px solid #e2e8f0; padding: 8px 16px; border-radius: 8px; text-decoration: none; font-weight: bold;">
                        <i class="fas fa-chevron-right" style="margin-left: 5px;"></i> السابق
                    </a>
                <% } %>

                <div class="pagination-info" style="font-weight: bold; color: #64748b; font-size: 0.9rem;">
                    صفحة <%= pagination.page %> من <%= pagination.totalPages %>
                </div>

                <% if (pagination.page < pagination.totalPages) { %>
                    <a href="/admin/orders?page=<%= pagination.page + 1 %>&limit=<%= pagination.limit %>" class="btn btn-secondary btn-sm" style="background: white; color: var(--brand-primary); border: 1px solid #e2e8f0; padding: 8px 16px; border-radius: 8px; text-decoration: none; font-weight: bold;">
                        التالي <i class="fas fa-chevron-left" style="margin-right: 5px;"></i>
                    </a>
                <% } %>
            </div>
        <% } %>
    </div>

    <!-- Order Details Modal -->
    <div id="orderModal" class="modal" onclick="closeModal(event)">
        <div class="modal-content" onclick="event.stopPropagation()">
            <div class="modal-header">
                <div class="header-main">
                    <div class="header-id-group">
                        <span class="header-badge">تفاصيل الطلب</span>
                        <h3 id="modalOrderId" class="modal-title"></h3>
                    </div>
                    <p id="modalOrderDate" class="modal-subtitle"></p>
                </div>
                <div class="header-actions">
                    <div class="status-pill-group">
                        <div id="modalStatusBadge" class="badge" style="border: none; padding: 6px 12px; font-size: 0.8rem;"></div>
                        <select id="modalStatusSelect" class="status-select" onchange="changeModalStatus(this.value)" style="border: none; background: transparent; padding: 0;">
                        <option value="Processing">قيد المعالجة</option>
                        <option value="Confirmed">تم التأكيد</option>
                        <option value="In Transit">مع شركة الشحن</option>
                        <option value="Shipped">في الطريق</option>
                        <option value="Delivered">تم التوصيل</option>
                        <option value="Cancelled">ملغي</option>
                    </select>
                </div>
                    <label style="display:flex; align-items:center; gap:4px; justify-content: flex-end; margin-top:5px; font-size: 0.75rem; color:#64748b; cursor: pointer;">
                        <input type="checkbox" id="modalSkipEmail" style="cursor: pointer;"> بدون إيميل
                    </label>
                    <button type="button" class="modal-copy-btn" onclick="copyOrderDetails()" title="نسخ تفاصيل الطلب" aria-label="نسخ تفاصيل الطلب">
                        <i class="fas fa-copy"></i>
                        <span class="copy-label">نسخ التفاصيل</span>
                        <span class="copy-label-short">نسخ</span>
                    </button>
                    <button class="modal-close" onclick="closeModal()"><i class="fas fa-times"></i></button>
                </div>
            </div>

            <div class="modal-body">
                <div class="modal-grid">
                    <!-- Left Column: Products & Payment -->
                    <div class="column-main">
                        <div class="detail-section order-items">
                            <h4 class="section-title"><i class="fas fa-shopping-bag"></i> منتجات الطلب</h4>
                            <div id="modalItemsList" class="items-container">
                                <!-- Populated by JS -->
                            </div>
                        </div>

                        <div class="detail-section payment-summary">
                            <h4 class="section-title"><i class="fas fa-receipt"></i> ملخص الدفع</h4>
                            <div class="payment-grid">
                                <div class="payment-item">
                                    <span>المجموع الفرعي:</span>
                                    <span id="modalSubtotal"></span>
                                </div>
                                <div id="discountRow" class="payment-item discount">
                                    <span>الخصم (كوبون):</span>
                                    <span id="modalDiscount"></span>
                                </div>
                                <div class="payment-item total">
                                    <span>الإجمالي:</span>
                                    <span id="modalTotalAmount"></span>
                                </div>
                            </div>
                        </div>

                        <!-- AI Email Box (Moved here based on request) -->
                        <div class="ai-email-box" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 16px; padding: 16px; margin-top: 16px;">
                            <h5 style="margin: 0 0 12px 0; font-size: 0.85rem; color: #475569; font-weight: 800;"><i class="fas fa-magic" style="color: #8b5cf6;"></i> إيميل AI مخصص للتواصل</h5>
                            <div class="ai-email-input-row" style="display: flex; gap: 8px;">
                                <input type="text" id="aiEmailPrompt" placeholder="أكتب توجيه للذكاء الاصطناعي... (مثال: اعتذر عن التأخير وأبلغهم بشحن الطلب غداً)" style="flex: 1; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-family: 'Cairo', sans-serif; font-size: 0.8rem; outline: none;">
                                <button id="generateAiBtn" onclick="generateAiEmail()" style="background: #8b5cf6; color: white; border: none; padding: 0 16px; border-radius: 8px; font-weight: bold; cursor: pointer; transition: 0.2s; font-family: 'Cairo', sans-serif;">
                                    توليد رسالة
                                </button>
                            </div>
                            <div id="aiPreviewBox" style="display: none; background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px; margin-top: 12px; max-height: 200px; overflow-y: auto;">
                                <div id="aiEmailContent" style="font-size: 0.8rem; color: #334155;"></div>
                            </div>
                            <button id="sendAiEmailBtn" onclick="sendAiEmail()" style="display: none; width: 100%; justify-content: center; align-items: center; gap: 8px; background: #0ea5e9; color: white; border: none; padding: 10px; border-radius: 8px; font-weight: bold; cursor: pointer; transition: 0.2s; font-family: 'Cairo', sans-serif; margin-top: 12px;">
                                <i class="fas fa-paper-plane"></i> إرسال الإيميل للعميل الآن
                            </button>
                        </div>

                    </div>

                    <!-- Right Column: Customer, Shipping & Actions -->
                    <div class="column-side">
                        <div class="detail-section customer-info">
                            <h4 class="section-title"><i class="fas fa-user-circle"></i> بيانات العميل</h4>
                            <div class="profile-card" style="padding: 20px; box-shadow: none; border: 1px solid rgba(0,0,0,0.05);">
                                <div id="modalAvatar" class="profile-avatar" style="width: 50px; height: 50px; font-size: 1.2rem;"></div>
                                <div class="profile-details">
                                    <h5 id="modalCustomerName" style="font-size: 1rem;"></h5>
                                    <div class="contact-line">
                                        <p id="modalCustomerPhone" style="direction: ltr; text-align: right; margin-bottom: 2px; font-weight: 800; color: #334155; font-size: 0.9rem;"></p>
                                        <button type="button" class="copy-mini" onclick="copyText(document.getElementById('modalCustomerPhone').textContent, 'تم نسخ رقم الهاتف')" title="نسخ رقم الهاتف" aria-label="نسخ رقم الهاتف"><i class="fas fa-copy"></i></button>
                                    </div>
                                    <div class="contact-line" id="modalCustomerPhone2Row" style="display: none;">
                                        <p id="modalCustomerPhone2" style="text-align: right; font-size: 0.75rem; color: #94a3b8;"></p>
                                        <button type="button" class="copy-mini" onclick="copyText(document.getElementById('modalCustomerPhone2').textContent.replace('هاتف بديل: ', ''), 'تم نسخ رقم الهاتف البديل')" title="نسخ الرقم البديل" aria-label="نسخ الرقم البديل"><i class="fas fa-copy"></i></button>
                                    </div>
                                    <div class="contact-line">
                                        <p id="modalCustomerEmail" class="email-text" style="font-size: 0.8rem;"></p>
                                        <button type="button" class="copy-mini" onclick="copyText(document.getElementById('modalCustomerEmail').textContent, 'تم نسخ الإيميل')" title="نسخ الإيميل" aria-label="نسخ الإيميل"><i class="fas fa-copy"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="detail-section shipping-info">
                            <h4 class="section-title"><i class="fas fa-map-marker-alt"></i> عنوان التوصيل</h4>
                            <div class="address-card" style="padding: 20px; border: 1px solid rgba(0,0,0,0.05);">
                                <div class="address-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
                                    <div class="address-item">
                                        <label>المحافظة:</label>
                                        <p id="shipState"></p>
                                    </div>
                                    <div class="address-item">
                                        <label>المدينة/المنطقة:</label>
                                        <p id="shipCity"></p>
                                    </div>
                                </div>
                                <div class="address-item" style="margin-bottom: 16px;">
                                    <label>الشارع:</label>
                                    <p id="shipStreet"></p>
                                </div>
                                <div class="address-full">
                                    <label>العنوان بالكامل:</label>
                                    <p id="modalAddressFull"></p>
                                </div>
                                <button class="btn-copy-address" onclick="copyAddress()" title="نسخ الشارع" aria-label="نسخ الشارع" style="margin-top: 16px; border: none; background: #e0f2fe; color: #0284c7;">
                                    <i class="fas fa-copy"></i> نسخ الشارع
                                </button>
                            </div>
                        </div>

                        <div id="modalNotesSection" class="detail-section" style="display: none;">
                            <h4 class="section-title"><i class="fas fa-sticky-note"></i> ملاحظات الطلب</h4>
                            <div class="address-card" style="border-color: #f59e0b; background: #fffcf0; padding: 15px;">
                                <p id="modalNotesText" style="margin: 0; font-weight: 700; color: #92400e; line-height: 1.6; font-size: 0.9rem;"></p>
                            </div>
                        </div>

                        <!-- Action Control Center -->
                        <div class="detail-section order-actions">
                            <h4 class="section-title"><i class="fas fa-bolt"></i> خيارات وإجراءات</h4>
                            
                            <!-- Payment Method Box -->
                            <div class="method-card" style="margin-bottom: 16px; padding: 16px;">
                                <i class="fas fa-money-bill-wave"></i>
                                <span id="modalPaymentMethod">الدفع عند الاستلام</span>
                            </div>

                            <!-- No Answer Box -->
                            <button id="noAnswerBtn" onclick="sendNoAnswerEmail()" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px; background: #fffcf0; border: 1px solid #fcd34d; color: #b45309; padding: 12px; border-radius: 12px; font-size: 0.9rem; font-weight: 800; cursor: pointer; transition: all 0.2s; font-family: 'Cairo', sans-serif; margin-bottom: 16px;">
                                <i class="fas fa-phone-slash"></i> إرسال تنبيه "لم يرد" للعميل
                            </button>

                            <div id="receiptBox" style="display: none; background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 16px; padding: 16px; margin-bottom: 16px;">
                                <h5 style="margin: 0 0 10px 0; font-size: 0.85rem; color: #0369a1; font-weight: 800;">
                                    <i class="fas fa-file-invoice-dollar"></i> إيصال التحويل
                                </h5>
                                <a id="receiptLink" href="#" target="_blank" style="display: block; border-radius: 12px; overflow: hidden; border: 1px solid #7dd3fc; position: relative; background: #fff;">
                                    <img id="receiptPreview" src="" style="width: 100%; height: 120px; object-fit: cover; transition: 0.3s; cursor: zoom-in;" alt="Receipt">
                                    <div style="position: absolute; bottom: 0; left: 0; right: 0; background: rgba(3,105,161,0.8); color: white; padding: 4px; font-size: 0.7rem; text-align: center; font-weight: 700;">
                                        عرض الصورة كاملة <i class="fas fa-external-link-alt" style="font-size: 0.6rem;"></i>
                                    </div>
                                </a>
                            </div>

                            <!-- AI Email Box (Moved to left column) -->

                            <!-- Bosta Shipping Box -->
                            <div class="bosta-box" style="background: #fff1f2; border: 1px solid #fecdd3; border-radius: 16px; padding: 16px;">
                                <h5 style="margin: 0 0 12px 0; font-size: 0.85rem; color: #e11d48; font-weight: 800;"><i class="fas fa-truck-fast"></i> الشحن (بوسطة)</h5>
                                
                                <div id="bostaNotSentBox" style="display: none;">
                                    <div style="margin-bottom: 12px;">
                                        <select id="bostaPackageSize" style="width: 100%; padding: 8px; border: 1px solid #fda4af; border-radius: 8px; font-family: 'Cairo', sans-serif; font-size: 0.85rem; color: #be123c; background: #fff;">
                                            <option value="SMALL">حجم صغير (مجوهرات/إكسسوار)</option>
                                            <option value="MEDIUM" selected>حجم متوسط (ملابس/أحذية)</option>
                                            <option value="LARGE">حجم كبير</option>
                                        </select>
                                    </div>
                                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
                                        <input type="checkbox" id="bostaAllowOpen" checked style="width: 14px; height: 14px; accent-color: #e11d48;">
                                        <label for="bostaAllowOpen" style="font-size: 0.8rem; font-weight: 700; color: #9f1239; cursor: pointer;">فتح الشحنة مسموح للعميل</label>
                                    </div>
                                    <button id="sendBostaBtn" onclick="sendToBosta()" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px; background: #e11d48; color: white; border: none; padding: 10px; border-radius: 8px; font-weight: 800; cursor: pointer; transition: 0.2s; font-family: 'Cairo', sans-serif;">
                                        إرسال الطلب لبوسطة <i class="fas fa-arrow-left" style="font-size: 0.8rem;"></i>
                                    </button>
                                </div>

                                <div id="bostaSentBox" style="display: none;">
                                    <div style="background: white; padding: 12px; border-radius: 8px; font-size: 0.85rem; font-weight: 800; color: #1e40af; text-align: center; margin-bottom: 12px; border: 1px dashed #bfdbfe;">
                                        <i class="fas fa-check-circle" style="color: #3b82f6;"></i> رقم البوليصة: <br>
                                        <span id="bostaTrackingNumber" style="font-size: 1.1rem; letter-spacing: 1px; display: inline-block; margin-top: 4px;"></span>
                                    </div>
                                    <div style="display: flex; gap: 8px;">
                                        <button onclick="openTrackingModal()" style="flex: 2; display: flex; align-items: center; justify-content: center; gap: 6px; background: #2563eb; color: white; padding: 8px; border-radius: 8px; font-size: 0.8rem; font-weight: 800; text-decoration: none; border: none; cursor: pointer; font-family: 'Cairo', sans-serif;">
                                            <i class="fas fa-search-location"></i> تتبع الشحنة
                                        </button>
                                        <button onclick="showResendBosta()" style="flex: 1; border: 1px solid #cbd5e1; background: white; color: #64748b; padding: 8px; border-radius: 8px; font-weight: 800; cursor: pointer; font-family: 'Cairo', sans-serif; font-size: 0.8rem;">
                                            تعديل
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="copyToast" class="copy-toast" role="status" aria-live="polite">
        <i class="fas fa-check-circle"></i><span>تم النسخ</span>
    </div>
    <script id="orders-data" type="application/json">
        <%- JSON.stringify(orders) %>
    </script>
    <script>
        const ordersData = JSON.parse(document.getElementById('orders-data').textContent || '[]');
        const CSRF_TOKEN = '<%= csrfToken %>';
        const sMap = {
            'Processing': 'warning',
            'Confirmed': 'primary',
            'In Transit': 'info',
            'Shipped': 'info',
            'Delivered': 'success',
            'Cancelled': 'danger'
        };
        const tMap = {
            'Processing': 'قيد المعالجة',
            'Confirmed': 'تم التأكيد',
            'In Transit': 'مع شركة الشحن',
            'Shipped': 'في الطريق',
            'Delivered': 'تم التوصيل',
            'Cancelled': 'ملغي'
        };

        // Pending receipt filter
        let pendingFilterActive = false;

        function togglePendingFilter() {
            pendingFilterActive = !pendingFilterActive;
            const card = document.getElementById('pendingReceiptCard');
            const rows = document.querySelectorAll('.order-row');
            if (pendingFilterActive) {
                card.classList.add('active');
                rows.forEach(row => {
                    if (!row.dataset.hasPendingReceipt) row.style.display = 'none';
                });
            } else {
                card.classList.remove('active');
                rows.forEach(row => row.style.display = '');
            }
        }

        // Mark rows with pending receipts on load
        document.addEventListener('DOMContentLoaded', function() {
            ordersData.forEach(o => {
                if (o.deposit_receipt_url && o.status !== 'Confirmed' && o.status !== 'Cancelled' && o.status !== 'Delivered') {
                    const row = document.getElementById('row-' + o.id);
                    if (row) {
                        row.classList.add('pending-receipt');
                        row.dataset.hasPendingReceipt = 'true';
                    }
                }
            });
        });

        let currentOrderId = null;
        function showOrderDetails(orderId) {
            currentOrderId = orderId;
            const order = ordersData.find(o => o.id === orderId);
            if (!order) return;

            // Reset No Answer Button state
            const noAnswerBtn = document.getElementById('noAnswerBtn');
            if (noAnswerBtn) {
                noAnswerBtn.innerHTML = '<span>📞</span><span>إرسال تنبيه "لم يرد"</span>';
                noAnswerBtn.disabled = false;
                noAnswerBtn.style.borderColor = '#f59e0b';
                noAnswerBtn.style.color = '#92400e';
            }

            // Reset AI Box state
            document.getElementById('aiEmailPrompt').value = '';
            document.getElementById('aiPreviewBox').style.display = 'none';
            document.getElementById('aiEmailContent').innerHTML = '';
            document.getElementById('sendAiEmailBtn').style.display = 'none';

            // Check Bosta state
            if (order.bosta_id || order.tracking_number) {
                document.getElementById('bostaNotSentBox').style.display = 'none';
                document.getElementById('bostaSentBox').style.display = 'block';
                document.getElementById('bostaTrackingNumber').textContent = order.tracking_number || '';
                document.getElementById('bostaTrackingNumber').dataset.trackingNum = order.tracking_number;
                document.getElementById('sendBostaBtn').disabled = false;
                document.getElementById('sendBostaBtn').innerHTML = '<i class="fas fa-box-open"></i> إرسال الطلب إلى بوسطة';
            } else {
                document.getElementById('bostaNotSentBox').style.display = 'block';
                document.getElementById('bostaSentBox').style.display = 'none';
                document.getElementById('sendBostaBtn').disabled = false;
                document.getElementById('sendBostaBtn').innerHTML = '<i class="fas fa-box-open"></i> إرسال الطلب إلى بوسطة';
            }

            // Receipt logic
            const receiptBox = document.getElementById('receiptBox');
            if (order.deposit_receipt_url) {
                document.getElementById('receiptPreview').src = order.deposit_receipt_url;
                document.getElementById('receiptLink').href = order.deposit_receipt_url;
                receiptBox.style.display = 'block';
            } else {
                receiptBox.style.display = 'none';
            }

            // Update Header & Badge
            document.getElementById('modalOrderId').textContent = 'طلب رقم ' + order.id.substring(0, 8);
            document.getElementById('modalOrderDate').textContent = new Date(order.created_at).toLocaleString('ar-EG', {
                weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit'
            });

            const statusBadge = document.getElementById('modalStatusBadge');
            const statusText = tMap[order.status] || order.status || 'قيد المعالجة';
            statusBadge.textContent = statusText;
            statusBadge.className = 'badge badge-' + (sMap[order.status] || 'warning');

            const statusSelect = document.getElementById('modalStatusSelect');
            if (statusSelect) {
                statusSelect.value = order.status || 'Processing';
                statusSelect.className = 'status-select select-' + (sMap[order.status] || 'warning');
            }

            // Customer Details logic
            let cName = 'غير معروف';
            let cPhone = '-';
            let cEmail = 'لا يوجد إيميل';
            let ship = order.shipping_address;

            // Try to extract from linked user first
            if (order.users) {
                cName = order.users.name || cName;
                cPhone = order.users.phone || cPhone;
            }

            // Override with structured shipping address if available
            if (ship && typeof ship === 'object') {
                cName = ship.name || ship.guestName || cName;
                cPhone = ship.phone || ship.guestPhone || cPhone;
                cEmail = ship.email || ship.guestEmail || cEmail;

                let displayState = ship.state || null;
                let displayCity = ship.city || null;
                let displayStreet = ship.street || null;
                let fullAddress = ship.address || ship.shippingAddress || '-';

                // Fallback parsing for older orders where we only saved a concatenated string
                if (!displayState && !displayCity && fullAddress && typeof fullAddress === 'string' && fullAddress.includes(',')) {
                    const parts = fullAddress.split(',').map(s => s.trim());
                    if (parts.length >= 3) {
                        displayStreet = parts.slice(0, -2).join(', ');
                        displayCity = parts[parts.length - 2];
                        displayState = parts[parts.length - 1];
                    } else if (parts.length === 2) {
                        displayStreet = parts[0];
                        displayState = parts[1];
                    }
                }

                document.getElementById('shipState').textContent = displayState || '-';
                document.getElementById('shipCity').textContent = displayCity || '-';
                document.getElementById('shipStreet').textContent = displayStreet || fullAddress;
                document.getElementById('modalAddressFull').textContent = fullAddress;
            } else {
                let displayState = '-';
                let displayCity = '-';
                let displayStreet = '-';
                let fullAddress = ship || 'لا يوجد عنوان';

                if (typeof fullAddress === 'string' && fullAddress.includes(',')) {
                    const parts = fullAddress.split(',').map(s => s.trim());
                    if (parts.length >= 3) {
                        displayStreet = parts.slice(0, -2).join(', ');
                        displayCity = parts[parts.length - 2];
                        displayState = parts[parts.length - 1];
                    } else if (parts.length === 2) {
                        displayStreet = parts[0];
                        displayState = parts[1];
                    }
                }

                document.getElementById('shipState').textContent = displayState;
                document.getElementById('shipCity').textContent = displayCity;
                document.getElementById('shipStreet').textContent = displayStreet || fullAddress;
                document.getElementById('modalAddressFull').textContent = fullAddress;
            }

            document.getElementById('modalCustomerName').textContent = cName;
            document.getElementById('modalCustomerPhone').textContent = cPhone;
            
            const phone2Elem = document.getElementById('modalCustomerPhone2');
            const phone2Row = document.getElementById('modalCustomerPhone2Row');
            if (ship && ship.alternative_phone) {
                phone2Elem.textContent = 'هاتف بديل: ' + ship.alternative_phone;
                if (phone2Row) phone2Row.style.display = 'flex';
            } else {
                phone2Elem.textContent = '';
                if (phone2Row) phone2Row.style.display = 'none';
            }

            document.getElementById('modalCustomerEmail').textContent = cEmail;
            document.getElementById('modalAvatar').textContent = cName === 'غير معروف' ? '?' : cName.charAt(0).toUpperCase();
            document.getElementById('modalPaymentMethod').textContent = order.payment_method || 'Cash on Delivery';
            
            // Handle Order Notes
            const notesSection = document.getElementById('modalNotesSection');
            const notesText = document.getElementById('modalNotesText');
            if (order.notes && order.notes.trim() !== '') {
                notesText.textContent = order.notes;
                notesSection.style.display = 'block';
            } else {
                notesSection.style.display = 'none';
            }

            // Items List Overhaul
            const itemsList = document.getElementById('modalItemsList');
            itemsList.innerHTML = '';

            (order.order_items || order.items || []).forEach(item => {
                const p = item.products || {};
                let img = item.image_url || ((p.images && p.images.length > 0) ? p.images[0] : '/placeholder.png');

                // Final safety: if the stored URL is a placeholder, try product gallery again
                if (img.includes('placeholder.png') && p.images && p.images.length > 0) {
                    img = p.images[0];
                }

                const itemDiv = document.createElement('div');
                itemDiv.className = 'premium-item-row';
                itemDiv.innerHTML = `
                    <div class="item-visual">
                        <img src="${img}" onerror="this.onerror=null; this.src='/placeholder.png';" class="item-img-detailed">
                    </div>
                    <div class="item-info">
                        <div class="item-name-row">
                            <span class="item-main-name">${p.name || item.name || 'منتج غير معروف'}</span>
                            <span class="item-qty">x${item.quantity}</span>
                        </div>
                        <div class="item-specs">
                            ${item.size ? `<span class="spec-tag">المقاس: ${item.size}</span>` : ''}
                            ${item.color ? `
                                <span class="spec-tag">
                                    اللون: 
                                    ${item.color.startsWith('#') ? `<span class="color-circle" style="background-color: ${item.color}"></span>` : ''}
                                    ${item.color}
                                </span>
                            ` : ''}
                        </div>
                    </div>
                    <div class="item-price-col">
                        <div class="unit-price">${parseFloat(item.price).toFixed(2)} ج.م</div>
                        <div class="total-line">${(item.quantity * item.price).toFixed(2)} ج.م</div>
                    </div>
                `;
                itemsList.appendChild(itemDiv);
            });

            // Financials — use order_items if available, fallback to subtotal field from DB
            const allItems = order.order_items || order.items || [];
            const subtotal = allItems.length > 0
                ? allItems.reduce((acc, item) => acc + (parseFloat(item.price || 0) * parseInt(item.quantity || 1)), 0)
                : parseFloat(order.subtotal || order.total || 0);
            document.getElementById('modalSubtotal').textContent = subtotal.toFixed(2) + ' ج.م';

            const discount = order.discount || 0;
            if (discount > 0) {
                document.getElementById('discountRow').style.display = 'flex';
                document.getElementById('modalDiscount').textContent = '-' + parseFloat(discount).toFixed(2) + ' ج.م';
            } else {
                document.getElementById('discountRow').style.display = 'none';
            }

            const totalAmount = parseFloat(order.total || 0);
            document.getElementById('modalTotalAmount').textContent = (isNaN(totalAmount) ? '0.00' : totalAmount.toFixed(2)) + ' ج.م';

            document.getElementById('orderModal').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        async function changeModalStatus(newStatus) {
            if (!currentOrderId) return;
            const statusSelect = document.getElementById('modalStatusSelect');
            const statusBadge = document.getElementById('modalStatusBadge');
            const originalStatus = statusSelect.value;
            
            // Show loading state
            statusSelect.disabled = true;
            statusBadge.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري التحديث...';
            
            try {
                const skipEmail = document.getElementById('modalSkipEmail').checked;
                const res = await fetch(`/admin/orders/${currentOrderId}/status`, {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        'X-CSRF-Token': CSRF_TOKEN
                    },
                    body: JSON.stringify({ status: newStatus, skipEmail })
                });
                
                const data = await res.json();
                
                if (data.success) {
                    // Update order in ordersData local cache
                    const orderIdx = ordersData.findIndex(o => o.id === currentOrderId);
                    if (orderIdx > -1) ordersData[orderIdx].status = newStatus;
                    
                    // Update Modal UI
                    statusBadge.textContent = tMap[newStatus] || newStatus;
                    statusBadge.className = 'badge badge-' + (sMap[newStatus] || 'warning');
                    statusSelect.className = 'status-select select-' + (sMap[newStatus] || 'warning');
                    
                    // Optional: update the row in the main table behind the modal
                    const row = document.getElementById(`row-${currentOrderId}`);
                    if (row) {
                        const rowBadge = row.querySelector('.badge');
                        if (rowBadge) {
                            rowBadge.textContent = tMap[newStatus] || newStatus;
                            rowBadge.className = 'badge badge-' + (sMap[newStatus] || 'warning');
                        }
                        const rowSelect = row.querySelector('.status-select');
                        if (rowSelect) {
                            rowSelect.value = newStatus;
                            rowSelect.className = 'status-select select-' + (sMap[newStatus] || 'warning');
                        }
                    }
                } else {
                    alert('خطأ: ' + (data.message || 'فشل التحديث'));
                    statusSelect.value = originalStatus;
                }
            } catch (err) {
                console.error('Update status error:', err);
                alert('حدث خطأ في الاتصال');
                statusSelect.value = originalStatus;
            } finally {
                statusSelect.disabled = false;
            }
        }

        function closeModal(event) {
            // If an event is passed and the clicked target isn't the backdrop, ignore it.
            if (event && event.target.id !== 'orderModal') {
                return;
            }
            document.getElementById('orderModal').classList.remove('active');
            document.body.style.overflow = '';
        }

        function showCopyToast(message) {
            const toast = document.getElementById('copyToast');
            if (!toast) return;
            const text = toast.querySelector('span');
            if (text) text.textContent = message || 'تم النسخ';
            toast.classList.add('show');
            clearTimeout(showCopyToast.timer);
            showCopyToast.timer = setTimeout(() => toast.classList.remove('show'), 1800);
        }

        function fallbackCopy(text) {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.focus();
            ta.select();
            try { document.execCommand('copy'); } catch (e) {}
            document.body.removeChild(ta);
        }

        function copyText(text, message) {
            if (!text) return;
            const done = () => showCopyToast(message || 'تم النسخ');
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(text).then(done).catch(() => {
                    fallbackCopy(text);
                    done();
                });
            } else {
                fallbackCopy(text);
                done();
            }
        }

        function copyAddress() {
            copyText(document.getElementById('shipStreet').textContent, 'تم نسخ الشارع');
        }

        function copyOrderDetails() {
            if (!currentOrderId) return;
            const order = ordersData.find(o => o.id === currentOrderId);
            if (!order) return;

            const money = n => Number(n || 0).toFixed(2) + ' ج.م';
            const shortId = (order.id || '').substring(0, 8);
            const phone = document.getElementById('modalCustomerPhone').textContent.trim();
            const phone2 = document.getElementById('modalCustomerPhone2').textContent.replace('هاتف بديل: ', '').trim();
            const email = document.getElementById('modalCustomerEmail').textContent.trim();
            const items = order.order_items || order.items || [];

            const lines = [
                'تفاصيل الطلب ' + shortId,
                'الحالة: ' + (tMap[order.status] || order.status || 'قيد المعالجة'),
                'التاريخ: ' + new Date(order.created_at).toLocaleString('ar-EG', {
                    weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit'
                }),
                '',
                'العميل: ' + document.getElementById('modalCustomerName').textContent.trim(),
                'الهاتف: ' + phone
            ];
            if (phone2) lines.push('هاتف بديل: ' + phone2);
            if (email && email !== 'لا يوجد إيميل') lines.push('الإيميل: ' + email);
            lines.push('العنوان: ' + document.getElementById('modalAddressFull').textContent.trim());
            lines.push('', 'المنتجات:');

            if (items.length === 0) {
                lines.push('• لا توجد منتجات');
            } else {
                items.forEach(item => {
                    const p = item.products || {};
                    const name = p.name || item.name || 'منتج غير معروف';
                    const specs = [];
                    if (item.size) specs.push('مقاس ' + item.size);
                    if (item.color) specs.push('لون ' + item.color);
                    const qty = parseInt(item.quantity || 1, 10) || 1;
                    const price = parseFloat(item.price || 0) || 0;
                    lines.push('• ' + name + (specs.length ? ' (' + specs.join(' - ') + ')' : '') + ' — ' + qty + ' × ' + money(price) + ' = ' + money(qty * price));
                });
            }

            lines.push('', 'المجموع الفرعي: ' + document.getElementById('modalSubtotal').textContent.trim());
            if (parseFloat(order.discount || 0) > 0) {
                lines.push('الخصم: ' + document.getElementById('modalDiscount').textContent.trim());
            }
            lines.push('الإجمالي: ' + document.getElementById('modalTotalAmount').textContent.trim());
            if (order.notes && order.notes.trim()) lines.push('', 'ملاحظات: ' + order.notes.trim());
            if (order.tracking_number) lines.push('رقم البوليصة: ' + order.tracking_number);

            copyText(lines.join('\n'), 'تم نسخ تفاصيل الطلب');
        }

        // Bulk Actions
        function getSelectedIds() {
            return [...document.querySelectorAll('.order-checkbox:checked')].map(cb => cb.value);
        }

        function updateBulkBar() {
            const ids = getSelectedIds();
            const bar = document.getElementById('bulkBar');
            document.getElementById('selectedCount').textContent = ids.length + ' محدد';
            bar.style.display = ids.length > 0 ? 'flex' : 'none';
        }

        function toggleAll(cb) {
            document.querySelectorAll('.order-checkbox').forEach(c => c.checked = cb.checked);
            updateBulkBar();
        }

        async function bulkChangeStatus() {
            const ids = getSelectedIds();
            const status = document.getElementById('bulkStatusSelect').value;
            const skipEmail = document.getElementById('bulkSkipEmail').checked;
            if (!ids.length || !status) return;

            try {
                const res = await fetch('/admin/orders/bulk-status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
                    body: JSON.stringify({ ids, status, skipEmail })
                });
                const data = await res.json();
                if (data.success) {
                    window.location.reload();
                }
            } catch (e) { }
        }

        async function bulkDelete() {
            const ids = getSelectedIds();
            if (!ids.length) {
                alert('الرجاء تحديد طلب واحد على الأقل للحذف.');
                return;
            }

            showConfirm(`تحذير: هل أنت متأكد من حذف ${ids.length} طلب نهائياً؟ لا يمكن التراجع عن هذه الخطوة.`, async () => {
                const deleteBtn = document.querySelector('button[onclick="bulkDelete()"]');
                if (deleteBtn) { deleteBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الحذف...'; deleteBtn.disabled = true; }

                try {
                    const res = await fetch('/admin/orders/bulk-delete', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
                        body: JSON.stringify({ ids })
                    });
                    const data = await res.json();
                    if (data.success) {
                        alert('تم الحذف بنجاح');
                        setTimeout(() => window.location.reload(), 200);
                    } else {
                        alert('خطأ من الخادم: ' + (data.message || 'غير معروف'));
                        if (deleteBtn) { deleteBtn.innerHTML = '<i class="fas fa-trash"></i> حذف'; deleteBtn.disabled = false; }
                    }
                } catch (e) {
                    console.error('Fetch error:', e);
                    alert('حدث خطأ في الاتصال أثناء الحذف');
                    if (deleteBtn) { deleteBtn.innerHTML = '<i class="fas fa-trash"></i> حذف'; deleteBtn.disabled = false; }
                }
            });
        }

        async function deleteOrder(orderId) {
            console.log('Attempting delete for:', orderId);
            showConfirm('هل أنت متأكد من حذف هذا الطلب نهائياً؟', async () => {
                // Find the delete button in the row to show loading state
                const row = document.getElementById(`row-${orderId}`);
                const deleteBtn = row ? row.querySelector('.btn-icon.text-danger') : null;
                const originalIcon = deleteBtn ? deleteBtn.innerHTML : '';

                if (deleteBtn) {
                    deleteBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                    deleteBtn.disabled = true;
                }

                try {
                    const res = await fetch(`/admin/orders/${orderId}/delete`, {
                        method: 'POST',
                        headers: { 'Accept': 'application/json', 'X-CSRF-Token': CSRF_TOKEN }
                    });

                    console.log(`Frontend: Delete response status: ${res.status}`);

                    if (!res.ok) {
                        const text = await res.text();
                        console.error(`Frontend: Delete failed with status ${res.status}. Response:`, text);
                        alert(`فشل الحذف (Status ${res.status}): يرجى التأكد من صلاحياتك.`);
                        if (deleteBtn) {
                            deleteBtn.innerHTML = originalIcon;
                            deleteBtn.disabled = false;
                        }
                        return;
                    }

                    const data = await res.json();
                    console.log('Frontend: Delete response data:', data);

                    if (data.success) {
                        alert('تم حذف الطلب بنجاح');
                        if (row) row.style.opacity = '0.5';
                        setTimeout(() => window.location.reload(), 300);
                    } else {
                        alert('فشل الحذف: ' + (data.message || 'خطأ غير معروف'));
                        if (deleteBtn) {
                            deleteBtn.innerHTML = originalIcon;
                            deleteBtn.disabled = false;
                        }
                    }
                } catch (err) {
                    console.error('Frontend: Critical error during deleteOrder:', err);
                    alert('حدث خطأ فني أثناء الحذف. راجع الكونسول لمزيد من التفاصيل.');
                    if (deleteBtn) {
                        deleteBtn.innerHTML = originalIcon;
                        deleteBtn.disabled = false;
                    }
                }
            });
        }

        // Close modal on Escape key
        document.addEventListener('keydown', function(event) {
            if (event.key === "Escape") {
                closeModal();
            }
        });

        async function sendNoAnswerEmail() {
            if (!currentOrderId) return;
            const btn = document.getElementById('noAnswerBtn');
            const orig = btn.innerHTML;
            btn.innerHTML = '<span>⏳</span><span>جاري الإرسال...</span>';
            btn.disabled = true;
            try {
                const res = await fetch(`/admin/orders/${currentOrderId}/no-answer`, { 
                    method: 'POST',
                    headers: { 'X-CSRF-Token': CSRF_TOKEN }
                });
                const data = await res.json();
                if (data.success) {
                    btn.innerHTML = '<span>✅</span><span>تم الإرسال!</span>';
                    btn.style.borderColor = '#16a34a';
                    btn.style.color = '#15803d';
                } else {
                    alert('خطأ: ' + data.message);
                    btn.innerHTML = orig;
                    btn.disabled = false;
                }
            } catch (e) {
                alert('حدث خطأ في الاتصال');
                btn.innerHTML = orig;
                btn.disabled = false;
            }
        }

        let currentGeneratedHtml = '';

        async function generateAiEmail() {
            if (!currentOrderId) return;
            const promptInput = document.getElementById('aiEmailPrompt');
            const prompt = promptInput.value.trim();
            if(!prompt) {
                alert('الرجاء كتابة الفكرة أولاً');
                return;
            }

            const btn = document.getElementById('generateAiBtn');
            const origHTML = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            btn.disabled = true;

            try {
                const res = await fetch(`/admin/orders/${currentOrderId}/generate-ai-email`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
                    body: JSON.stringify({ prompt })
                });

                const data = await res.json();
                if (data.success) {
                    currentGeneratedHtml = data.generatedHtml;
                    const emailPreviewTemplate = `
                        <div dir="rtl" style="font-family: 'Segoe UI', Tahoma, sans-serif; max-width: 100%; margin: 0 auto; background: #ffffff; border-radius: 12px; overflow: hidden; border: 1px solid #e8e8e8; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
                            <!-- Header -->
                            <div style="background: linear-gradient(135deg, #0E4435 0%, #1a6b54 100%); padding: 20px; text-align: center;">
                                <h1 style="color: #ffffff; margin: 0; font-size: 18px; font-weight: 900;">Hwasi</h1>
                                <p style="color: rgba(255,255,255,0.6); margin: 5px 0 0 0; font-size: 11px; font-weight: 600;">الفخامة في كل تفصيلة</p>
                            </div>
                            <!-- AI Body Content -->
                            <div style="padding: 24px 20px; font-size: 13px; color: #334155; line-height: 1.6;">
                                <p style="font-size: 11px; color: #94a3b8; margin-bottom: 12px;">إلى: عميل المتجر</p>
                                ${currentGeneratedHtml}
                            </div>
                            <!-- Footer -->
                            <div style="background: #f5f5f5; padding: 15px; text-align: center; border-top: 1px solid #eee;">
                                <p style="color: #0E4435; font-size: 11px; font-weight: 900; margin: 0;">Hwasi — Premium Fashion ✨</p>
                            </div>
                        </div>
                    `;
                    document.getElementById('aiEmailContent').innerHTML = emailPreviewTemplate;
                    // remove visual max height and padding from parent container as preview is self-contained
                    document.getElementById('aiPreviewBox').style.padding = '0';
                    document.getElementById('aiPreviewBox').style.background = 'transparent';
                    document.getElementById('aiPreviewBox').style.border = 'none';
                    document.getElementById('aiPreviewBox').style.display = 'block';
                    document.getElementById('sendAiEmailBtn').style.display = 'flex';
                } else {
                    alert('خطأ: ' + data.message);
                }
            } catch (err) {
                alert('حدث خطأ أثناء التوليد');
            } finally {
                btn.innerHTML = origHTML;
                btn.disabled = false;
            }
        }

        async function sendAiEmail() {
            if (!currentOrderId || !currentGeneratedHtml) return;
            
            const btn = document.getElementById('sendAiEmailBtn');
            const origHTML = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الإرسال...';
            btn.disabled = true;

            try {
                const res = await fetch(`/admin/orders/${currentOrderId}/send-ai-email`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
                    body: JSON.stringify({ htmlContent: currentGeneratedHtml })
                });

                const data = await res.json();
                if (data.success) {
                    btn.innerHTML = '<i class="fas fa-check"></i> تم الإرسال بنجاح!';
                    btn.style.background = '#16a34a';
                    setTimeout(() => {
                        document.getElementById('aiPreviewBox').style.display = 'none';
                        document.getElementById('aiEmailPrompt').value = '';
                        btn.style.display = 'none';
                        btn.style.background = '#0ea5e9';
                        btn.innerHTML = origHTML;
                    }, 3000);
                } else {
                    alert('خطأ: ' + data.message);
                    btn.innerHTML = origHTML;
                    btn.disabled = false;
                }
            } catch (err) {
                alert('حدث خطأ في الإرسال');
                btn.innerHTML = origHTML;
                btn.disabled = false;
            }
        }

        function showResendBosta() {
            if (confirm('هل أنت متأكد من إنشاء بوليصة شحن جديدة لهذا الطلب في بوسطة؟ \n(الضغط هنا سيفتح نافذة الإرسال لتقوم بتحديد الإعدادات مجدداً)')) {
                document.getElementById('bostaSentBox').style.display = 'none';
                document.getElementById('bostaNotSentBox').style.display = 'block';
            }
        }

        async function sendToBosta() {
            if (!currentOrderId) return;
            const btn = document.getElementById('sendBostaBtn');
            const sizeSelector = document.getElementById('bostaPackageSize');
            const allowOpenCheck = document.getElementById('bostaAllowOpen');
            
            const payload = {
                size: sizeSelector ? sizeSelector.value : 'MEDIUM',
                allowToOpenPackage: allowOpenCheck ? allowOpenCheck.checked : true
            };

            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري إرسال الطلب...';
            btn.disabled = true;

            try {
                const res = await fetch(`/admin/orders/${currentOrderId}/bosta-ship`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                
                if (data.success) {
                    // Update Local Data Cache
                    const orderIdx = ordersData.findIndex(o => o.id === currentOrderId);
                    if (orderIdx > -1) {
                        ordersData[orderIdx].tracking_number = data.trackingNumber;
                    }
                    
                    // Update Modal UI successfully
                    document.getElementById('bostaNotSentBox').style.display = 'none';
                    document.getElementById('bostaSentBox').style.display = 'block';
                    document.getElementById('bostaTrackingNumber').textContent = data.trackingNumber || '';
                    document.getElementById('bostaTrackingNumber').dataset.trackingNum = data.trackingNumber;
                    
                    alert('تم إنشاء الشحنة في بوسطة بنجاح!');
                } else {
                    alert('خطأ: ' + data.message);
                    btn.innerHTML = '<i class="fas fa-box-open"></i> إرسال الطلب إلى بوسطة';
                    btn.disabled = false;
                }
            } catch (err) {
                console.error(err);
                alert('حدث خطأ أثناء إرسال الطلب لبوسطة');
                btn.innerHTML = '<i class="fas fa-box-open"></i> إرسال الطلب إلى بوسطة';
                btn.disabled = false;
            }
        }
    </script>

