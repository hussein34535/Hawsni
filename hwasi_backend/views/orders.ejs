    <script>
    let productCatalog = []; // All products fetched once
    let editItemsData = []; // Current items in the edit form

    // ===== Edit Modal =====
    function openEditModal(id, name, phone, address, total) {
        const order = ordersData.find(o => o.id === id);
        if (!order) return;

        document.getElementById('edit-order-id').value = id;
        document.getElementById('editOrderLabel').textContent = '# ' + id.substring(0, 8);
        document.getElementById('editOrderModal').style.display = 'flex';

        // Customer Info
        document.getElementById('edit-customer-name').value = name || '';

        let ship = order.shipping_address;
        if (typeof ship === 'string') { try { ship = JSON.parse(ship); } catch(e) { ship = {}; } }

        document.getElementById('edit-customer-phone').value = (ship && ship.phone) || phone || '';
        document.getElementById('edit-customer-email').value = (ship && (ship.email || ship.guestEmail)) || '';
        document.getElementById('edit-customer-altphone').value = (ship && ship.alternative_phone) || '';

        // Address
        document.getElementById('edit-state').value = (ship && (ship.state || '')) || '';
        document.getElementById('edit-city').value = (ship && (ship.city || '')) || '';
        document.getElementById('edit-street').value = (ship && (ship.street || '')) || '';
        document.getElementById('edit-customer-address').value = (ship && (ship.address || ship.shippingAddress || '')) || address || '';

        // Financial
        document.getElementById('edit-discount').value = order.discount || 0;
        document.getElementById('edit-order-total').value = total || order.total || 0;
        document.getElementById('edit-payment-method').value = order.payment_method || 'Cash on Delivery';

        // Notes
        document.getElementById('edit-notes').value = order.notes || '';

        // Items - build editItemsData from order
        const allItems = order.order_items || order.items || [];
        editItemsData = allItems.map(item => ({
            id: item.id || null,
            product_id: item.product_id || (item.products && item.products.id) || null,
            name: (item.products && item.products.name) || item.name || 'منتج',
            size: item.size || '',
            color: item.color || '',
            quantity: item.quantity || 1,
            price: item.price || 0,
            image_url: item.image_url || (item.products && item.products.images && item.products.images[0]) || '',
            _removed: false
        }));
        renderEditItems();

        // Prefetch products for add-item search if not already loaded
        if (productCatalog.length === 0) {
            fetch('/api/products?limit=200')
                .then(r => r.json())
                .then(d => {
                    if (d.success && d.products) productCatalog = d.products;
                    else if (Array.isArray(d)) productCatalog = d;
                    else productCatalog = d.data || [];
                })
                .catch(() => { productCatalog = []; });
        }
    }

    function closeEditModal() {
        document.getElementById('editOrderModal').style.display = 'none';
    }
    document.getElementById('editOrderModal').addEventListener('click', function(e) {
        if (e.target === this) closeEditModal();
    });

    // ===== Items Rendering =====
    function renderEditItems() {
        const container = document.getElementById('editItemsContainer');
        const activeItems = editItemsData.filter(i => !i._removed);
        if (activeItems.length === 0) {
            container.innerHTML = '<div style="text-align:center; padding:20px; color:#94a3b8; font-size:0.85rem; font-weight:600;">لا توجد منتجات — أضف أول منتج</div>';
            return;
        }
        container.innerHTML = activeItems.map((item, idx) => {
            const actualIdx = editItemsData.indexOf(item);
            return `
                <div style="display:grid; grid-template-columns:1fr 80px 70px 80px 36px; gap:8px; align-items:center; padding:10px 12px; background:#f8fafc; border-radius:12px; border:1px solid #e2e8f0;">
                    <div>
                        <div style="font-weight:700; font-size:0.85rem; color:#1e293b;">${item.name}</div>
                        <div style="display:flex; gap:6px; margin-top:4px;">
                            <select onchange="updateEditItem(${actualIdx},'size',this.value)" style="padding:2px 6px; border:1px solid #e2e8f0; border-radius:6px; font-size:0.72rem; background:#fff;">
                                <option value="">مقاس</option>
                                ${(item._sizes || []).map(s => `<option value="${s}" ${item.size === s ? 'selected' : ''}>${s}</option>`).join('')}
                                <option value="__custom__" ${!['','XS','S','M','L','XL','XXL','3XL','4XL','5XL', ...(item._sizes||[])].includes(item.size) && item.size ? 'selected' : ''}>أخرى...</option>
                            </select>
                            ${!['XS','S','M','L','XL','XXL','3XL','4XL','5XL', ...(item._sizes||[])].includes(item.size) && item.size ? `<input type="text" value="${item.size}" onchange="updateEditItem(${actualIdx},'size',this.value)" style="width:50px; padding:2px 6px; border:1px solid #e2e8f0; border-radius:6px; font-size:0.72rem;">` : ''}
                            <input type="text" placeholder="لون" value="${item.color}" onchange="updateEditItem(${actualIdx},'color',this.value)" style="width:60px; padding:2px 6px; border:1px solid #e2e8f0; border-radius:6px; font-size:0.72rem;">
                        </div>
                    </div>
                    <div>
                        <label style="display:block; font-size:0.65rem; color:#94a3b8; font-weight:600; margin-bottom:2px;">الكمية</label>
                        <input type="number" min="1" value="${item.quantity}" onchange="updateEditItem(${actualIdx},'quantity',parseInt(this.value)||1)" style="width:100%; padding:4px 6px; border:1px solid #e2e8f0; border-radius:6px; font-size:0.8rem; box-sizing:border-box;">
                    </div>
                    <div>
                        <label style="display:block; font-size:0.65rem; color:#94a3b8; font-weight:600; margin-bottom:2px;">السعر</label>
                        <input type="number" min="0" step="0.01" value="${item.price}" onchange="updateEditItem(${actualIdx},'price',parseFloat(this.value)||0)" style="width:100%; padding:4px 6px; border:1px solid #e2e8f0; border-radius:6px; font-size:0.8rem; box-sizing:border-box;">
                    </div>
                    <div style="text-align:center;">
                        <button type="button" onclick="removeEditItem(${actualIdx})" style="background:none; border:none; color:#ef4444; cursor:pointer; font-size:1.1rem; padding:4px;" title="حذف المنتج">&times;</button>
                    </div>
                </div>
            `;
        }).join('');
    }

    function updateEditItem(idx, field, value) {
        if (editItemsData[idx]) {
            editItemsData[idx][field] = value;
        }
    }

    function removeEditItem(idx) {
        if (editItemsData[idx]) {
            if (editItemsData[idx].id) {
                editItemsData[idx]._removed = true; // Mark for deletion on save
            } else {
                editItemsData.splice(idx, 1); // New item, just remove
            }
            renderEditItems();
        }
    }

    function closeEditModal() {
        document.getElementById('editOrderModal').style.display = 'none';
    }
    document.getElementById('editOrderModal').addEventListener('click', function(e) {
        if (e.target === this) closeEditModal();
    });

    // ===== Items Rendering =====
    function renderEditItems() {
        const container = document.getElementById('editItemsContainer');
        const activeItems = editItemsData.filter(i => !i._removed);
        if (activeItems.length === 0) {
            container.innerHTML = '<div style="text-align:center; padding:20px; color:#94a3b8; font-size:0.85rem; font-weight:600;">لا توجد منتجات — أضف أول منتج</div>';
            return;
        }
        container.innerHTML = activeItems.map((item, idx) => {
            const actualIdx = editItemsData.indexOf(item);
            return `
                <div style="display:grid; grid-template-columns:1fr 80px 70px 80px 36px; gap:8px; align-items:center; padding:10px 12px; background:#f8fafc; border-radius:12px; border:1px solid #e2e8f0;">
                    <div>
                        <div style="font-weight:700; font-size:0.85rem; color:#1e293b;">${item.name}</div>
                        <div style="display:flex; gap:6px; margin-top:4px;">
                            <select onchange="updateEditItem(${actualIdx},'size',this.value)" style="padding:2px 6px; border:1px solid #e2e8f0; border-radius:6px; font-size:0.72rem; background:#fff;">
                                <option value="">مقاس</option>
                                ${(item._sizes || []).map(s => `<option value="${s}" ${item.size === s ? 'selected' : ''}>${s}</option>`).join('')}
                                <option value="__custom__" ${!['','XS','S','M','L','XL','XXL','3XL','4XL','5XL', ...(item._sizes||[])].includes(item.size) && item.size ? 'selected' : ''}>أخرى...</option>
                            </select>
                            ${!['XS','S','M','L','XL','XXL','3XL','4XL','5XL', ...(item._sizes||[])].includes(item.size) && item.size ? `<input type="text" value="${item.size}" onchange="updateEditItem(${actualIdx},'size',this.value)" style="width:50px; padding:2px 6px; border:1px solid #e2e8f0; border-radius:6px; font-size:0.72rem;">` : ''}
                            <input type="text" placeholder="لون" value="${item.color}" onchange="updateEditItem(${actualIdx},'color',this.value)" style="width:60px; padding:2px 6px; border:1px solid #e2e8f0; border-radius:6px; font-size:0.72rem;">
                        </div>
                    </div>
                    <div>
                        <label style="display:block; font-size:0.65rem; color:#94a3b8; font-weight:600; margin-bottom:2px;">الكمية</label>
                        <input type="number" min="1" value="${item.quantity}" onchange="updateEditItem(${actualIdx},'quantity',parseInt(this.value)||1)" style="width:100%; padding:4px 6px; border:1px solid #e2e8f0; border-radius:6px; font-size:0.8rem; box-sizing:border-box;">
                    </div>
                    <div>
                        <label style="display:block; font-size:0.65rem; color:#94a3b8; font-weight:600; margin-bottom:2px;">السعر</label>
                        <input type="number" min="0" step="0.01" value="${item.price}" onchange="updateEditItem(${actualIdx},'price',parseFloat(this.value)||0)" style="width:100%; padding:4px 6px; border:1px solid #e2e8f0; border-radius:6px; font-size:0.8rem; box-sizing:border-box;">
                    </div>
                    <div style="text-align:center;">
                        <button type="button" onclick="removeEditItem(${actualIdx})" style="background:none; border:none; color:#ef4444; cursor:pointer; font-size:1.1rem; padding:4px;" title="حذف المنتج">&times;</button>
                    </div>
                </div>
            `;
        }).join('');
    }

    function updateEditItem(idx, field, value) {
        if (editItemsData[idx]) {
            editItemsData[idx][field] = value;
        }
    }

    function removeEditItem(idx) {
        if (editItemsData[idx]) {
            if (editItemsData[idx].id) {
                editItemsData[idx]._removed = true; // Mark for deletion on save
            } else {
                editItemsData.splice(idx, 1); // New item, just remove
            }
            renderEditItems();
        }
    }

    // ===== Product Search =====
    let _addItemCallback = null;

    function addEditItemRow() {
        if (productCatalog.length === 0) {
            // Try fetching
            fetch('/api/products?limit=200')
                .then(r => r.json())
                .then(d => {
                    if (d.success && d.products) productCatalog = d.products;
                    else if (Array.isArray(d)) productCatalog = d;
                    else productCatalog = d.data || [];
                    showProductSearch();
                })
                .catch(() => { productCatalog = []; showProductSearch(); });
        } else {
            showProductSearch();
        }
    }

    function showProductSearch() {
        const results = document.getElementById('productSearchResults');
        document.getElementById('productSearchInput').value = '';
        renderProductList(productCatalog);
        document.getElementById('productSearchModal').style.display = 'flex';
    }

    function closeProductSearch() {
        document.getElementById('productSearchModal').style.display = 'none';
    }
    document.getElementById('productSearchModal').addEventListener('click', function(e) {
        if (e.target === this) closeProductSearch();
    });

    function renderProductList(products) {
        const container = document.getElementById('productSearchResults');
        if (!products || products.length === 0) {
            container.innerHTML = '<div style="text-align:center; padding:20px; color:#94a3b8; font-size:0.85rem;">لا توجد منتجات</div>';
            return;
        }
        container.innerHTML = products.map(p => `
            <div onclick="selectProductForEdit('${p.id}')" style="display:flex; align-items:center; gap:12px; padding:10px 12px; border-radius:12px; cursor:pointer; transition:0.15s; margin-bottom:4px; border:1px solid transparent;" 
                 onmouseover="this.style.background='#f1f5f9'; this.style.borderColor='#e2e8f0'" 
                 onmouseout="this.style.background='transparent'; this.style.borderColor='transparent'">
                <div style="width:36px; height:36px; border-radius:8px; overflow:hidden; flex-shrink:0; background:#f1f5f9;">
                    ${p.images && p.images[0] ? `<img src="${p.images[0]}" style="width:100%;height:100%;object-fit:cover;">` : '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:#94a3b8;"><i class="fas fa-box"></i></div>'}
                </div>
                <div style="flex:1;">
                    <div style="font-weight:700; font-size:0.85rem; color:#1e293b;">${p.name}</div>
                    <div style="font-size:0.72rem; color:#64748b;">${parseFloat(p.price).toFixed(2)} ج.م</div>
                </div>
                <div style="color:#0E4435; font-size:0.75rem; font-weight:700;"><i class="fas fa-plus-circle"></i> إضافة</div>
            </div>
        `).join('');
    }

    function filterProductList(query) {
        const q = query.trim().toLowerCase();
        if (!q) { renderProductList(productCatalog); return; }
        const filtered = productCatalog.filter(p =>
            p.name.toLowerCase().includes(q) ||
            (p.description && p.description.toLowerCase().includes(q))
        );
        renderProductList(filtered);
    }

    function selectProductForEdit(productId) {
        const p = productCatalog.find(pr => pr.id === productId);
        if (!p) return;
        
        const sizes = p.sizes || [];
        editItemsData.push({
            id: null,
            product_id: p.id,
            name: p.name,
            size: sizes.length > 0 ? sizes[0] : '',
            color: '',
            quantity: 1,
            price: parseFloat(p.price) || 0,
            image_url: (p.images && p.images[0]) || '',
            _removed: false,
            _sizes: sizes
        });
        
        // Re-fetch with sizes for this product
        const activeItems = editItemsData.filter(i => !i._removed);
        const lastItem = activeItems[activeItems.length - 1];
        if (lastItem && lastItem.product_id) {
            fetch('/api/products/' + lastItem.product_id)
                .then(r => r.json())
                .then(d => {
                    if (d.success && d.product) {
                        const idx = editItemsData.indexOf(lastItem);
                        if (idx > -1) {
                            editItemsData[idx]._sizes = d.product.sizes || [];
                            renderEditItems();
                        }
                    }
                })
                .catch(() => {});
        }
        
        closeProductSearch();
        renderEditItems();
    }

    // ===== Submit =====
    async function submitOrderEdit(event) {
        event.preventDefault();
        const id = document.getElementById('edit-order-id').value;
        const btn = document.getElementById('edit-submit-btn');
        
        const items = editItemsData.filter(i => !i._removed).map(i => ({
            id: i.id || null,
            product_id: i.product_id || null,
            name: i.name,
            size: i.size || null,
            color: i.color || null,
            quantity: parseInt(i.quantity) || 1,
            price: parseFloat(i.price) || 0,
            image_url: i.image_url || null
        }));

        // Also include removed items that were in DB so controller can delete them
        editItemsData.filter(i => i._removed && i.id).forEach(i => {
            items.push({ id: i.id, _removed: true });
        });

        const data = {
            customerName: document.getElementById('edit-customer-name').value,
            customerPhone: document.getElementById('edit-customer-phone').value,
            customerEmail: document.getElementById('edit-customer-email').value,
            customerAltPhone: document.getElementById('edit-customer-altphone').value,
            customerAddress: document.getElementById('edit-customer-address').value,
            state: document.getElementById('edit-state').value,
            city: document.getElementById('edit-city').value,
            street: document.getElementById('edit-street').value,
            items: items,
            discount: document.getElementById('edit-discount').value || 0,
            total: document.getElementById('edit-order-total').value,
            paymentMethod: document.getElementById('edit-payment-method').value,
            notes: document.getElementById('edit-notes').value
        };

        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الحفظ...';
        btn.disabled = true;

        try {
            const response = await fetch('/admin/orders/' + id + '/update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
                body: JSON.stringify(data)
            });
            const result = await response.json();
            if (result.success) {
                alert('✅ تم تحديث الطلب بالكامل بنجاح');
                window.location.reload();
            } else {
                alert('❌ خطأ: ' + (result.message || 'فشل التحديث'));
                btn.innerHTML = '<i class="fas fa-save"></i> حفظ كل التعديلات';
                btn.disabled = false;
            }
        } catch (err) {
            console.error('Update Error:', err);
            alert('❌ حدث خطأ في الاتصال');
            btn.innerHTML = '<i class="fas fa-save"></i> حفظ كل التعديلات';
            btn.disabled = false;
        }
    }

    function applyDepositDiscount() {
        const totalInput = document.getElementById('edit-order-total');
        const discountInput = document.getElementById('edit-discount');
        
        let currentTotal = parseFloat(totalInput.value) || 0;
        let currentDiscount = parseFloat(discountInput.value) || 0;
        
        if (currentTotal >= 70) {
            totalInput.value = (currentTotal - 70).toFixed(2);
            discountInput.value = (currentDiscount + 70).toFixed(2);
            
            // Animation effect to show it happened
            totalInput.style.background = '#fff7ed';
            setTimeout(() => totalInput.style.background = '#fff', 500);
        } else {
            alert('الإجمالي أقل من 70 جنيه!');
        }
    }

    // ===== Supabase Realtime for Deposits =====
    try {
        if (typeof sbClient !== 'undefined') {
            sbClient.channel('orders-receipts')
                .on('postgres_changes',
                    { event: 'UPDATE', schema: 'public', table: 'orders' },
                    async (payload) => {
                        const oldOrder = payload.old;
                        const newOrder = payload.new;
                        // Only notify if receipt_url changed from null → non-null
                        if (oldOrder && !oldOrder.deposit_receipt_url && newOrder.deposit_receipt_url) {
                            if (newOrder.status !== 'Confirmed' && newOrder.status !== 'Cancelled' && newOrder.status !== 'Delivered') {
                            // Update counter
                            const countEl = document.getElementById('pendingReceiptCount');
                            if (countEl) countEl.textContent = parseInt(countEl.textContent || '0') + 1;
                            // Highlight row
                            const row = document.getElementById('row-' + newOrder.id);
                            if (row) {
                                row.classList.add('pending-receipt');
                                row.dataset.hasPendingReceipt = 'true';
                            }
                            // Toast
                            const t = document.createElement('div');
                            t.style.cssText = 'position:fixed;bottom:20px;right:20px;z-index:99999;background:#c2410c;color:#fff;padding:14px 20px;border-radius:14px;font-size:0.9rem;font-weight:800;box-shadow:0 10px 30px rgba(0,0,0,0.25);animation:fadeInUp 0.3s ease;font-family:"Cairo",sans-serif;max-width:350px;direction:rtl;';
                            t.innerHTML = '<i class="fas fa-file-invoice-dollar"></i> إيصال جديد بانتظار التأكيد — <span style="opacity:0.8;">#' + (newOrder.id ? newOrder.id.substring(0,6) : '') + '</span>';
                            document.body.appendChild(t);
                            setTimeout(() => { t.style.opacity = '0'; t.style.transition = 'opacity 0.3s'; setTimeout(() => t.remove(), 400); }, 5000);
                            }
                        }
                    }
                )
                .subscribe();
        }
    } catch (e) { console.log('[Receipt] Realtime init skipped:', e.message); }
    </script>

