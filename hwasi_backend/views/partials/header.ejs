<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
    <meta name="theme-color" content="#0E4435">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <title>
        <%= locals.title || 'hwasi Admin' %>
    </title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/admin.css">
    <script>
        // Prevent FOUC: Apply dark mode before render
        (function() {
            const isDark = localStorage.getItem('adminDark') === 'true';
            if (isDark) {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
</head>

<body>
    <script>
        // Apply dark to <body> immediately — before any content paints.
        // (CSS rules target body.dark; DOMContentLoaded would be too late.)
        if (localStorage.getItem('adminDark') === 'true') {
            document.body.classList.add('dark');
        }
    </script>
    <div class="admin-layout">
        <!-- Collapsible Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <a href="/admin/dashboard" class="sidebar-brand">
                    <img src="<%= locals.settings && locals.settings.logo_url ? locals.settings.logo_url : '/images/logo.png' %>" onerror="this.src='https://ui-avatars.com/api/?name=H&background=0E4435&color=fff&rounded=true'" alt="Hwasi Logo" style="width: 38px; height: 38px; object-fit: contain; flex-shrink: 0; display: block;">
                    <h1>hwasi <span>Admin Panel</span></h1>
                </a>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section">
                    <div class="nav-section-title">الرئيسية</div>
                    <a href="/admin/dashboard" class="nav-link <%= page === 'dashboard' ? 'active' : '' %>">
                        <i class="fas fa-house"></i>
                        <span>لوحة التحكم</span>
                    </a>
                </div>

                <div class="nav-section">
                    <div class="nav-section-title">المتجر</div>
                    <a href="/admin/products" class="nav-link <%= page === 'products' ? 'active' : '' %>">
                        <i class="fas fa-box-open"></i>
                        <span>المنتجات</span>
                    </a>
                    <a href="/admin/categories" class="nav-link <%= page === 'categories' ? 'active' : '' %>">
                        <i class="fas fa-layer-group"></i>
                        <span>التصنيفات</span>
                    </a>
                    <a href="/admin/banners" class="nav-link <%= page === 'banners' ? 'active' : '' %>">
                        <i class="fas fa-images"></i>
                        <span>البنرات</span>
                    </a>
                </div>

                <div class="nav-section">
                    <div class="nav-section-title">العملاء</div>
                    <a href="/admin/orders" class="nav-link <%= page === 'orders' ? 'active' : '' %>">
                        <i class="fas fa-receipt"></i>
                        <span>الطلبات</span>
                    </a>
                    <a href="/admin/users" class="nav-link <%= page === 'users' ? 'active' : '' %>">
                        <i class="fas fa-users"></i>
                        <span>المستخدمين</span>
                    </a>
                </div>
                
                <div class="nav-section">
                    <div class="nav-section-title">الدعم</div>
                    <a href="/admin/chat" class="nav-link <%= locals.page === 'chat' ? 'active' : '' %>" id="chat-nav-link">
                        <i class="fas fa-comments"></i>
                        <span>شات الدعم</span>
                        <span id="chat-unread-badge" style="display:none;background:#e74c3c;color:#fff;font-size:11px;font-weight:700;padding:2px 7px;border-radius:10px;margin-right:auto;"></span>
                    </a>
                    <a href="/admin/reviews" class="nav-link <%= page === 'reviews' ? 'active' : '' %>">
                        <i class="fas fa-star"></i>
                        <span>التقييمات</span>
                    </a>
                </div>

                <div class="nav-section">
                    <div class="nav-section-title">المالية</div>
                    <a href="/admin/finance" class="nav-link <%= page === 'finance' ? 'active' : '' %>">
                        <i class="fas fa-calculator"></i>
                        <span>المحاسبة</span>
                    </a>
                </div>

                <div class="nav-section">
                    <div class="nav-section-title">الإعدادات</div>
                    <a href="/admin/settings" class="nav-link <%= page === 'settings' ? 'active' : '' %>">
                        <i class="fas fa-sliders"></i>
                        <span>المتجر</span>
                    </a>
                    <a href="/admin/shipping" class="nav-link <%= page === 'shipping' ? 'active' : '' %>">
                        <i class="fas fa-truck"></i>
                        <span>الشحن</span>
                    </a>
                </div>
            </nav>

            <!-- Logout -->
            <div style="padding: 10px 8px; border-top: 1px solid rgba(255,255,255,0.08);">
                <a href="/admin/logout"
                   onclick="return confirm('هل أنت متأكد من تسجيل الخروج؟')"
                   class="nav-link nav-logout">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>تسجيل الخروج</span>
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <div class="topbar">
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <button id="menuToggle" class="btn btn-secondary">
                        <i class="fas fa-bars"></i>
                    </button>
                    <h1 class="page-title">
                        <%= locals.pageTitle || locals.title || 'لوحة التحكم' %>
                    </h1>
                </div>

                <div class="topbar-actions">
                    <a href="<%= typeof process !== 'undefined' && process.env.STOREFRONT_URL ? process.env.STOREFRONT_URL : 'https://hwasi.com' %>" target="_blank" class="btn btn-secondary" title="عرض المتجر" style="width:40px;height:40px;padding:0;border-radius:50%;display:flex;align-items:center;justify-content:center;">
                        <i class="fas fa-external-link-alt"></i>
                    </a>
                    <button id="dark-mode-btn" onclick="toggleDark()" class="btn btn-secondary" title="الوضع الليلي" style="width:40px;height:40px;padding:0;border-radius:50%;">
                        <i class="fas fa-moon"></i>
                    </button>
                </div>
            </div>

            <div id="sidebarOverlay" class="sidebar-overlay" onclick="closeMobileMenu()"></div>

            <!-- Mobile Topbar (shows only on mobile) -->
            <div class="mobile-topbar" id="mobileTopbar">
                <button class="mobile-menu-btn" onclick="toggleMobileMenu()" id="mobileMenuBtn">
                    <i class="fas fa-bars"></i>
                </button>
                <span class="mobile-page-title"><%= locals.pageTitle || locals.title || 'لوحة التحكم' %></span>
                <button onclick="toggleDark()" class="mobile-menu-btn" title="الوضع الليلي" id="mobile-dark-btn">
                    <i class="fas fa-moon"></i>
                </button>
            </div>

            <div class="content-wrapper">
<script>
(function() {
    const badge = document.getElementById('chat-unread-badge');
    if (!badge) return;
    async function updateBadge() {
        // Skip network chatter when the tab is hidden or the page is bfcached
        if (document.hidden) return;
        try {
            const r = await fetch('/admin/chat/unread-count');
            const d = await r.json();
            if (d.success && d.count > 0) {
                badge.textContent = d.count > 99 ? '99+' : d.count;
                badge.style.display = 'inline-block';
            } else {
                badge.style.display = 'none';
            }
        } catch(e) {}
    }
    updateBadge();
    setInterval(updateBadge, 30000);
})();
</script>