<%- include('partials/header', { title: 'تعديل التصنيف', pageTitle: 'تعديل التصنيف', page: 'categories' }) %>

    <div class="card" style="max-width: 860px; margin: 0 auto;">
        <div class="card-header">
            <h2 class="card-title">
                <i class="fas fa-edit"></i> تعديل التصنيف
            </h2>
            <a href="/admin/categories" class="btn btn-secondary">
                <i class="fas fa-arrow-right"></i> رجوع
            </a>
        </div>

        <form method="POST" action="/admin/categories/<%= category.id %>" enctype="multipart/form-data" id="categoryForm">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="form-group">
                <label class="form-label">اسم التصنيف <span style="color: var(--danger);">*</span></label>
                <input type="text" id="name" name="name" class="form-control" value="<%= category.name %>" required>
            </div>

            <div class="form-group">
                <label class="form-label">الوصف</label>
                <textarea id="description" name="description" class="form-control" rows="2"><%= category.description || '' %></textarea>
            </div>

            <div class="form-group">
                <label class="form-label">صورة التصنيف</label>
                <input type="file" id="image" name="image" class="form-control" accept="image/*" onchange="previewImage(this)">
                <% if (category.image) { %>
                    <div id="imagePreview" style="margin-top: 0.75rem;">
                        <img src="<%= category.image %>" alt="صورة التصنيف" id="previewImg"
                            style="width: 80px; height: 80px; object-fit: cover; border-radius: var(--radius-md); border: 1px solid var(--border-color, #ddd);">
                    </div>
                <% } else { %>
                    <div id="imagePreview" style="margin-top: 0.75rem; display: none;">
                        <img src="" alt="" id="previewImg"
                            style="width: 80px; height: 80px; object-fit: cover; border-radius: var(--radius-md); border: 1px solid var(--border-color, #ddd);">
                    </div>
                <% } %>
            </div>

            <div class="form-group" style="display: flex; align-items: center; gap: 0.5rem; background: var(--light-gray); padding: 0.75rem 1rem; border-radius: var(--radius-md);">
                <input type="checkbox" id="is_active" name="is_active" <%= category.is_active ? 'checked' : '' %> style="width: 18px; height: 18px; accent-color: var(--primary-color);">
                <label for="is_active" style="font-weight: bold; cursor: pointer;">مفعل</label>
            </div>

            <div class="form-group">
                <div class="card-title" style="font-size: 1rem; margin-bottom: 0.25rem;">
                    <i class="fas fa-box-open"></i> منتجات التصنيف
                </div>
                <p style="font-size: 0.85rem; color: var(--medium-gray); margin-bottom: 0.75rem;">
                    اختار المنتجات اللي هتظهر في التصنيف ده (المنتجات متخانة دلوقتي: <%= linkedProductIds.length %>)
                </p>
                <input type="text" id="productSearch" class="form-control" placeholder="🔍 ابحث باسم المنتج..." autocomplete="off" style="margin-bottom: 0.75rem;">
                <div class="products-list" id="productsList">
                    <% (typeof products !== 'undefined' ? products : []).forEach(function(p) {
                        const isLinked = linkedProductIds.includes(p.id); %>
                        <label class="product-check <%= isLinked ? 'selected' : '' %>">
                            <input type="checkbox" name="product_ids" value="<%= p.id %>" <%= isLinked ? 'checked' : '' %>
                                onchange="this.closest('.product-check').classList.toggle('selected', this.checked)">
                            <img src="<%= (p.images && p.images[0]) || '/placeholder.png' %>" alt="<%= p.name %>" onerror="this.src='/placeholder.png'">
                            <span class="p-name"><%= p.name %>
                                <% if (p.is_active === false) { %><span class="p-inactive">موقوف</span><% } %>
                            </span>
                            <span class="p-price"><%= parseFloat(p.price || 0).toFixed(0) %> ج.م</span>
                        </label>
                    <% }); %>
                    <% if (!products || products.length === 0) { %>
                        <div style="padding: 1.5rem; text-align: center; color: var(--medium-gray);">
                            مفيش منتجات — ضيف منتجات الأول من صفحة المنتجات
                        </div>
                    <% } %>
                </div>
            </div>

            <div style="display: flex; gap: 0.5rem; margin-top: 1.5rem;">
                <button type="submit" class="btn btn-primary" style="flex: 1;">
                    <i class="fas fa-save"></i> حفظ التعديلات
                </button>
                <a href="/admin/categories" class="btn btn-secondary">
                    <i class="fas fa-times"></i> إلغاء
                </a>
            </div>
        </form>
    </div>

    <style>
        .products-list {
            max-height: 420px;
            overflow-y: auto;
            border: 1px solid var(--border-color, #e8e8e8);
            border-radius: var(--radius-md);
            background: var(--bg-card, #fff);
        }

        .product-check {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.5rem 0.75rem;
            border-bottom: 1px solid var(--border-color, #f4f6f7);
            cursor: pointer;
            transition: background var(--transition-fast);
        }

        .product-check:last-child { border-bottom: none; }

        .product-check:hover { background: var(--light-gray); }

        .product-check.selected { background: rgba(14, 68, 53, 0.06); }

        .product-check input {
            width: 18px;
            height: 18px;
            accent-color: var(--primary-color);
            flex-shrink: 0;
        }

        .product-check img {
            width: 42px;
            height: 42px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid var(--border-color, #eee);
            flex-shrink: 0;
            background: var(--light-gray);
        }

        .product-check .p-name {
            flex: 1;
            font-weight: bold;
            font-size: 0.9rem;
            color: var(--dark-gray);
        }

        .product-check .p-price {
            font-size: 0.85rem;
            color: var(--primary-color);
            font-weight: bold;
            white-space: nowrap;
        }

        .product-check .p-inactive {
            font-size: 0.7rem;
            background: var(--danger);
            color: #fff;
            border-radius: 4px;
            padding: 1px 6px;
            margin-inline-start: 4px;
        }

        body.dark .product-check { border-bottom-color: var(--dm-border); }
        body.dark .product-check.selected { background: rgba(255, 255, 255, 0.06); }
    </style>

    <script>
        function previewImage(input) {
            const preview = document.getElementById('imagePreview');
            const img = document.getElementById('previewImg');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = (e) => {
                    img.src = e.target.result;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        // Client-side product filter
        const productSearch = document.getElementById('productSearch');
        if (productSearch) {
            productSearch.addEventListener('input', () => {
                const q = productSearch.value.trim().toLowerCase();
                document.querySelectorAll('#productsList .product-check').forEach(item => {
                    const name = item.querySelector('.p-name').textContent.trim().toLowerCase();
                    item.style.display = (!q || name.includes(q)) ? 'flex' : 'none';
                });
            });
        }
    </script>

<%- include('partials/footer') %>
