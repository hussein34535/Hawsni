<%- include('partials/header', { title: 'إدارة البنرات' , pageTitle: 'البنرات' , page: 'banners' }) %>

    <div class="card">
        <div class="card-header">
            <h2 class="card-title">
                <i class="fas fa-images"></i> جميع البنرات
            </h2>
            <a href="/admin/banners/new" class="btn btn-primary">
                <i class="fas fa-plus"></i> إضافة بنر جديد
            </a>
        </div>

        <% if (banners && banners.length> 0) { %>
            <p class="text-muted" style="font-size: 0.85rem; margin-bottom: 1rem;"><i class="fas fa-arrows-alt"></i> اسحب البطاقات لإعادة ترتيب البنرات</p>
            <div id="bannersGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;">
                <% banners.forEach(banner=> { %>
                    <div class="card banner-sortable-card" data-id="<%= banner.id %>" style="margin: 0; cursor: grab;">
                        <div style="display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem; color: var(--text-muted); font-size: 0.8rem;">
                            <i class="fas fa-grip-vertical" style="opacity: 0.5;"></i> اسحب للترتيب
                        </div>
                        <div
                            style="position: relative; height: 180px; border-radius: 8px; overflow: hidden; margin-bottom: 1rem;">
                            <% const isVideo = banner.image_url && (banner.image_url.endsWith('.mp4') || banner.image_url.endsWith('.webm') || banner.image_url.endsWith('.mov')); %>
                            <% if (isVideo) { %>
                                <video src="<%= banner.image_url %>" style="width: 100%; height: 100%; object-fit: cover;" muted loop onmouseover="this.play()" onmouseout="this.pause()"></video>
                                <div style="position: absolute; top: 0.5rem; right: 0.5rem; background: rgba(0,0,0,0.5); color: white; padding: 2px 6px; border-radius: 4px; font-size: 0.7rem;">
                                    <i class="fas fa-video"></i> فيديو
                                </div>
                            <% } else { %>
                                <img src="<%= banner.image_url %>" alt="<%= banner.title || 'بنر' %>"
                                    style="width: 100%; height: 100%; object-fit: cover;">
                            <% } %>
                            <div style="position: absolute; top: 0.5rem; left: 0.5rem;">
                                <span class="badge <%= banner.is_active ? 'badge-success' : 'badge-danger' %>">
                                    <%= banner.is_active ? 'نشط' : 'غير نشط' %>
                                </span>
                            </div>
                        </div>

                        <div style="padding: 0 0.5rem;">
                            <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--dark-gray);">
                                <%= banner.title || 'بدون عنوان' %>
                            </h3>

                            <div
                                style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; color: var(--medium-gray); font-size: 0.85rem;">
                                <i class="fas fa-sort"></i>
                                <span>الترتيب: <%= banner.sort_order || 0 %></span>
                            </div>

                            <div style="display: flex; gap: 0.5rem;">
                                <a href="/admin/banners/<%= banner.id %>/edit" class="btn btn-secondary btn-sm"
                                    style="flex: 1;">
                                    <i class="fas fa-edit"></i> تعديل
                                </a>
                                <button onclick="handleDelete('/admin/banners/<%= banner.id %>', 'هذا البنر')"
                                    class="btn btn-danger btn-sm" style="flex: 1;">
                                    <i class="fas fa-trash"></i> حذف
                                </button>
                            </div>
                        </div>
                    </div>
                    <% }) %>
            </div>
            <% } else { %>
                <div class="text-center" style="padding: 3rem; color: var(--medium-gray);">
                    <i class="fas fa-images" style="font-size: 4rem; margin-bottom: 1rem; opacity: 0.3;"></i>
                    <p style="font-size: 1.1rem;">لا توجد بنرات حتى الآن</p>
                    <a href="/admin/banners/new" class="btn btn-primary" style="margin-top: 1rem;">
                        <i class="fas fa-plus"></i> إضافة أول بنر
                    </a>
                </div>
                <% } %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <script>
        // Drag to reorder banners
        document.addEventListener('DOMContentLoaded', () => {
            const grid = document.getElementById('bannersGrid');
            if (!grid || typeof Sortable === 'undefined') return;
            new Sortable(grid, {
                animation: 180,
                handle: '.banner-sortable-card',
                ghostClass: 'sortable-ghost',
                onEnd: async () => {
                    const cards = [...grid.querySelectorAll('.banner-sortable-card')];
                    const payload = cards.map((el, idx) => ({ id: el.dataset.id, sort_order: idx + 1 }));
                    try {
                        const res = await fetch('/admin/banners/reorder', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'CSRF-Token': '<%= csrfToken %>' },
                            body: JSON.stringify({ banners: payload })
                        });
                        const data = await res.json();
                        if (data.success) showToast('تم تحديث الترتيب', 'success');
                        else showToast(data.message || 'فشل تحديث الترتيب', 'error');
                    } catch (e) {
                        showToast('خطأ في تحديث الترتيب', 'error');
                    }
                }
            });
        });

        async function handleDelete(url, itemName) {
            showConfirm(`هل أنت متأكد من حذف ${itemName}؟`, async () => {
                try {
                    const res = await fetch(url, {
                        method: 'DELETE',
                        headers: {
                            'X-CSRF-Token': '<%= csrfToken %>'
                        }
                    });
                    const data = await res.json();
                    if (data.success) {
                        showToast('تم الحذف بنجاح', 'success');
                        setTimeout(() => window.location.reload(), 1000);
                    } else {
                        showToast(data.message || 'فشل الحذف', 'error');
                    }
                } catch (err) {
                    showToast('حدث خطأ أثناء الحذف', 'error');
                }
            });
        }
    </script>
    <%- include('partials/footer') %>