<%- include('partials/header', { title: 'إدارة التقييمات' , pageTitle: 'إدارة التقييمات' , page: 'reviews' }) %>

    <% if (locals.success) { %>
        <div
            style="background:#d1fae5; border:1px solid #6ee7b7; color:#065f46; padding:12px 20px; border-radius:12px; margin-bottom:20px; font-weight:bold;">
            ✅ تم إضافة التقييم بنجاح!
        </div>
        <% } %>
            <% if (locals.error) { %>
                <div
                    style="background:#fee2e2; border:1px solid #fca5a5; color:#991b1b; padding:12px 20px; border-radius:12px; margin-bottom:20px; font-weight:bold;">
                    ❌ خطأ: <%= error %>
                </div>
                <% } %>

                    <div class="review-layout" style="display:grid; grid-template-columns:1fr 1.5fr; gap:24px; align-items:start;">

                        <!-- ── Add Review Form ── -->
                        <div class="card">
                            <div class="card-header">
                                <h2 class="card-title"><i class="fas fa-star" style="color:#F59E0B;"></i> إضافة تقييم
                                    جديد</h2>
                            </div>
                            <div style="padding:1.5rem;">
                                <form method="POST" action="/admin/reviews">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                    <div class="form-group">
                                        <label class="form-label" for="review-product">المنتج</label>
                                        <select id="review-product" name="product_id" class="form-control" required>
                                            <option value="">— اختر منتج —</option>
                                            <% products.forEach(p=> { %>
                                                <option value="<%= p.id %>">
                                                    <%= p.name %>
                                                </option>
                                                <% }) %>
                                        </select>
                                    </div>

                                    <div class="form-group">
                                        <label class="form-label" for="review-name">اسم المراجع (مخصص)</label>
                                        <input id="review-name" type="text" name="custom_name" class="form-control" required
                                            maxlength="80" placeholder="مثال: الاسم بالكامل">
                                    </div>

                                    <div class="form-group">
                                        <label class="form-label" id="rating-label">التقييم</label>
                                        <div id="starPicker" role="radiogroup" aria-labelledby="rating-label"
                                            style="display:flex; gap:8px; font-size:2rem; cursor:pointer; margin-bottom:4px;">
                                            <% [1,2,3,4,5].forEach(s=> { %>
                                                <span class="star-btn" data-val="<%= s %>" role="radio" tabindex="<%= s === 1 ? '0' : '-1' %>"
                                                    aria-checked="false" aria-label="<%= s %> من 5"
                                                    style="color:#D1D5DB; transition:color .15s;">★</span>
                                                <% }) %>
                                        </div>
                                        <input type="hidden" name="rating" id="ratingInput" required value="0">
                                        <small style="color:#9CA3AF;">اضغط على نجمة لاختيار التقييم</small>
                                    </div>

                                    <div class="form-group">
                                        <label class="form-label" for="review-comment">التعليق (اختياري)</label>
                                        <textarea id="review-comment" name="comment" class="form-control" rows="4" maxlength="1000"
                                            placeholder="اكتب التعليق هنا (اختياري)..."></textarea>
                                    </div>

                                    <div class="form-group">
                                        <label class="form-label">
                                            <i class="fas fa-images" style="color:#6366F1;"></i>
                                            الصور (اختياري - حتى 4 صور)
                                        </label>

                                        <!-- Image preview grid -->
                                        <div id="imgPreviews"
                                            style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom:10px; min-height:0;">
                                        </div>

                                        <!-- Pick button -->
                                        <button type="button" id="pickImgBtn"
                                            style="display:flex; align-items:center; gap:8px; padding:8px 16px; border:2px dashed #C7D2FE; border-radius:12px; background:#F5F3FF; color:#6366F1; font-weight:bold; cursor:pointer; font-size:0.85rem;"
                                            onclick="document.getElementById('imgFileInput').click()">
                                            <i class="fas fa-cloud-upload-alt"></i> اختر صور
                                        </button>
                                        <input type="file" id="imgFileInput" accept="image/jpeg,image/png,image/webp,image/gif" multiple hidden>

                                        <!-- Upload progress -->
                                        <div id="uploadStatus"
                                            style="display:none; margin-top:8px; color:#6366F1; font-size:0.82rem; font-weight:bold;">
                                            <i class="fas fa-spinner fa-spin"></i> جاري رفع الصور...
                                        </div>

                                        <!-- Hidden inputs will be injected here by JS -->
                                        <div id="hiddenImgInputs"></div>
                                    </div>

                                    <button type="submit" id="submitBtn" class="btn btn-primary" style="width:100%;">
                                        <i class="fas fa-paper-plane"></i> إرسال التقييم
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- ── Reviews Table ── -->
                        <div class="card">
                            <div class="card-header">
                                <h2 class="card-title"><i class="fas fa-list"></i> آخر التقييمات (<%= reviews.length %>)
                                </h2>
                            </div>
                            <div style="overflow-x:auto; max-height:70vh; overflow-y:auto;">
                                <table class="table" style="font-size:0.9rem;">
                                    <thead>
                                        <tr>
                                            <th>المنتج</th>
                                            <th>الاسم</th>
                                            <th>التقييم</th>
                                            <th>التعليق</th>
                                            <th>التاريخ</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (reviews.length===0) { %>
                                            <tr>
                                                <td colspan="6" style="text-align:center; color:#9CA3AF; padding:2rem;">
                                                    لا توجد تقييمات بعد</td>
                                            </tr>
                                            <% } else { %>
                                                <% reviews.forEach(r=> { %>
                                                    <tr>
                                                        <td
                                                            style="font-weight:bold; max-width:130px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                                            <%= r.productName %>
                                                        </td>
                                                        <td>
                                                            <% if (r.custom_name) { %>
                                                                <span
                                                                    style="background:#EDE9FE; color:#7C3AED; padding:2px 8px; border-radius:6px; font-size:0.75rem; font-weight:bold;">
                                                                    ✍️ <%= r.custom_name %>
                                                                </span>
                                                                <% } else { %>
                                                                    <span style="color:#6B7280;">عميل</span>
                                                                    <% } %>
                                                        </td>
                                                        <td
                                                            style="color:#F59E0B; font-size:1.1rem; white-space:nowrap;">
                                                            <% for(let i=0;i<r.rating;i++){%>★<% } %>
                                                                    <% for(let i=r.rating;i<5;i++){%><span
                                                                            style="color:#D1D5DB;">★</span>
                                                                        <% } %>
                                                        </td>
                                                        <td style="max-width:180px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"
                                                            title="<%= r.comment %>">
                                                            <%= r.comment %>
                                                        </td>
                                                        <td
                                                            style="color:#9CA3AF; font-size:0.8rem; white-space:nowrap;">
                                                            <%= new Date(r.created_at).toLocaleDateString('ar-EG') %>
                                                        </td>
                                                        <td>
                                                            <button type="button" onclick="deleteReview('<%= r.id %>')"
                                                                style="background:none; border:none; color:#EF4444; cursor:pointer; padding:4px;"
                                                                title="حذف">
                                                                <i class="fas fa-trash"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                    <% }) %>
                                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </div>

                    <script>
                        const CSRF_TOKEN = '<%= csrfToken %>';
                        const MAX_IMAGES = 4;
                        const ALLOWED_IMAGE_TYPES = new Set(['image/jpeg', 'image/png', 'image/webp', 'image/gif']);
                        let selectedFiles = [];

                        const fileInput = document.getElementById('imgFileInput');
                        const previews = document.getElementById('imgPreviews');
                        const hiddenDiv = document.getElementById('hiddenImgInputs');
                        const statusDiv = document.getElementById('uploadStatus');
                        const submitBtn = document.getElementById('submitBtn');
                        const reviewForm = submitBtn.closest('form');

                        fileInput.addEventListener('change', () => {
                            const newFiles = Array.from(fileInput.files)
                                .filter(file => ALLOWED_IMAGE_TYPES.has(file.type) && file.size <= 4.5 * 1024 * 1024);
                            const remaining = MAX_IMAGES - selectedFiles.length;
                            selectedFiles = [...selectedFiles, ...newFiles.slice(0, remaining)].slice(0, MAX_IMAGES);
                            fileInput.value = '';
                            renderPreviews();
                        });

                        function renderPreviews() {
                            previews.textContent = '';
                            selectedFiles.forEach((file, index) => {
                                const reader = new FileReader();
                                reader.onload = event => {
                                    const wrap = document.createElement('div');
                                    wrap.style.cssText = 'position:relative; width:72px; height:72px;';
                                    const img = document.createElement('img');
                                    img.src = String(event.target.result || '');
                                    img.alt = file.name;
                                    img.style.cssText = 'width:72px;height:72px;object-fit:cover;border-radius:10px;border:1px solid #E5E7EB;';
                                    const remove = document.createElement('button');
                                    remove.type = 'button';
                                    remove.textContent = '✕';
                                    remove.setAttribute('aria-label', 'إزالة الصورة');
                                    remove.style.cssText = 'position:absolute;top:-6px;right:-6px;width:18px;height:18px;background:#EF4444;border:none;border-radius:50%;color:white;font-size:10px;cursor:pointer;display:flex;align-items:center;justify-content:center;';
                                    remove.addEventListener('click', () => removeFile(index));
                                    wrap.append(img, remove);
                                    previews.appendChild(wrap);
                                };
                                reader.readAsDataURL(file);
                            });
                        }

                        function removeFile(index) {
                            selectedFiles.splice(index, 1);
                            renderPreviews();
                        }

                        async function uploadSelectedImages(files) {
                            const formData = new FormData();
                            files.forEach(file => formData.append('images', file));
                            const response = await fetch('/admin/reviews/upload', {
                                method: 'POST',
                                headers: { 'X-CSRF-Token': CSRF_TOKEN },
                                body: formData
                            });
                            const data = await response.json().catch(() => ({}));
                            if (!response.ok || !data.success || !Array.isArray(data.urls)) {
                                throw new Error(data.message || 'تعذر رفع الصور');
                            }
                            return data.urls;
                        }

                        reviewForm.addEventListener('submit', async function (event) {
                            if (Number(ratingInput.value) < 1) {
                                event.preventDefault();
                                statusDiv.style.display = 'block';
                                statusDiv.textContent = 'يرجى اختيار تقييم من 1 إلى 5 قبل الإرسال.';
                                statusDiv.style.color = '#EF4444';
                                return;
                            }
                            if (selectedFiles.length === 0) return;
                            event.preventDefault();

                            submitBtn.disabled = true;
                            statusDiv.style.display = 'block';
                            statusDiv.style.color = '#6366F1';
                            statusDiv.textContent = 'جاري رفع الصور...';

                            try {
                                const urls = await uploadSelectedImages(selectedFiles);
                                hiddenDiv.textContent = '';
                                urls.forEach(url => {
                                    const input = document.createElement('input');
                                    input.type = 'hidden';
                                    input.name = 'images[]';
                                    input.value = url;
                                    hiddenDiv.appendChild(input);
                                });
                                reviewForm.submit();
                            } catch (err) {
                                statusDiv.style.color = '#EF4444';
                                statusDiv.textContent = 'فشل الرفع: ' + (err.message || 'حاول مرة أخرى');
                                submitBtn.disabled = false;
                            }
                        });

                        // ── Star Picker ───────────────────────────────────────────────────────────────
                        const stars = Array.from(document.querySelectorAll('.star-btn'));
                        const ratingInput = document.getElementById('ratingInput');

                        function highlight(value) {
                            const selected = parseInt(value, 10) || 0;
                            stars.forEach(star => {
                                const starValue = parseInt(star.dataset.val, 10);
                                star.style.color = starValue <= selected ? '#F59E0B' : '#D1D5DB';
                                star.setAttribute('aria-checked', String(starValue === selected));
                                star.tabIndex = starValue === (selected || 1) ? 0 : -1;
                            });
                        }

                        stars.forEach(star => {
                            star.addEventListener('mouseover', () => highlight(star.dataset.val));
                            star.addEventListener('mouseout', () => highlight(ratingInput.value));
                            star.addEventListener('click', () => {
                                ratingInput.value = star.dataset.val;
                                highlight(star.dataset.val);
                            });
                            star.addEventListener('keydown', event => {
                                const current = parseInt(ratingInput.value, 10) || 0;
                                if (event.key === 'Enter' || event.key === ' ') {
                                    event.preventDefault();
                                    ratingInput.value = star.dataset.val;
                                    highlight(star.dataset.val);
                                } else if (event.key === 'ArrowRight' || event.key === 'ArrowUp') {
                                    event.preventDefault();
                                    const next = Math.min(current + 1, 5);
                                    ratingInput.value = String(next);
                                    highlight(next);
                                    stars[next - 1].focus();
                                } else if (event.key === 'ArrowLeft' || event.key === 'ArrowDown') {
                                    event.preventDefault();
                                    const next = Math.max(current - 1, 1);
                                    ratingInput.value = String(next);
                                    highlight(next);
                                    stars[next - 1].focus();
                                }
                            });
                        });

                        // ── Delete Review ─────────────────────────────────────────────────────────────
                        async function deleteReview(id) {
                            if (!confirm('هل أنت متأكد من حذف هذا التقييم؟')) return;
                            try {
                                const res = await fetch(`/admin/reviews/${id}`, { 
                                    method: 'DELETE',
                                    headers: {
                                        'X-CSRF-Token': '<%= csrfToken %>'
                                    }
                                });
                                const data = await res.json();
                                if (data.success) location.reload();
                                else alert('فشل الحذف: ' + data.message);
                            } catch (err) {
                                alert('حدث خطأ أثناء الحذف');
                            }
                        }
                    </script>

    <%- include('partials/footer') %>