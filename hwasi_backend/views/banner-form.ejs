<%- include('partials/header', { title: banner ? 'تعديل بنر' : 'إضافة بنر جديد' , pageTitle: banner ? 'تعديل بنر'
    : 'إضافة بنر جديد' , page: 'banners' }) %>

    <div class="card">
        <div class="card-header">
            <h2 class="card-title">
                <i class="fas fa-<%= banner ? 'edit' : 'plus' %>"></i>
                <%= banner ? 'تعديل بنر' : 'إضافة بنر جديد' %>
            </h2>
                        <a href="/admin/banners" class="btn btn-secondary">
                <i class="fas fa-arrow-right"></i> رجوع
            </a>
        </div>

        <form action="<%= banner ? `/admin/banners/${banner.id}` : '/admin/banners' %>" method="POST" enctype="multipart/form-data"
            onsubmit="return handleBannerSubmit(event)" id="bannerForm">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <% if (banner) { %>
                <input type="hidden" name="_method" value="PUT">
                <% } %>

                    <!-- Image Section -->
                    <div class="form-group">
                        <label class="form-label">صورة البنر <span style="color: var(--danger);">*</span></label>

                        <div style="margin-bottom: 1rem;">
                            <label
                                style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; margin-bottom: 0.5rem;">
                                <input type="radio" name="image_type" value="upload" <% if (!banner) { %>checked<% } %>
                                    onchange="toggleImageInput()">
                                    <span>رفع صورة من جهازك</span>
                            </label>
                            <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                                <input type="radio" name="image_type" value="url" <% if (banner) { %>checked<% } %>
                                    onchange="toggleImageInput()">
                                    <span>استخدام رابط صورة</span>
                            </label>
                        </div>

                        <div id="uploadInput" class="<%= banner ? 'hidden' : '' %>">
                            <input type="file" id="bannerFileInput" class="form-control" accept="image/*,video/mp4,video/webm,video/quicktime"
                                onchange="previewUploadedImage(this)">
                            <input type="hidden" name="banner_image_url" id="bannerDirectUrl">
                            <small class="text-muted">اختر صورة أو فيديو بجودة عالية (المقاس المثالي: 1200x400 بكسل - نسبة
                                3:1)</small>
                        </div>

                        <div id="urlInput" class="<%= banner ? '' : 'hidden' %>">
                            <input type="url" name="image_url" class="form-control"
                                placeholder="https://example.com/image.jpg"
                                value="<%= banner ? banner.image_url : '' %>" onchange="previewUrlImage(this)">
                            <small class="text-muted">استخدم رابط صورة من Unsplash أو أي مصدر آخر</small>
                        </div>
                    </div>

                    <!-- Image Preview with Aspect Ratio Guide + Crop -->
                    <div class="form-group">
                        <label class="form-label">معاينة الصورة (نسبة 3:1)</label>
                        <div class="banner-preview-box" id="bannerPreviewBox">
                            <img id="imagePreview" src="<%= banner ? banner.image_url : '' %>"
                                class="<%= banner ? 'd-block' : 'd-none' %>" draggable="false" style="object-position: <%= banner ? (banner.focal_x ?? 50) : 50 %>% <%= banner ? (banner.focal_y ?? 50) : 50 %>%;">
                            <div class="crop-crosshair" id="cropCrosshair"></div>
                            <div class="crop-hint"><i class="fas fa-arrows-alt"></i> اسحب لتحريك الصورة</div>
                            <div id="placeholderText"
                                class="<%= banner ? 'd-none' : 'd-block' %>">
                                <i class="fas fa-image"></i>
                                <p>معاينة الصورة بنسبة 3:1</p>
                                <small>1200 × 400 بكسل</small>
                            </div>
                        </div>
                    </div>

                    <!-- Crop Position Controls -->
                    <div class="form-group" id="cropControls" style="background: var(--light); padding: 1.25rem; border-radius: var(--radius-md); border: 1px dashed var(--border-medium);">
                        <label class="form-label"><i class="fas fa-crop-alt"></i> تحكم في الجزء الظاهر من الصورة</label>
                        <p class="text-muted" style="font-size: 0.85rem; margin-bottom: 0.75rem;">اسحب الصورة داخل المعاينة أو استخدم الأشرطة لتحديد الجزء الذي يظهر للزوار (المعاينة مطابقة تماماً لما سيظهر في الموقع)</p>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                            <div>
                                <label class="form-label" style="font-size: 0.85rem;">أفقي: <span id="focalXValue"><%= banner ? (banner.focal_x ?? 50) : 50 %></span>%</label>
                                <input type="range" id="focalX" name="focal_x" min="0" max="100" value="<%= banner ? (banner.focal_x ?? 50) : 50 %>" oninput="updateCropPosition()" style="width: 100%;">
                            </div>
                            <div>
                                <label class="form-label" style="font-size: 0.85rem;">عمودي: <span id="focalYValue"><%= banner ? (banner.focal_y ?? 50) : 50 %></span>%</label>
                                <input type="range" id="focalY" name="focal_y" min="0" max="100" value="<%= banner ? (banner.focal_y ?? 50) : 50 %>" oninput="updateCropPosition()" style="width: 100%;">
                            </div>
                        </div>
                        <button type="button" class="btn btn-secondary btn-sm" onclick="resetCrop()" style="margin-top: 0.75rem;"><i class="fas fa-crosshairs"></i> إعادة للوسط</button>
                    </div>

                    <!-- Device Preview (Mobile / Tablet / Desktop) -->
                    <div class="form-group" style="background: var(--light); padding: 1.5rem; border-radius: var(--radius-md); margin: 1rem 0;">
                        <label class="form-label"><i class="fas fa-mobile-alt"></i> معاينة على الأجهزة المختلفة</label>
                        <p class="text-muted" style="font-size: 0.85rem; margin-bottom: 1rem;">هكذا سيظهر البنر للزوار — نفس الـ crop على كل مقاس شاشة</p>
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
                            <div>
                                <div style="text-align: center; font-size: 0.8rem; font-weight: 700; margin-bottom: 0.5rem;"><i class="fas fa-mobile-alt"></i> موبايل <span style="color: var(--text-muted); font-weight: 400;">375×160</span></div>
                                <div style="width: 100%; max-width: 260px; height: 120px; border: 6px solid #222; border-radius: 14px; overflow: hidden; margin: 0 auto; background: white; position: relative;">
                                    <img id="devicePreviewMobile" src="<%= banner ? banner.image_url : '' %>" style="width: 100%; height: 100%; object-fit: cover; object-position: <%= banner ? (banner.focal_x ?? 50) : 50 %>% <%= banner ? (banner.focal_y ?? 50) : 50 %>%;">
                                </div>
                            </div>
                            <div>
                                <div style="text-align: center; font-size: 0.8rem; font-weight: 700; margin-bottom: 0.5rem;"><i class="fas fa-tablet-alt"></i> تابلت <span style="color: var(--text-muted); font-weight: 400;">768×280</span></div>
                                <div style="width: 100%; height: 140px; border: 6px solid #222; border-radius: 14px; overflow: hidden; background: white; position: relative;">
                                    <img id="devicePreviewTablet" src="<%= banner ? banner.image_url : '' %>" style="width: 100%; height: 100%; object-fit: cover; object-position: <%= banner ? (banner.focal_x ?? 50) : 50 %>% <%= banner ? (banner.focal_y ?? 50) : 50 %>%;">
                                </div>
                            </div>
                            <div>
                                <div style="text-align: center; font-size: 0.8rem; font-weight: 700; margin-bottom: 0.5rem;"><i class="fas fa-desktop"></i> ديسكتوب <span style="color: var(--text-muted); font-weight: 400;">1200×400</span></div>
                                <div style="width: 100%; height: 140px; border: 6px solid #222; border-radius: 14px; overflow: hidden; background: white; position: relative;">
                                    <img id="devicePreviewDesktop" src="<%= banner ? banner.image_url : '' %>" style="width: 100%; height: 100%; object-fit: cover; object-position: <%= banner ? (banner.focal_x ?? 50) : 50 %>% <%= banner ? (banner.focal_y ?? 50) : 50 %>%;">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Responsive Images per Device (optional) -->
                    <div class="form-group" style="background: #fffbeb; padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid #fcd34d; margin: 1rem 0;">
                        <label style="display: flex; align-items: center; gap: 0.6rem; cursor: pointer; font-weight: 800; font-size: 0.95rem;">
                            <input type="checkbox" id="enableResponsiveImages" onchange="toggleResponsiveImages()" <%= (banner && (banner.mobile_image_url || banner.tablet_image_url)) ? 'checked' : '' %>>
                            <i class="fas fa-images" style="color: #d97706;"></i> تخصيص شكل مختلف لكل جهاز (اختياري)
                        </label>
                        <p class="text-muted" style="font-size: 0.82rem; margin: 0.4rem 0 0 0;">لو عايز صورة مربعة للموبايل وصورة عريضة للديسكتوب — فعّل الاختيار وحمّل صور مخصصة. لو سيبته فاضي هيستخدم الصورة الأساسية تلقائياً.</p>
                        <div id="responsiveImagesSection" style="display: <%= (banner && (banner.mobile_image_url || banner.tablet_image_url)) ? 'block' : 'none' %>; margin-top: 1rem;">
                            <!-- Mobile -->
                            <div style="background: white; padding: 1rem; border-radius: 10px; margin-bottom: 1rem; border: 1px solid #f3f4f6;">
                                <h4 style="font-size: 0.88rem; font-weight: 800; margin-bottom: 0.6rem;"><i class="fas fa-mobile-alt"></i> صورة الموبايل <small style="color: var(--text-muted); font-weight: 400;">— لو فاضية = نفس صورة الديسكتوب</small></h4>
                                <input type="url" name="mobile_image_url" id="mobileImageUrl" class="form-control" placeholder="https://.../banner-mobile.jpg" value="<%= banner ? (banner.mobile_image_url || '') : '' %>" oninput="updateResponsivePreviews()">
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 0.75rem;">
                                    <div>
                                        <label style="font-size: 0.8rem;">أفقي: <span id="mobileFocalXValue"><%= banner ? (banner.mobile_focal_x ?? 50) : 50 %></span>%</label>
                                        <input type="range" id="mobileFocalX" name="mobile_focal_x" min="0" max="100" value="<%= banner ? (banner.mobile_focal_x ?? 50) : 50 %>" oninput="updateResponsivePreviews()" style="width: 100%;">
                                    </div>
                                    <div>
                                        <label style="font-size: 0.8rem;">عمودي: <span id="mobileFocalYValue"><%= banner ? (banner.mobile_focal_y ?? 50) : 50 %></span>%</label>
                                        <input type="range" id="mobileFocalY" name="mobile_focal_y" min="0" max="100" value="<%= banner ? (banner.mobile_focal_y ?? 50) : 50 %>" oninput="updateResponsivePreviews()" style="width: 100%;">
                                    </div>
                                </div>
                            </div>
                            <!-- Tablet -->
                            <div style="background: white; padding: 1rem; border-radius: 10px; border: 1px solid #e5e7eb;">
                                <h4 style="font-size: 0.88rem; font-weight: 800; margin-bottom: 0.6rem;"><i class="fas fa-tablet-alt"></i> صورة التابلت <small style="color: var(--text-muted); font-weight: 400;">— لو فاضية = نفس صورة الديسكتوب</small></h4>
                                <input type="url" name="tablet_image_url" id="tabletImageUrl" class="form-control" placeholder="https://.../banner-tablet.jpg" value="<%= banner ? (banner.tablet_image_url || '') : '' %>" oninput="updateResponsivePreviews()">
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 0.75rem;">
                                    <div>
                                        <label style="font-size: 0.8rem;">أفقي: <span id="tabletFocalXValue"><%= banner ? (banner.tablet_focal_x ?? 50) : 50 %></span>%</label>
                                        <input type="range" id="tabletFocalX" name="tablet_focal_x" min="0" max="100" value="<%= banner ? (banner.tablet_focal_x ?? 50) : 50 %>" oninput="updateResponsivePreviews()" style="width: 100%;">
                                    </div>
                                    <div>
                                        <label style="font-size: 0.8rem;">عمودي: <span id="tabletFocalYValue"><%= banner ? (banner.tablet_focal_y ?? 50) : 50 %></span>%</label>
                                        <input type="range" id="tabletFocalY" name="tablet_focal_y" min="0" max="100" value="<%= banner ? (banner.tablet_focal_y ?? 50) : 50 %>" oninput="updateResponsivePreviews()" style="width: 100%;">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Text Content Section -->
                    <div
                        style="background: var(--light); padding: 1.5rem; border-radius: var(--radius-md); margin: 2rem 0;">
                        <h3 style="margin-bottom: 1rem; color: var(--dark-gray);">
                            <i class="fas fa-text-width"></i> محتوى البنر
                        </h3>

                        <div class="form-group">
                            <label class="form-label">العنوان الرئيسي</label>
                            <input type="text" name="heading_text" class="form-control"
                                placeholder="مثال: Summer Collection" value="<%= banner ? banner.heading_text : '' %>">
                            <small class="text-muted">النص الكبير الذي يظهر على البنر (اختياري)</small>
                        </div>

                        <div class="form-group">
                            <label class="form-label">العنوان الفرعي</label>
                            <input type="text" name="subheading_text" class="form-control"
                                placeholder="مثال: Up to 50% OFF على كل المنتجات"
                                value="<%= banner ? banner.subheading_text : '' %>">
                            <small class="text-muted">النص الصغير الذي يظهر تحت العنوان (اختياري)</small>
                        </div>
                    </div>

                    <!-- Button Customization Section -->
                    <div
                        style="background: var(--light); padding: 1.5rem; border-radius: var(--radius-md); margin: 2rem 0;">
                        <h3 style="margin-bottom: 1rem; color: var(--dark-gray);">
                            <i class="fas fa-mouse-pointer"></i> تخصيص الزر
                        </h3>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                            <div class="form-group">
                                <label class="form-label">نص الزر</label>
                                <input type="text" id="buttonText" name="button_text" class="form-control"
                                    placeholder="Shop Now" value="<%= banner ? (banner.button_text || '') : '' %>"
                                    onchange="updatePreview()">
                                <small class="text-muted">اتركه فارغاً لإخفاء الزر</small>
                            </div>

                            <div class="form-group">
                                <label class="form-label">لون الزر</label>
                                <div style="display: flex; gap: 0.5rem; align-items: center;">
                                    <input type="color" id="buttonColor" name="button_color" class="form-control"
                                        value="<%= banner ? (banner.button_color || '#D4AF37') : '#D4AF37' %>"
                                        style="height: 45px; padding: 0.25rem;" onchange="updatePreview()">
                                    <input type="text" id="buttonColorHex" class="form-control"
                                        value="<%= banner ? (banner.button_color || '#D4AF37') : '#D4AF37' %>"
                                        placeholder="#D4AF37" style="width: 100px;" onchange="syncColorFromHex()"
                                        pattern="^#[0-9A-Fa-f]{6}$">
                                </div>
                                <small class="text-muted">اختر اللون أو اكتب الكود</small>
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
                            <div class="form-group">
                                <label class="form-label">شكل الزر</label>
                                <select id="buttonStyle" name="button_style" class="form-control"
                                    onchange="updatePreview()">
                                    <option value="rounded" <%=banner && banner.button_style==='rounded' ? 'selected'
                                        : '' %>>دائري (Rounded)</option>
                                    <option value="square" <%=banner && banner.button_style==='square' ? 'selected' : ''
                                        %>>مربع (Square)</option>
                                    <option value="pill" <%=banner && banner.button_style==='pill' ? 'selected' : '' %>
                                        >كبسولة (Pill)</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label class="form-label">حجم الزر</label>
                                <select id="buttonSize" name="button_size" class="form-control"
                                    onchange="updatePreview()">
                                    <option value="small" <%=banner && banner.button_size==='small' ? 'selected' : '' %>
                                        >صغير</option>
                                    <option value="medium" <%=banner && banner.button_size==='medium' ? 'selected' : ''
                                        %>>متوسط</option>
                                    <option value="large" <%=banner && banner.button_size==='large' ? 'selected' : '' %>
                                        >كبير</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label class="form-label">موقع الزر</label>
                                <select id="buttonPosition" name="button_position" class="form-control"
                                    onchange="updatePreview()">
                                    <option value="bottom-right" <%=banner && banner.button_position==='bottom-right'
                                        ? 'selected' : '' %>>أسفل يمين</option>
                                    <option value="bottom-center" <%=banner && banner.button_position==='bottom-center'
                                        ? 'selected' : '' %>>أسفل وسط</option>
                                    <option value="bottom-left" <%=banner && banner.button_position==='bottom-left'
                                        ? 'selected' : '' %>>أسفل يسار</option>
                                    <option value="center-right" <%=banner && banner.button_position==='center-right'
                                        ? 'selected' : '' %>>وسط يمين</option>
                                    <option value="center" <%=banner && banner.button_position==='center' ? 'selected'
                                        : '' %>>وسط وسط</option>
                                    <option value="center-left" <%=banner && banner.button_position==='center-left'
                                        ? 'selected' : '' %>>وسط يسار</option>
                                    <option value="top-right" <%=banner && banner.button_position==='top-right'
                                        ? 'selected' : '' %>>أعلى يمين</option>
                                    <option value="top-center" <%=banner && banner.button_position==='top-center'
                                        ? 'selected' : '' %>>أعلى وسط</option>
                                    <option value="top-left" <%=banner && banner.button_position==='top-left'
                                        ? 'selected' : '' %>>أعلى يسار</option>
                                </select>
                            </div>
                        </div>

                        <!-- Opacity and Blur Controls -->
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1rem;">
                            <div class="form-group">
                                <label class="form-label">شفافية الزر (<span id="opacityValue">100</span>%)</label>
                                <input type="range" id="buttonOpacity" name="button_opacity" class="form-control"
                                    min="0" max="1" step="0.05"
                                    value="<%= banner ? (banner.button_opacity || 1.0) : 1.0 %>"
                                    oninput="updatePreview()" style="height: 45px;">
                                <small class="text-muted">تحكم في شفافية الزر (0% = شفاف، 100% = معتم)</small>
                            </div>

                            <div class="form-group">
                                <label class="form-label">ضبابية الصورة (<span id="blurValue">0</span>px)</label>
                                <input type="range" id="imageBlur" name="image_blur" class="form-control" min="0"
                                    max="20" step="0.5" value="<%= banner ? (banner.image_blur || 0.0) : 0.0 %>"
                                    oninput="updateBlur()" style="height: 45px;">
                                <small class="text-muted">تأثير ضبابي للصورة الخلفية (0-20)</small>
                            </div>
                        </div>

                        <!-- Button Preview -->
                        <div class="form-group" style="margin-top: 1.5rem;">
                            <label class="form-label">معاينة الزر</label>
                            <div id="previewContainer"
                                style="background: url('https://images.unsplash.com/photo-1483985988355-763728e1935b') center/cover; padding: 2rem; border-radius: var(--radius-md); min-height: 200px; position: relative; overflow: hidden;">
                                <div id="blurOverlay"
                                    style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; backdrop-filter: blur(0px);">
                                </div>
                                <button id="buttonPreview" type="button"
                                    style="position: absolute; bottom: 20px; right: 20px; font-weight: bold; border: none; cursor: pointer; box-shadow: 0 4px 6px rgba(0,0,0,0.3); color: #000; z-index: 1;">
                                    Shop Now
                                </button>
                            </div>
                            <small class="text-muted">معاينة مباشرة للزر مع الإعدادات الحالية</small>
                        </div>

                        <div class="form-group">
                            <label class="form-label">رابط الزر</label>
                            <input type="text" name="button_link" class="form-control"
                                placeholder="/products أو category/123" value="<%= banner ? banner.button_link : '' %>">
                            <small class="text-muted">الصفحة التي سيذهب إليها المستخدم عند الضغط على الزر
                                (اختياري)</small>
                        </div>
                    </div>

                    <!-- Settings Section -->
                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; margin: 2rem 0;">
                        <div class="form-group">
                            <label class="form-label">عنوان داخلي (للإدارة)</label>
                            <input type="text" name="title" class="form-control" placeholder="مثال: عروض الصيف"
                                value="<%= banner ? banner.title : '' %>">
                            <small class="text-muted">لتمييز البنر في لوحة التحكم فقط</small>
                        </div>

                        <div class="form-group">
                            <label class="form-label">ترتيب العرض</label>
                            <input type="number" name="sort_order" class="form-control"
                                value="<%= banner ? banner.sort_order : 1 %>" min="1">
                            <small class="text-muted">الترتيب من الأصغر للأكبر</small>
                        </div>

                        <div class="form-group">
                            <label class="form-label">الحالة</label>
                            <select name="is_active" class="form-control">
                                <option value="true" <%=banner && banner.is_active ? 'selected' : '' %>>نشط</option>
                                <option value="false" <%=banner && !banner.is_active ? 'selected' : '' %>>غير نشط
                                </option>
                            </select>
                        </div>
                    </div>

                    <div style="display: flex; gap: 1rem; margin-top: 2rem;">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i>
                            <%= banner ? 'حفظ التعديلات' : 'إضافة البنر' %>
                        </button>
                        <a href="/admin/banners" class="btn btn-secondary">إلغاء</a>
                    </div>
        </form>
    </div>

    <script>
        function toggleImageInput() {
            const uploadRadio = document.querySelector('input[name="image_type"][value="upload"]');
            const uploadInput = document.getElementById('uploadInput');
            const urlInput = document.getElementById('urlInput');
            const uploadFile = uploadInput.querySelector('input[type="file"]');
            const urlField = urlInput.querySelector('input[type="url"]');

            if (uploadRadio.checked) {
                uploadInput.style.display = 'block';
                urlInput.style.display = 'none';
                urlField.removeAttribute('required');
            } else {
                uploadInput.style.display = 'none';
                urlInput.style.display = 'block';
                uploadFile.removeAttribute('required');
            }
        }

        function previewUploadedImage(input) {
            const preview = document.getElementById('imagePreview');
            const placeholder = document.getElementById('placeholderText');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                    placeholder.style.display = 'none';
                    preview.classList.remove('d-none'); preview.classList.add('d-block');
                    updateCropPosition();
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function previewUrlImage(input) {
            const preview = document.getElementById('imagePreview');
            const placeholder = document.getElementById('placeholderText');
            if (input.value) {
                preview.src = input.value;
                preview.style.display = 'block';
                placeholder.style.display = 'none';
                preview.classList.remove('d-none'); preview.classList.add('d-block');
                // Wait for image load to ensure preview size is known
                preview.onload = () => updateCropPosition();
                updateCropPosition();
            }
        }

        function updatePreview() {
            const button = document.getElementById('buttonPreview');
            const text = document.getElementById('buttonText').value;
            const color = document.getElementById('buttonColor').value;
            const style = document.getElementById('buttonStyle').value;
            const size = document.getElementById('buttonSize').value;
            const position = document.getElementById('buttonPosition').value;
            const opacity = document.getElementById('buttonOpacity').value;

            // Update text and visibility
            if (!text) {
                button.style.display = 'none';
            } else {
                button.style.display = 'block';
                button.textContent = text;
            }

            // Update color and opacity
            button.style.backgroundColor = color;
            button.style.opacity = opacity;
            document.getElementById('buttonColorHex').value = color;
            document.getElementById('opacityValue').textContent = Math.round(opacity * 100);

            // Update border radius based on style
            if (style === 'square') {
                button.style.borderRadius = '4px';
            } else if (style === 'pill') {
                button.style.borderRadius = '50px';
            } else {
                button.style.borderRadius = '12px';
            }

            // Update size
            if (size === 'small') {
                button.style.padding = '8px 16px';
                button.style.fontSize = '12px';
            } else if (size === 'large') {
                button.style.padding = '16px 28px';
                button.style.fontSize = '16px';
            } else {
                button.style.padding = '12px 20px';
                button.style.fontSize = '14px';
            }

            // Update position
            button.style.position = 'absolute';
            button.style.top = 'auto';
            button.style.bottom = 'auto';
            button.style.left = 'auto';
            button.style.right = 'auto';
            button.style.transform = 'none';

            if (position === 'bottom-right') {
                button.style.bottom = '20px';
                button.style.right = '20px';
            } else if (position === 'bottom-center') {
                button.style.bottom = '20px';
                button.style.left = '50%';
                button.style.transform = 'translateX(-50%)';
            } else if (position === 'bottom-left') {
                button.style.bottom = '20px';
                button.style.left = '20px';
            } else if (position === 'center-right') {
                button.style.top = '50%';
                button.style.right = '20px';
                button.style.transform = 'translateY(-50%)';
            } else if (position === 'center') {
                button.style.top = '50%';
                button.style.left = '50%';
                button.style.transform = 'translate(-50%, -50%)';
            } else if (position === 'center-left') {
                button.style.top = '50%';
                button.style.left = '20px';
                button.style.transform = 'translateY(-50%)';
            } else if (position === 'top-right') {
                button.style.top = '20px';
                button.style.right = '20px';
            } else if (position === 'top-center') {
                button.style.top = '20px';
                button.style.left = '50%';
                button.style.transform = 'translateX(-50%)';
            } else if (position === 'top-left') {
                button.style.top = '20px';
                button.style.left = '20px';
            }
        }

        function updateBlur() {
            const blur = document.getElementById('imageBlur').value;
            const blurOverlay = document.getElementById('blurOverlay');
            blurOverlay.style.backdropFilter = `blur(${blur}px)`;
            document.getElementById('blurValue').textContent = blur;
        }

        function syncColorFromHex() {
            const hexValue = document.getElementById('buttonColorHex').value;
            if (/^#[0-9A-Fa-f]{6}$/.test(hexValue)) {
                document.getElementById('buttonColor').value = hexValue;
                updatePreview();
            }
        }

        // === Crop / Focal position ===
        function updateCropPosition() {
            const xEl = document.getElementById('focalX');
            const yEl = document.getElementById('focalY');
            if (!xEl || !yEl) return;
            const x = xEl.value, y = yEl.value;
            const xv = document.getElementById('focalXValue');
            const yv = document.getElementById('focalYValue');
            if (xv) xv.textContent = x;
            if (yv) yv.textContent = y;
            const img = document.getElementById('imagePreview');
            if (img) img.style.objectPosition = `${x}% ${y}%`;
            const cross = document.getElementById('cropCrosshair');
            if (cross) { cross.style.left = `${x}%`; cross.style.top = `${y}%`; }
            const box = document.getElementById('bannerPreviewBox');
            if (box && img && img.src && img.style.display !== 'none' && !img.classList.contains('d-none')) {
                box.classList.add('has-image');
            }
            updateResponsivePreviews();
        }
        function resetCrop() {
            const xEl = document.getElementById('focalX');
            const yEl = document.getElementById('focalY');
            if (xEl) xEl.value = 50;
            if (yEl) yEl.value = 50;
            updateCropPosition();
        }
        function toggleResponsiveImages() {
            const cb = document.getElementById('enableResponsiveImages');
            const sec = document.getElementById('responsiveImagesSection');
            if (!cb || !sec) return;
            sec.style.display = cb.checked ? 'block' : 'none';
            updateResponsivePreviews();
        }
        function updateResponsivePreviews() {
            ['mobileFocalX','mobileFocalY','tabletFocalX','tabletFocalY'].forEach(id => {
                const el = document.getElementById(id);
                const v = document.getElementById(id + 'Value');
                if (el && v) v.textContent = el.value;
            });
            const mainImg = document.getElementById('imagePreview');
            const mainSrc = mainImg ? mainImg.src : '';
            const enabled = document.getElementById('enableResponsiveImages')?.checked;
            const mobileImg = document.getElementById('devicePreviewMobile');
            const tabletImg = document.getElementById('devicePreviewTablet');
            const desktopImg = document.getElementById('devicePreviewDesktop');
            const fx = document.getElementById('focalX')?.value || 50;
            const fy = document.getElementById('focalY')?.value || 50;
            if (enabled) {
                const mUrl = document.getElementById('mobileImageUrl')?.value.trim();
                const tUrl = document.getElementById('tabletImageUrl')?.value.trim();
                if (mobileImg) {
                    if (mUrl) mobileImg.src = mUrl;
                    else if (mainSrc && mainImg && !mainImg.classList.contains('d-none')) mobileImg.src = mainSrc;
                    const mx = document.getElementById('mobileFocalX')?.value || 50;
                    const my = document.getElementById('mobileFocalY')?.value || 50;
                    mobileImg.style.objectPosition = `${mx}% ${my}%`;
                }
                if (tabletImg) {
                    if (tUrl) tabletImg.src = tUrl;
                    else if (mainSrc && mainImg && !mainImg.classList.contains('d-none')) tabletImg.src = mainSrc;
                    const tx = document.getElementById('tabletFocalX')?.value || 50;
                    const ty = document.getElementById('tabletFocalY')?.value || 50;
                    tabletImg.style.objectPosition = `${tx}% ${ty}%`;
                }
                if (desktopImg) desktopImg.style.objectPosition = `${fx}% ${fy}%`;
            } else {
                if (mobileImg) mobileImg.style.objectPosition = `${fx}% ${fy}%`;
                if (tabletImg) tabletImg.style.objectPosition = `${fx}% ${fy}%`;
                if (desktopImg) desktopImg.style.objectPosition = `${fx}% ${fy}%`;
            }
        }
        // Drag to move focal point
        (function initCropDrag() {
            const box = document.getElementById('bannerPreviewBox');
            const img = document.getElementById('imagePreview');
            if (!box || !img) return;
            let isDragging = false, startX = 0, startY = 0, startFX = 50, startFY = 50;
            const getFocal = () => ({
                x: parseInt(document.getElementById('focalX')?.value) || 50,
                y: parseInt(document.getElementById('focalY')?.value) || 50
            });
            const onMove = (e) => {
                if (!isDragging) return;
                const ce = e.touches ? e.touches[0] : e;
                const dx = ce.clientX - startX;
                const dy = ce.clientY - startY;
                const rect = box.getBoundingClientRect();
                const deltaX = -(dx / rect.width) * 100;
                const deltaY = -(dy / rect.height) * 100;
                let nx = Math.min(100, Math.max(0, startFX + deltaX));
                let ny = Math.min(100, Math.max(0, startFY + deltaY));
                const xEl = document.getElementById('focalX');
                const yEl = document.getElementById('focalY');
                if (xEl) xEl.value = Math.round(nx);
                if (yEl) yEl.value = Math.round(ny);
                updateCropPosition();
            };
            const onUp = () => { isDragging = false; if (box) box.style.cursor = ''; };
            const onDown = (e) => {
                const im = document.getElementById('imagePreview');
                if (!im || !im.src || im.style.display === 'none' || im.classList.contains('d-none')) return;
                isDragging = true;
                const ce = e.touches ? e.touches[0] : e;
                startX = ce.clientX; startY = ce.clientY;
                const f = getFocal(); startFX = f.x; startFY = f.y;
                box.style.cursor = 'grabbing';
                e.preventDefault();
            };
            box.addEventListener('mousedown', onDown);
            box.addEventListener('touchstart', onDown, { passive: false });
            window.addEventListener('mousemove', onMove);
            window.addEventListener('touchmove', onMove, { passive: false });
            window.addEventListener('mouseup', onUp);
            window.addEventListener('touchend', onUp);
        })();

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function () {
            toggleImageInput();
            updatePreview();
            updateBlur();
            updateCropPosition();
        });

        // === Compress image to max 4MB ===
        function compressImage(file, maxSizeMB = 4) {
            return new Promise((resolve) => {
                const maxSize = maxSizeMB * 1024 * 1024;
                if (file.size <= maxSize) { resolve(file); return; }

                const img = new window.Image();
                const url = URL.createObjectURL(file);
                img.onload = () => {
                    URL.revokeObjectURL(url);
                    let w = img.width, h = img.height;
                    let quality = 0.8;

                    const maxDim = 2000;
                    if (w > maxDim || h > maxDim) {
                        const ratio = Math.min(maxDim / w, maxDim / h);
                        w = Math.round(w * ratio);
                        h = Math.round(h * ratio);
                    }

                    const canvas = document.createElement('canvas');
                    canvas.width = w; canvas.height = h;
                    canvas.getContext('2d').drawImage(img, 0, 0, w, h);

                    (function tryCompress() {
                        canvas.toBlob((blob) => {
                            if (blob.size <= maxSize || quality <= 0.3) {
                                resolve(new File([blob], file.name, { type: 'image/jpeg' }));
                            } else {
                                quality -= 0.1;
                                canvas.toBlob((b2) => {
                                    resolve(new File([b2], file.name, { type: 'image/jpeg' }));
                                }, 'image/jpeg', quality);
                            }
                        }, 'image/jpeg', quality);
                    })();
                };
                img.src = url;
            });
        }

        // === Direct Cloudinary Upload for Banners ===
        async function handleBannerSubmit(e) {
            e.preventDefault();
            if (!validateForm('bannerForm')) return false;

            const form = document.getElementById('bannerForm');
            const submitBtn = form.querySelector('button[type="submit"]');
            const originalText = submitBtn.innerHTML;
            const csrfToken = form.querySelector('input[name="_csrf"]')?.value || document.querySelector('meta[name="csrf-token"]')?.content || '';

            async function doFetchSubmit() {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الحفظ...';
                try {
                    const formData = new FormData(form);
                    const res = await fetch(form.action, {
                        method: 'POST',
                        body: formData,
                        headers: { 'CSRF-Token': csrfToken },
                        credentials: 'same-origin'
                    });
                    if (res.redirected) {
                        window.location.href = res.url;
                        return;
                    }
                    if (res.ok) {
                        // Some redirects return 200 with HTML; just go to banners list
                        window.location.href = '/admin/banners';
                        return;
                    }
                    const errText = await res.text();
                    // Try to extract meaningful message
                    const msg = errText.includes('<!DOCTYPE') ? `خطأ ${res.status}: ${res.statusText}` : errText;
                    throw new Error(msg || `فشل الحفظ (${res.status})`);
                } catch (err) {
                    console.error('Banner submit error:', err);
                    alert('خطأ في حفظ البنر: ' + err.message);
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                    throw err;
                }
            }

            // Check if using file upload
            const uploadRadio = document.querySelector('input[name="image_type"][value="upload"]');
            const fileInput = document.getElementById('bannerFileInput');

            if (uploadRadio && uploadRadio.checked && fileInput && fileInput.files.length > 0) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري تجهيز الصورة...';

                try {
                    let fileToUpload = fileInput.files[0];
                    const isVideo = fileToUpload.type.startsWith('video/');
                    const videoTransform = 'w_1280,h_720,c_limit,br_500k,q_auto:eco,vc_h264,ac_aac,f_mp4';

                    // Compress images if over 4MB, skip for videos (handled by Cloudinary)
                    if (!isVideo && fileToUpload.size > 4 * 1024 * 1024) {
                        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري ضغط الصورة...';
                        fileToUpload = await compressImage(fileToUpload);
                    }

                    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري رفع الملف...';
                    
                    // Get signature - if video, include eager params
                    const signUrl = `/api/cloudinary/sign?folder=banners${isVideo ? `&eager=${videoTransform}&resource_type=video` : ''}`;
                    const signRes = await fetch(signUrl);
                    const signData = await signRes.json();

                    const formData = new FormData();
                    formData.append('file', fileToUpload);
                    formData.append('api_key', signData.api_key);
                    formData.append('timestamp', signData.timestamp);
                    formData.append('signature', signData.signature);
                    formData.append('folder', signData.folder);

                    if (isVideo) {
                        formData.append('eager', videoTransform);
                    }

                    const uploadEndpoint = `https://api.cloudinary.com/v1_1/${signData.cloud_name}/${isVideo ? 'video' : 'image'}/upload`;

                    const cloudRes = await fetch(uploadEndpoint, {
                        method: 'POST',
                        body: formData
                    });
                    const cloudData = await cloudRes.json();

                    let finalUrl = cloudData.secure_url;
                    // Use the compressed (eager) version for videos
                    if (isVideo && cloudData.eager && cloudData.eager.length > 0) {
                        finalUrl = cloudData.eager[0].secure_url;
                        console.log('✅ Using compressed video URL for banner:', finalUrl);
                    }

                    if (finalUrl) {
                        document.getElementById('bannerDirectUrl').value = finalUrl;
                        // Also set the image_url field
                        const urlField = document.querySelector('input[name="image_url"]');
                        if (urlField) urlField.value = finalUrl;
                        // Clear file input to prevent sending in form
                        fileInput.value = '';
                        await doFetchSubmit();
                    } else {
                        throw new Error(cloudData.error?.message || 'فشل رفع الملف');
                    }
                } catch (err) {
                    console.error('Banner upload error:', err);
                    // doFetchSubmit already handled its own errors; only show if not from there
                    if (!err.message.includes('فشل الحفظ')) {
                        alert('خطأ في رفع الصورة: ' + err.message);
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalText;
                    }
                }
                return false;
            }

            // URL mode - submit via fetch with CSRF header (avoids multipart CSRF issue)
            try {
                await doFetchSubmit();
            } catch (err) { /* already handled */ }
            return false;
        }
    </script>

