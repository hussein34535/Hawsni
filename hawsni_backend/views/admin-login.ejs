<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تسجيل دخول الأدمن | Hawsni</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            font-family: 'Cairo', sans-serif;
        }
    </style>
</head>

<body class="bg-gray-50 flex items-center justify-center min-h-screen p-4">
    <div class="max-w-md w-full bg-white rounded-[32px] shadow-2xl overflow-hidden">
        <div class="p-8">
            <div class="text-center mb-10">
                <h1 class="text-3xl font-black text-gray-900 mb-2">Hawsni Admin</h1>
                <p class="text-gray-500">سجل الدخول للوصول إلى لوحة التحكم</p>
            </div>

            <% if (typeof error !=='undefined' ) { %>
                <div class="bg-red-50 text-red-600 p-4 rounded-2xl mb-6 text-sm font-bold border border-red-100 italic">
                    <%= error %>
                </div>
                <% } %>

                    <form action="/admin/login" method="POST" class="space-y-6">
                        <div>
                            <label class="block text-sm font-bold text-gray-700 mb-2 mr-1">البريد الإلكتروني</label>
                            <input type="email" name="email" required
                                class="w-full h-14 px-6 bg-gray-50 border border-gray-100 rounded-2xl focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all"
                                placeholder="admin@example.com">
                        </div>

                        <div>
                            <label class="block text-sm font-bold text-gray-700 mb-2 mr-1">كلمة المرور</label>
                            <input type="password" name="password" required
                                class="w-full h-14 px-6 bg-gray-50 border border-gray-100 rounded-2xl focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all"
                                placeholder="••••••••">
                        </div>

                        <button type="submit"
                            class="w-full h-14 bg-gray-900 text-white font-black rounded-2xl shadow-xl hover:bg-gray-800 transition-all flex items-center justify-center text-lg">
                            دخول
                        </button>
                    </form>
        </div>
        <div class="bg-gray-100 p-6 text-center text-xs text-gray-400 font-bold border-t border-gray-200">
            &copy; 2026 Hawsni Store. All rights reserved.
        </div>
    </div>
</body>

</html>