<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تتبع طلبك | Hawsni</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Cairo', sans-serif;
            background: linear-gradient(135deg, #0a1628 0%, #0E4435 50%, #1a2a1a 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .container {
            width: 100%;
            max-width: 600px;
        }

        /* Logo */
        .logo-bar {
            text-align: center;
            margin-bottom: 32px;
        }

        .logo-text {
            font-size: 2rem;
            font-weight: 900;
            color: #ffffff;
            letter-spacing: -0.5px;
        }

        .logo-sub {
            color: rgba(255,255,255,0.4);
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
            margin-top: 2px;
        }

        /* Card */
        .card {
            background: rgba(255,255,255,0.97);
            border-radius: 32px;
            overflow: hidden;
            box-shadow: 0 40px 100px rgba(0,0,0,0.4);
        }

        /* Order Header */
        .order-header {
            background: linear-gradient(135deg, #0E4435, #1a6b54);
            padding: 32px;
            color: white;
            text-align: center;
        }

        .order-id-badge {
            display: inline-block;
            background: rgba(255,255,255,0.15);
            padding: 6px 20px;
            border-radius: 30px;
            font-size: 0.8rem;
            font-weight: 800;
            letter-spacing: 1px;
            margin-bottom: 12px;
        }

        .order-title {
            font-size: 1.5rem;
            font-weight: 900;
            margin-bottom: 4px;
        }

        .order-date {
            color: rgba(255,255,255,0.6);
            font-size: 0.85rem;
            font-weight: 600;
        }

        /* Status Timeline */
        .timeline-section {
            padding: 40px 32px 32px;
        }

        .timeline {
            position: relative;
            padding-right: 0;
        }

        .timeline-step {
            display: flex;
            align-items: flex-start;
            gap: 20px;
            margin-bottom: 32px;
            position: relative;
        }

        .timeline-step:last-child {
            margin-bottom: 0;
        }

        .timeline-step:not(:last-child)::after {
            content: '';
            position: absolute;
            right: 19px;
            top: 44px;
            width: 2px;
            height: calc(100% + 8px);
            background: #e2e8f0;
        }

        .timeline-step.active::after {
            background: linear-gradient(to bottom, #0E4435, #e2e8f0);
        }

        .timeline-step.done::after {
            background: #0E4435;
        }

        .step-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            flex-shrink: 0;
            position: relative;
            z-index: 1;
        }

        .step-icon.done {
            background: #0E4435;
            color: white;
            box-shadow: 0 4px 12px rgba(14,68,53,0.3);
        }

        .step-icon.active {
            background: white;
            border: 3px solid #0E4435;
            color: #0E4435;
            box-shadow: 0 4px 20px rgba(14,68,53,0.2);
            animation: pulse 2s infinite;
        }

        .step-icon.pending {
            background: #f1f5f9;
            color: #cbd5e1;
            border: 2px solid #e2e8f0;
        }

        @keyframes pulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(14,68,53,0.3); }
            50% { box-shadow: 0 0 0 8px rgba(14,68,53,0); }
        }

        .step-content {
            flex: 1;
            padding-top: 4px;
        }

        .step-label {
            font-size: 1rem;
            font-weight: 800;
            color: #1e293b;
            margin-bottom: 4px;
        }

        .step-label.pending {
            color: #94a3b8;
            font-weight: 600;
        }

        .step-desc {
            font-size: 0.8rem;
            color: #64748b;
            line-height: 1.6;
        }

        /* Status Badge */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 18px;
            border-radius: 30px;
            font-size: 0.8rem;
            font-weight: 800;
            margin-bottom: 28px;
        }

        .status-badge.processing { background: #fef3c7; color: #92400e; }
        .status-badge.transit { background: #dbeafe; color: #1e40af; }
        .status-badge.delivered { background: #dcfce7; color: #15803d; }
        .status-badge.cancelled { background: #fee2e2; color: #991b1b; }

        /* Bosta Tracking */
        .bosta-box {
            margin: 0 32px 32px;
            background: #eff6ff;
            border: 1.5px dashed #bfdbfe;
            border-radius: 20px;
            padding: 24px;
            text-align: center;
        }

        .bosta-label {
            font-size: 0.8rem;
            color: #64748b;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .bosta-number {
            font-size: 1.4rem;
            font-weight: 900;
            color: #1e40af;
            letter-spacing: 2px;
            margin-bottom: 16px;
        }

        .btn-track {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #2563eb;
            color: white;
            padding: 12px 28px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 800;
            font-size: 0.9rem;
            transition: all 0.2s;
        }

        .btn-track:hover {
            background: #1d4ed8;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(37,99,235,0.3);
        }

        /* Footer */
        .card-footer {
            background: #f8fafc;
            padding: 24px 32px;
            border-top: 1px solid #f1f5f9;
            text-align: center;
        }

        .footer-brand {
            font-size: 0.85rem;
            font-weight: 800;
            color: #0E4435;
            margin-bottom: 4px;
        }

        .footer-note {
            font-size: 0.75rem;
            color: #94a3b8;
        }

        /* Not found state */
        .not-found {
            text-align: center;
            padding: 60px 32px;
        }

        .not-found-emoji {
            font-size: 4rem;
            margin-bottom: 16px;
        }

        .not-found-title {
            font-size: 1.5rem;
            font-weight: 900;
            color: #1e293b;
            margin-bottom: 8px;
        }

        .not-found-desc {
            color: #64748b;
            font-size: 0.9rem;
            line-height: 1.7;
        }

        .btn-home {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #0E4435;
            color: white;
            padding: 12px 28px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 800;
            font-size: 0.9rem;
            margin-top: 24px;
            transition: all 0.2s;
        }

        /* Items */
        .items-section {
            padding: 0 32px 32px;
        }

        .section-label {
            font-size: 0.75rem;
            font-weight: 800;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 16px;
        }

        .item-row {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 14px 0;
            border-bottom: 1px solid #f1f5f9;
        }

        .item-row:last-child { border-bottom: none; }

        .item-img {
            width: 56px;
            height: 56px;
            border-radius: 14px;
            object-fit: cover;
            border: 1px solid #f1f5f9;
            flex-shrink: 0;
        }

        .item-name {
            font-weight: 800;
            font-size: 0.9rem;
            color: #1e293b;
            margin-bottom: 3px;
        }

        .item-meta {
            font-size: 0.75rem;
            color: #94a3b8;
            font-weight: 600;
        }

        .item-price {
            margin-right: auto;
            font-weight: 900;
            font-size: 0.9rem;
            color: #0E4435;
            white-space: nowrap;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="logo-bar">
            <div class="logo-text">Hawsni</div>
            <div class="logo-sub">Premium Fashion</div>
        </div>

        <div class="card">
            <% if (!order) { %>
                <!-- Not Found -->
                <div class="not-found">
                    <div class="not-found-emoji">🔍</div>
                    <div class="not-found-title">الطلب غير موجود</div>
                    <div class="not-found-desc">
                        لم نتمكن من العثور على هذا الطلب.<br>
                        تأكد من رقم الطلب أو تواصل معنا على إنستغرام.
                    </div>
                    <a href="https://hwasi.com" class="btn-home">🏠 العودة للمتجر</a>
                </div>
            <% } else { %>
                <%
                    const statusSteps = {
                        'Processing': 1,
                        'Confirmed': 1,
                        'Shipped': 2,
                        'In Transit': 2,
                        'Delivered': 3,
                        'Cancelled': -1
                    };
                    const currentStep = statusSteps[order.status] || 1;
                    const orderId = order.id.substring(0, 8).toUpperCase();
                    const orderDate = new Date(order.created_at).toLocaleDateString('ar-EG', {
                        year: 'numeric', month: 'long', day: 'numeric'
                    });
                    const steps = [
                        { icon: '✅', label: 'تم استقبال الطلب', desc: 'حصلنا على طلبك وبنجهزه بكل حب' },
                        { icon: '🚚', label: 'في الطريق إليك', desc: 'طلبك مع مندوب الشحن الآن' },
                        { icon: '🎉', label: 'تم التسليم', desc: 'تم تسليم الشحنة بنجاح' },
                    ];
                    const statusBadgeClass = {
                        'Processing': 'processing',
                        'Confirmed': 'processing',
                        'Shipped': 'transit',
                        'In Transit': 'transit',
                        'Delivered': 'delivered',
                        'Cancelled': 'cancelled'
                    }[order.status] || 'processing';
                    const statusText = {
                        'Processing': '⏳ جاري التجهيز',
                        'Confirmed': '✅ تم التأكيد',
                        'Shipped': '🚚 تم الشحن',
                        'In Transit': '🚚 في الطريق',
                        'Delivered': '✅ تم التسليم',
                        'Cancelled': '❌ ملغي'
                    }[order.status] || 'قيد المعالجة';
                %>

                <!-- Order Header -->
                <div class="order-header">
                    <div class="order-id-badge">#<%= orderId %></div>
                    <div class="order-title">تتبع طلبك</div>
                    <div class="order-date">تم الطلب في: <%= orderDate %></div>
                </div>

                <!-- Status Timeline -->
                <div class="timeline-section">
                    <div class="status-badge <%= statusBadgeClass %>">
                        <%= statusText %>
                    </div>

                    <% if (order.status !== 'Cancelled') { %>
                        <div class="timeline">
                            <% steps.forEach((step, i) => { %>
                                <%
                                    const stepNum = i + 1;
                                    const isDone = stepNum < currentStep;
                                    const isActive = stepNum === currentStep;
                                    const isPending = stepNum > currentStep;
                                %>
                                <div class="timeline-step <%= isDone ? 'done' : isActive ? 'active' : 'pending' %>">
                                    <div class="step-icon <%= isDone ? 'done' : isActive ? 'active' : 'pending' %>">
                                        <% if (isDone) { %>✓<% } else { %><%= step.icon %><% } %>
                                    </div>
                                    <div class="step-content">
                                        <div class="step-label <%= isPending ? 'pending' : '' %>"><%= step.label %></div>
                                        <% if (!isPending) { %>
                                            <div class="step-desc"><%= step.desc %></div>
                                        <% } %>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div style="background:#fee2e2;border-radius:16px;padding:24px;text-align:center;">
                            <div style="font-size:2rem;margin-bottom:8px;">❌</div>
                            <div style="font-weight:800;color:#991b1b;font-size:1rem;">تم إلغاء هذا الطلب</div>
                            <div style="color:#ef4444;font-size:0.85rem;margin-top:4px;">للتواصل معنا: Instagram @hwasi_eg</div>
                        </div>
                    <% } %>
                </div>

                <!-- Items -->
                <% const items = order.order_items || []; %>
                <% if (items.length > 0) { %>
                    <div class="items-section">
                        <div class="section-label">محتويات الطلب</div>
                        <% items.forEach(item => { %>
                            <%
                                const p = item.products || {};
                                const img = item.image_url || (p.images && p.images[0]) || '/placeholder.png';
                                const name = p.name || item.name || 'منتج';
                            %>
                            <div class="item-row">
                                <img src="<%= img %>" class="item-img" onerror="this.src='/placeholder.png'" alt="<%= name %>">
                                <div style="flex:1">
                                    <div class="item-name"><%= name %></div>
                                    <div class="item-meta">
                                        <% if (item.size) { %>المقاس: <%= item.size %><% } %>
                                        <% if (item.color) { %> | اللون: <%= item.color %><% } %>
                                        × <%= item.quantity %>
                                    </div>
                                </div>
                                <div class="item-price"><%= (item.price * item.quantity).toFixed(0) %> ج.م</div>
                            </div>
                        <% }); %>
                        <div style="text-align:left;padding-top:16px;font-size:1.1rem;font-weight:900;color:#0E4435;">
                            الإجمالي: <%= parseFloat(order.total || 0).toFixed(0) %> ج.م
                        </div>
                    </div>
                <% } %>

                <!-- Bosta Live Tracking -->
                <% if (order.tracking_number) { %>
                    <div style="margin: 0 32px 32px; border-radius: 20px; overflow: hidden; border: 1.5px solid #e0f0ea;">
                        <!-- Tracking Header -->
                        <div style="background: linear-gradient(135deg, #0E4435, #1a6b54); padding: 20px 24px; display: flex; align-items: center; justify-content: space-between;">
                            <div>
                                <div style="color: rgba(255,255,255,0.7); font-size: 0.75rem; font-weight: 700; margin-bottom: 4px;">📦 تتبع شحنتك</div>
                                <div style="color: white; font-size: 1.1rem; font-weight: 900; letter-spacing: 2px;"><%= order.tracking_number %></div>
                            </div>
                            <div style="background: rgba(255,255,255,0.15); padding: 6px 14px; border-radius: 30px; font-size: 0.75rem; color: white; font-weight: 700;">بوسطة 🚚</div>
                        </div>

                        <% if (tracking) { %>
                            <!-- Live Status -->
                            <div style="padding: 20px 24px; background: #f8fffe; border-bottom: 1px solid #e0f0ea;">
                                <div style="font-size: 1rem; font-weight: 900; color: #0E4435; margin-bottom: 4px;">
                                    <%= tracking.status %>
                                </div>
                                <% if (tracking.city) { %>
                                    <div style="font-size: 0.8rem; color: #64748b;">📍 <%= tracking.city %></div>
                                <% } %>
                            </div>

                            <!-- Timeline -->
                            <% if (tracking.timeline && tracking.timeline.length > 0) { %>
                                <div style="padding: 20px 24px; background: white;">
                                    <div style="font-size: 0.7rem; font-weight: 800; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 16px;">سجل التتبع</div>
                                    <% tracking.timeline.slice(0, 5).forEach((event, idx) => { %>
                                        <div style="display: flex; gap: 14px; margin-bottom: 14px; align-items: flex-start;">
                                            <div style="width: 10px; height: 10px; border-radius: 50%; background: <%= idx === 0 ? '#0E4435' : '#e2e8f0' %>; flex-shrink: 0; margin-top: 5px;"></div>
                                            <div style="flex: 1;">
                                                <div style="font-size: 0.85rem; font-weight: 800; color: <%= idx === 0 ? '#0E4435' : '#475569' %>;"><%= event.status %></div>
                                                <% if (event.timestamp) { %>
                                                    <div style="font-size: 0.75rem; color: #94a3b8; margin-top: 2px;">
                                                        <%= new Date(event.timestamp).toLocaleString('ar-EG', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                                    </div>
                                                <% } %>
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>
                            <% } else { %>
                                <div style="padding: 20px 24px; text-align: center; color: #94a3b8; font-size: 0.85rem; background: white;">
                                    الشحنة في مرحلة الجمع، تفاصيل أكثر قريباً...
                                </div>
                            <% } %>
                        <% } else { %>
                            <!-- Tracking not available yet -->
                            <div style="padding: 24px; text-align: center; background: white;">
                                <div style="font-size: 2rem; margin-bottom: 8px;">⏳</div>
                                <div style="font-weight: 800; color: #475569;">بانتظار استلام الشحنة</div>
                                <div style="font-size: 0.8rem; color: #94a3b8; margin-top: 4px;">سيتم تحديث حالة التتبع تلقائياً عند استلام المندوب للطلب</div>
                            </div>
                        <% } %>
                    </div>
                <% } %>

                <!-- Footer -->
                <div class="card-footer">
                    <div class="footer-brand">Hawsni — Premium Fashion ✨</div>
                    <div class="footer-note">لأي استفسار تواصل معنا على إنستغرام @hwasi_eg</div>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>
