                                                                    onchange="previewImages(this)" id="imageInput">

                                                                <% if (product && product.images &&
                                                                    product.images.length> 0) { %>
                                                                    <div id="existingImages"
                                                                        style="display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1rem;">
                                                                        <% product.images.forEach((image, index)=> { %>
                                                                            <img src="<%= image %>"
                                                                                data-index="<%= index %>"
                                                                                style="width: 100px; height: 100px; object-fit: cover; border-radius: var(--radius-md); border: 2px solid var(--light-gray);">
                                                                            <% }) %>
                                                                    </div>
                                                                    <% } %>

                                                                        <div id="imagePreview"
                                                                            style="display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1rem;">
                                                                        </div>

                                                                        <% if (product) { %>
                                                                            <div style="margin-top: 1rem;">
                                                                                <a href="/products/<%= product.id %>/images"
                                                                                    class="btn btn-info"
                                                                                    style="width: 100%; text-align: center;">
                                                                                    <i class="fas fa-images"></i> إدارة
                                                                                    الصور (ترتيب / حذف)
                                                                                </a>
                                                                            </div>
                                                                            <% } %>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div
                                                        style="display: flex; gap: 1rem; margin-top: 2rem; padding-top: 2rem; border-top: 2px solid var(--light-gray);">
                                                        <button type="submit" class="btn btn-primary">
                                                            <i class="fas fa-save"></i>
                                                            <%= product ? 'حفظ التعديلات' : 'إضافة المنتج' %>
                                                        </button>
                                                        <a href="/products" class="btn btn-secondary">إلغاء</a>
                                                    </div>
                                        </form>
                                    </div>

                                    <script>
                                        let productImages = [];
                                        let selectedImageIndex = null;

                                        function previewImages(input) {
                                            const preview = document.getElementById('imagePreview');
                                            preview.innerHTML = '';

                                            if (input.files) {
                                                Array.from(input.files).forEach((file, index) => {
                                                    const reader = new FileReader();
                                                    reader.onload = function (e) {
                                                        const img = document.createElement('img');
                                                        img.src = e.target.result;
                                                        img.dataset.index = productImages.length + index;
                                                        img.style.cssText = 'width: 100px; height: 100px; object-fit: cover; border-radius: var(--radius-md); border: 2px solid var(--primary-color);';
                                                        preview.appendChild(img);
                                                    };
                                                    reader.readAsDataURL(file);
                                                });
                                            }
                                            updateImageDropdown();
                                        }

                                        function toggleImageDropdown() {
                                            const dropdown = document.getElementById('imageDropdown');
                                            dropdown.style.display = dropdown.style.display === 'none' ? 'block' : 'none';
                                        }

                                        function selectImage(index, imageSrc) {
                                            selectedImageIndex = index;
                                            const preview = document.getElementById('selectedImagePreview');
                                            const thumb = document.getElementById('selectedImageThumb');
                                            const noImageBtn = document.getElementById('noImageButton');

                                            if (index === null) {
                                                preview.style.display = 'none';
                                                noImageBtn.style.display = 'block';
                                            } else {
                                                thumb.src = imageSrc;
                                                preview.style.display = 'block';
                                                noImageBtn.style.display = 'none';
                                            }
                                            toggleImageDropdown();
                                        }

                                        function updateImageDropdown() {
                                            const dropdown = document.getElementById('imageDropdown');
                                            const existingImages = document.querySelectorAll('#existingImages img');
                                            const newImages = document.querySelectorAll('#imagePreview img');

                                            dropdown.innerHTML = '<div style="padding: 8px; border-bottom: 1px solid #dee2e6; cursor: pointer; hover:background: #f8f9fa;" onclick="selectImage(null, null)"><i class="fas fa-times-circle"></i> بدون صورة</div>';

                                            existingImages.forEach((img, index) => {
                                                const item = document.createElement('div');
                                                item.style.cssText = 'padding: 8px; display: flex; align-items: center; gap: 8px; cursor: pointer; border-bottom: 1px solid #eee;';
                                                item.onmouseover = () => item.style.background = '#f8f9fa';
                                                item.onmouseout = () => item.style.background = 'white';
                                                item.onclick = () => selectImage(index, img.src);

                                                const thumb = document.createElement('img');
                                                thumb.src = img.src;
                                                thumb.style.cssText = 'width: 50px; height: 50px; object-fit: cover; border-radius: 4px;';

                                                const label = document.createElement('span');
                                                label.textContent = `صورة ${index + 1} (موجودة)`;

                                                item.appendChild(thumb);
                                                item.appendChild(label);
                                                dropdown.appendChild(item);
                                            });

                                            newImages.forEach((img, index) => {
                                                const item = document.createElement('div');
                                                item.style.cssText = 'padding: 8px; display: flex; align-items: center; gap: 8px; cursor: pointer; border-bottom: 1px solid #eee;';
                                                item.onmouseover = () => item.style.background = '#f8f9fa';
                                                item.onmouseout = () => item.style.background = 'white';
                                                item.onclick = () => selectImage(existingImages.length + index, img.src);

                                                const thumb = document.createElement('img');
                                                thumb.src = img.src;
                                                thumb.style.cssText = 'width: 50px; height: 50px; object-fit: cover; border-radius: 4px;';

                                                const label = document.createElement('span');
                                                label.textContent = `صورة ${existingImages.length + index + 1} (جديدة)`;

                                                item.appendChild(thumb);
                                                item.appendChild(label);
                                                dropdown.appendChild(item);
                                            });
                                        }

                                        // Color Management with Image Mapping
                                        let colors = [];
                                        const colorsInput = document.getElementById('colorsInput');
                                        const colorsContainer = document.getElementById('colorsContainer');

                                        // Initialize colors from hidden input on page load
                                        document.addEventListener('DOMContentLoaded', function () {
                                            updateImageDropdown();

                                            if (colorsInput && colorsInput.value) {
                                                try {
                                                    const parsedColors = JSON.parse(colorsInput.value);
                                                    // Handle both old format (array of strings) and new format (array of objects)
                                                    if (Array.isArray(parsedColors)) {
                                                        colors = parsedColors.map(c => {
                                                            if (typeof c === 'string') {
                                                                // Try to parse if it's a stringified object (Fix for gray colors issue)
                                                                try {
                                                                    if (c.trim().startsWith('{')) {
                                                                        const parsed = JSON.parse(c);
                                                                        if (parsed && parsed.color) {
                                                                            return {
                                                                                color: parsed.color,
                                                                                imageIndex: parsed.imageIndex !== undefined ? parsed.imageIndex : null
                                                                            };
                                                                        }
                                                                    }
                                                                } catch (e) {
                                                                    // Not a JSON string, continue as normal string
                                                                }
                                                                return { color: c, imageIndex: null };
                                                            } else if (c && typeof c === 'object' && c.color) {
                                                                return { color: c.color, imageIndex: c.imageIndex !== undefined ? c.imageIndex : null };
                                                            }
                                                            return { color: '#000000', imageIndex: null };
                                                        });
                                                    }
                                                } catch (e) {
                                                    // Fallback for old comma-separated format
                                                    colors = colorsInput.value.split(',').filter(c => c.trim() !== '').map(c => ({
                                                        color: c.trim(),
                                                        imageIndex: null
                                                    }));
                                                }
                                                renderColors();
                                            }
                                        });

                                        function addColor() {
                                            const colorPicker = document.getElementById('colorPicker');
                                            const color = colorPicker.value;
                                            const imageIndex = selectedImageIndex;

                                            // Check if color already exists
                                            const existingIndex = colors.findIndex(c => c.color === color);
                                            if (existingIndex >= 0) {
                                                // Update existing color's image
                                                colors[existingIndex].imageIndex = imageIndex;
                                            } else {
                                                // Add new color
                                                colors.push({ color, imageIndex });
                                            }

                                            // Reset selection
                                            selectedImageIndex = null;
                                            document.getElementById('selectedImagePreview').style.display = 'none';
                                            document.getElementById('noImageButton').style.display = 'block';

                                            updateColorsInput();
                                            renderColors();
                                        }

                                        function removeColor(index) {
                                            colors.splice(index, 1);
                                            updateColorsInput();
                                            renderColors();
                                        }

                                        function updateColorsInput() {
                                            colorsInput.value = JSON.stringify(colors);
                                        }

                                        function renderColors() {
                                            colorsContainer.innerHTML = '';
                                            colors.forEach((colorObj, index) => {
                                                const swatch = document.createElement('div');
                                                swatch.style.cssText = `
                    display: flex; 
                    align-items: center; 
                    gap: 0.5rem; 
                    background: #f8f9fa; 
                    padding: 0.25rem 0.5rem; 
                    border-radius: 20px; 
                    border: 1px solid #dee2e6;
                `;

                                                const circle = document.createElement('div');
                                                circle.style.cssText = `
                    width: 20px; 
                    height: 20px; 
                    border-radius: 50%; 
                    background-color: ${colorObj.color};
                    border: 1px solid #dee2e6;
                `;

                                                const text = document.createElement('span');
                                                text.innerText = colorObj.color;
                                                text.style.fontSize = '0.875rem';

                                                swatch.appendChild(circle);
                                                swatch.appendChild(text);

                                                // Show linked image if exists
                                                if (colorObj.imageIndex !== null && colorObj.imageIndex !== undefined) {
                                                    const imageIcon = document.createElement('i');
                                                    imageIcon.className = 'fas fa-image';
                                                    imageIcon.style.cssText = 'color: #28a745; font-size: 0.75rem;';
                                                    imageIcon.title = `مرتبط بصورة ${colorObj.imageIndex + 1}`;
                                                    swatch.appendChild(imageIcon);
                                                }

                                                const removeBtn = document.createElement('button');
                                                removeBtn.innerHTML = '&times;';
                                                removeBtn.style.cssText = `
                    background: none; 
                    border: none; 
                    color: #dc3545; 
                    font-size: 1.25rem; 
                    cursor: pointer; 
                    line-height: 1;
                    padding: 0 0.25rem;
                `;
                                                removeBtn.onclick = () => removeColor(index);

                                                swatch.appendChild(removeBtn);
                                                colorsContainer.appendChild(swatch);
                                            });
                                        }

                                        // Close dropdown when clicking outside
                                        document.addEventListener('click', function (event) {
                                            const dropdown = document.getElementById('imageDropdown');
