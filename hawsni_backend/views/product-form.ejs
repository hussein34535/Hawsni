        function activateEyeDropperCanvas(index, src) {
            eyeDropperActiveImageIndex = index;
            document.getElementById('eyeDropperStep1').style.display = 'none';
            document.getElementById('eyeDropperStep2').style.display = 'flex';

            const canvas = document.getElementById('eyeDropperCanvas');
            const ctx = canvas.getContext('2d', { willReadFrequently: true });

            const img = new Image();
            img.crossOrigin = "Anonymous"; // Crucial for CORS and canvas reading
            img.onload = () => {
                // Ensure canvas matches image dimensions
                canvas.width = img.width;
                canvas.height = img.height;
                ctx.drawImage(img, 0, 0, img.width, img.height);

                // Add click event for pixel extraction
                canvas.onclick = function (event) {
                    const rect = canvas.getBoundingClientRect();
                    // Calculate scale to map screen pixels to canvas pixels
                    const scaleX = canvas.width / rect.width;
                    const scaleY = canvas.height / rect.height;

                    const x = (event.clientX - rect.left) * scaleX;
                    const y = (event.clientY - rect.top) * scaleY;

                    try {
                        const pixel = ctx.getImageData(x, y, 1, 1).data;
                        const hex = rgbToHex(pixel[0], pixel[1], pixel[2]);

                        // Set the selected color and close modal
                        document.getElementById('colorPicker').value = hex;

                        // Temporarily set the selectedImageIndex without closing dropdown directly 
                        // (we just simulate the user picking it)
                        selectedImageIndex = eyeDropperActiveImageIndex;
                        const preview = document.getElementById('selectedImagePreview');
                        const thumb = document.getElementById('selectedImageThumb');
                        const noImageBtn = document.getElementById('noImageButton');

                        thumb.src = src;
                        preview.style.display = 'block';
                        noImageBtn.style.display = 'none';

                        closeEyeDropper();
                    } catch (e) {
                        alert("لا يمكن سحب اللون من هذه الصورة بأمان بسبب قيود المتصفح (CORS).");
                        console.error(e);
                    }
                };
            };
            img.src = src;
        }

        function rgbToHex(r, g, b) {
            return "#" + (1 << 24 | r << 16 | g << 8 | b).toString(16).slice(1).toLowerCase();
        }

