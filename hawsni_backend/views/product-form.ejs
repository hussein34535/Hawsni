        // === Variants Logic ===
        let activeVariants = [];
        
        function parseSizes() {
            const input = document.getElementById('sizesInput').value || '';
            return input.split(/[,،]/).map(s => s.trim()).filter(s => s);
        }

        function buildCombinations() {
            const currSizes = parseSizes();
            const currColors = colors.map(c => c.color);
            
            const combinations = [];
            
            if (currSizes.length === 0 && currColors.length === 0) {
            	// No variants selected
                return [];
            }
            
            if (currSizes.length > 0 && currColors.length === 0) {
                currSizes.forEach(s => combinations.push({size: s, color: null}));
            } else if (currSizes.length === 0 && currColors.length > 0) {
                currColors.forEach(c => combinations.push({size: null, color: c}));
            } else {
                currSizes.forEach(s => {
                    currColors.forEach(c => {
                        combinations.push({size: s, color: c});
                    });
                });
            }
            return combinations;
        }

        function generateVariantsTable() {
            const tbody = document.querySelector('#variantsTable tbody');
            const combinations = buildCombinations();
            
            // Backup currently inputted data in table
            const currentInputs = Array.from(tbody.querySelectorAll('tr')).map(tr => ({
                size: tr.dataset.size,
                color: tr.dataset.color,
                sku: tr.querySelector('.variant-sku').value,
                stock: tr.querySelector('.variant-stock').value
            }));

            // Identify initial load existing variants
            const productDataEl = document.getElementById('server-product-data');
            const existingProduct = productDataEl && productDataEl.getAttribute('data-product') !== 'null' ? JSON.parse(productDataEl.getAttribute('data-product')) : null;
            const dbVariants = (existingProduct && existingProduct.product_variants) ? existingProduct.product_variants : [];

            document.getElementById('variantsTable').style.display = combinations.length > 0 ? 'table' : 'none';
            tbody.innerHTML = '';
            activeVariants = [];

            if (combinations.length === 0) {
                updateVariantsInput();
                return;
            }

            combinations.forEach((combo, idx) => {
                const tr = document.createElement('tr');
                tr.dataset.size = combo.size || '';
                tr.dataset.color = combo.color || '';

                // Try to find previously typed input
                let matchedInput = currentInputs.find(c => c.size === (combo.size || '') && c.color === (combo.color || ''));
                
                // Try to find from DB on first load (if matchedInput is empty)
                if (!matchedInput) {
                    const matchedDb = dbVariants.find(v => (v.size || '') === (combo.size || '') && (v.color || '') === (combo.color || ''));
                    if (matchedDb) {
                        matchedInput = { sku: matchedDb.sku || '', stock: matchedDb.stock || 0 };
                    }
                }

                const skuVal = matchedInput ? matchedInput.sku : '';
                const stockVal = matchedInput ? matchedInput.stock : 0;

                tr.innerHTML = `
                    <td class="align-middle">${combo.size || '-'}</td>
                    <td class="align-middle">
                        ${combo.color ? `<div style="display:inline-block; width:15px; height:15px; border-radius:50%; background:${combo.color}; vertical-align:-2px; border:1px solid #ccc;"></div> <span dir="ltr">${combo.color}</span>` : '-'}
                    </td>
                    <td><input type="text" class="form-control variant-sku" placeholder="كود اختياري" value="${skuVal}" onchange="updateVariantsInput()"></td>
                    <td><input type="number" class="form-control variant-stock" min="0" value="${stockVal}" onchange="updateVariantsInput()" oninput="updateVariantsInput()"></td>
                `;
                tbody.appendChild(tr);
            });

            updateVariantsInput();
        }

        function updateVariantsInput() {
            const rows = document.querySelectorAll('#variantsTable tbody tr');
            const result = [];
            let totalStock = 0;
            rows.forEach(tr => {
                const stockVal = parseInt(tr.querySelector('.variant-stock').value) || 0;
                totalStock += stockVal;
                result.push({
                    size: tr.dataset.size || null,
                    color: tr.dataset.color || null,
                    sku: tr.querySelector('.variant-sku').value,
                    stock: stockVal
                });
            });
            document.getElementById('variantsDataInput').value = JSON.stringify(result);

            // Auto-sync main stock with variant totals
            const mainStockInput = document.getElementById('mainStockInput');
            const stockSyncHint = document.getElementById('stockSyncHint');
            if (rows.length > 0) {
                mainStockInput.value = totalStock;
                mainStockInput.readOnly = true;
                mainStockInput.style.background = '#f1f5f9';
                mainStockInput.style.cursor = 'not-allowed';
                if (stockSyncHint) stockSyncHint.style.display = 'block';
            } else {
                mainStockInput.readOnly = false;
                mainStockInput.style.background = '';
                mainStockInput.style.cursor = '';
                if (stockSyncHint) stockSyncHint.style.display = 'none';
            }
        }

        // ==========================
        // === Accessories Logic ===
        // ==========================
        function loadExistingAccessories() {
            const rawData = document.getElementById('accessoriesDataInput').value;
            let accList = [];
            try {
                accList = JSON.parse(rawData);
            } catch (e) {}
            
            if (Array.isArray(accList)) {
                accList.forEach(acc => addAccessoryRow(acc));
            }
        }

        function generateUniqueId() {
            return 'acc_' + Math.random().toString(36).substr(2, 9);
        }

        function addAccessoryRow(data = null) {
            const tbody = document.querySelector('#accessoriesTable tbody');
            const tr = document.createElement('tr');
            
            const id = data?.id || generateUniqueId();
            const imageUrl = data?.image_url || '';
            const name = data?.name || '';
            const price = data?.price || 0;

            tr.innerHTML = `
                <td>
                    <div style="display: flex; gap: 10px; align-items: flex-start;">
                        <img src="${imageUrl || 'https://via.placeholder.com/40'}" style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px; border: 1px solid #ccc; flex-shrink:0;" onerror="this.src='https://via.placeholder.com/40'">
                        <div style="display: flex; flex-direction: column; gap: 4px; flex-grow: 1;">
                            <input type="text" class="form-control form-control-sm acc-image" value="${imageUrl}" placeholder="رابط URL..." onchange="updateAccessoriesInput(); this.parentElement.previousElementSibling.src = this.value || 'https://via.placeholder.com/40'">
                            <input type="file" class="form-control form-control-sm acc-file" accept="image/*" onchange="const img=this.parentElement.previousElementSibling; if(this.files[0]){img.src=URL.createObjectURL(this.files[0]);} this.previousElementSibling.value=''; updateAccessoriesInput();">
                        </div>
                    </div>
                </td>
                <td><input type="text" class="form-control form-control-sm acc-name" placeholder="مثال: تغليف هدية فاخر" value="${name}" onchange="updateAccessoriesInput()"></td>
                <td><input type="number" class="form-control form-control-sm acc-price" placeholder="0" min="0" value="${price}" onchange="updateAccessoriesInput()"></td>
                <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove(); updateAccessoriesInput()"><i class="fas fa-trash"></i> إزالة</button></td>
            `;
            tr.dataset.id = id;
            tbody.appendChild(tr);
            updateAccessoriesInput();
        }

        function updateAccessoriesInput() {
            const rows = document.querySelectorAll('#accessoriesTable tbody tr');
            const result = [];
            rows.forEach(tr => {
                const name = tr.querySelector('.acc-name').value.trim();
                const price = parseFloat(tr.querySelector('.acc-price').value) || 0;
                const image_url = tr.querySelector('.acc-image').value.trim();
                
                if (name) {
                    result.push({
                        id: tr.dataset.id,
                        name,
                        price,
                        image_url
                    });
                }
            });
            document.getElementById('accessoriesDataInput').value = JSON.stringify(result);
        }

        // Add initialization to DOMContentLoaded
        document.addEventListener('DOMContentLoaded', () => {
            loadExistingAccessories();
        });

        // ==========================

        // On Load initialization
        document.addEventListener('DOMContentLoaded', () => {
            setTimeout(() => {
                generateVariantsTable();
            }, 500); // Wait for sizes and colors to finish parsing

            const sInput = document.getElementById('sizesInput');
            if (sInput) {
                sInput.addEventListener('input', () => {
                    generateVariantsTable();
                });
            }
        });

        // Discount Management Logic
        let discountMode = 'percent'; 

        function setDiscountMode(mode) {
            discountMode = mode;
            const price = parseFloat(document.querySelector('input[name="price"]').value) || 0;
            const currentDiscount = parseFloat(document.getElementById('hiddenDiscount').value) || 0;
            const btnPercent = document.getElementById('btnPercent');
            const btnPrice = document.getElementById('btnPrice');
            const label = document.getElementById('discountLabel');
            const input = document.getElementById('discountInput');

            if (mode === 'percent') {
                btnPercent.style.background = 'var(--primary)';
                btnPercent.style.color = 'white';
                btnPrice.style.background = 'transparent';
                btnPrice.style.color = '#64748b';
                label.textContent = '%';
                input.value = currentDiscount;
            } else {
                btnPrice.style.background = 'var(--primary)';
                btnPrice.style.color = 'white';
                btnPercent.style.background = 'transparent';
                btnPercent.style.color = '#64748b';
                label.textContent = 'ج.م';
                input.value = (price * (1 - currentDiscount / 100)).toFixed(2);
            }
            handleDiscountInput();
        }

        function handleDiscountInput() {
            const price = parseFloat(document.querySelector('input[name="price"]').value) || 0;
            const inputVal = parseFloat(document.getElementById('discountInput').value) || 0;
            const hiddenInput = document.getElementById('hiddenDiscount');
            const hint = document.getElementById('discountHint');

            if (discountMode === 'percent') {
                hiddenInput.value = inputVal;
                const finalPrice = price * (1 - inputVal / 100);
                hint.textContent = inputVal > 0 ? `السعر بعد الخصم: ${finalPrice.toFixed(2)} ج.م` : '';
            } else {
                if (price > 0) {
                    const percentage = Math.max(0, Math.min(100, (1 - (inputVal / price)) * 100));
                    hiddenInput.value = percentage;
                    hint.textContent = inputVal > 0 ? `نسبة الخصم المحسوبة: ${percentage.toFixed(2)}%` : '';
                } else {
                    hiddenInput.value = 0;
                    hint.textContent = 'أدخل سعر المنتج أولاً';
                }
            }
        }
    </script>

    <%- include('partials/footer') %>