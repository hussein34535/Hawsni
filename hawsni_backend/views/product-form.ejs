<%- include('partials/header', { title: product ? 'تعديل منتج' : 'إضافة منتج جديد' , pageTitle: product ? 'تعديل منتج'
    : 'إضافة منتج جديد' , page: 'products' }) %>

    <div class="card">
        <div class="card-header">
            <h2 class="card-title">
                <i class="fas fa-<%= product ? 'edit' : 'plus' %>"></i>
                <%= product ? 'تعديل منتج' : 'إضافة منتج جديد' %>
            </h2>
            <a href="/products" class="btn btn-secondary">
                <i class="fas fa-arrow-right"></i> رجوع
            </a>
        </div>

        <form action="/products<%= product ? '/' + product.id : '' %>" method="POST" enctype="multipart/form-data"
            onsubmit="return validateForm('productForm')" id="productForm">

            <% if (product) { %>
                <input type="hidden" name="_method" value="PUT">
                <% } %>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
                        <!-- Column 1 -->
                        <div>
                            <div class="form-group">
                                <label class="form-label">اسم المنتج <span
                                        style="color: var(--danger);">*</span></label>
                                <input type="text" name="name" class="form-control"
                                    value="<%= product ? product.name : '' %>" required>
                            </div>

                            <div class="form-group">
                                <label class="form-label">الوصف <span style="color: var(--danger);">*</span></label>
                                <textarea name="description" class="form-control" rows="4"
                                    required><%= product ? product.description : '' %></textarea>
                            </div>

                            <div class="form-group">
                                <label class="form-label">التصنيف</label>
                                <select name="category_id" class="form-control">
                                    <option value="">اختر التصنيف</option>
                                    <% categories.forEach(cat=> { %>
                                        <option value="<%= cat.id %>" <%=product && product.category_id===cat.id
                                            ? 'selected' : '' %>>
                                            <%= cat.name %>
                                        </option>
                                        <% }) %>
                                </select>
                            </div>

                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                                <div class="form-group">
                                    <label class="form-label">المقاسات</label>
                                    <input type="text" name="sizes" class="form-control"
                                        value="<%= product && product.sizes ? product.sizes.join(', ') : '' %>"
                                        placeholder="S, M, L, XL">
                                    <small class="text-muted">افصل بينها بفواصل</small>
                                </div>

                                <div class="form-group">
                                    <label class="form-label">الألوان</label>
                                    <div style="display: flex; gap: 0.5rem; align-items: center; margin-bottom: 1rem;">
                                        <input type="color" id="colorPicker" class="form-control"
                                            style="width: 50px; padding: 0; height: 40px;" value="#000000">
                                        <select id="imageSelector" class="form-control" style="flex: 1;">
                                            <option value="">بدون صورة (اختياري)</option>
                                        </select>
                                        <button type="button" class="btn btn-secondary" onclick="addColor()"
                                            style="padding: 0.5rem 1rem;">
                                            <i class="fas fa-plus"></i> إضافة
                                        </button>
                                    </div>
                                    <input type="hidden" name="colors" id="colorsInput"
                                        value="<%= product && product.colors ? JSON.stringify(product.colors) : '' %>">
                                    <div id="colorsContainer" style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                                        <!-- Swatches will be added here -->
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Column 2 -->
                        <div>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                                <div class="form-group">
                                    <label class="form-label">السعر <span style="color: var(--danger);">*</span></label>
                                    <input type="number" name="price" class="form-control" step="0.01"
                                        value="<%= product ? product.price : '' %>" required>
                                </div>

                                <div class="form-group">
                                    <label class="form-label">الخصم (%)</label>
                                    <input type="number" name="discount" class="form-control" min="0" max="100"
                                        value="<%= product ? product.discount : 0 %>">
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="form-label">المخزون <span style="color: var(--danger);">*</span></label>
                                <input type="number" name="stock" class="form-control" min="0"
                                    value="<%= product ? product.stock : 0 %>" required>
                            </div>

                            <div class="form-group">
                                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                                    <input type="checkbox" name="is_featured" <%=product && product.is_featured
                                        ? 'checked' : '' %>>
                                    <span class="form-label" style="margin: 0;">منتج مميز</span>
                                </label>
                            </div>

                            <div class="form-group">
                                <label class="form-label">الصور (حتى 5 صور)</label>
                                <input type="file" name="images" class="form-control" multiple accept="image/*"
                                    onchange="previewImages(this)" id="imageInput">

                                <% if (product && product.images && product.images.length> 0) { %>
                                    <div id="existingImages"
                                        style="display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1rem;">
                                        <% product.images.forEach((image, index)=> { %>
                                            <img src="<%= image %>" data-index="<%= index %>"
                                                style="width: 100px; height: 100px; object-fit: cover; border-radius: var(--radius-md); border: 2px solid var(--light-gray);">
                                            <% }) %>
                                    </div>
                                    <% } %>

                                        <div id="imagePreview"
                                            style="display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1rem;"></div>

                                        <% if (product) { %>
                                            <div style="margin-top: 1rem;">
                                                <a href="/products/<%= product.id %>/images" class="btn btn-info"
                                                    style="width: 100%; text-align: center;">
                                                    <i class="fas fa-images"></i> إدارة الصور (ترتيب / حذف)
                                                </a>
                                            </div>
                                            <% } %>
                            </div>
                        </div>
                    </div>

                    <div
                        style="display: flex; gap: 1rem; margin-top: 2rem; padding-top: 2rem; border-top: 2px solid var(--light-gray);">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i>
                            <%= product ? 'حفظ التعديلات' : 'إضافة المنتج' %>
                        </button>
                        <a href="/products" class="btn btn-secondary">إلغاء</a>
                    </div>
        </form>
    </div>

    <script>
        let productImages = [];

        function previewImages(input) {
            const preview = document.getElementById('imagePreview');
            preview.innerHTML = '';

            if (input.files) {
                Array.from(input.files).forEach((file, index) => {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        const img = document.createElement('img');
                        img.src = e.target.result;
                        img.dataset.index = productImages.length + index;
                        img.style.cssText = 'width: 100px; height: 100px; object-fit: cover; border-radius: var(--radius-md); border: 2px solid var(--primary-color);';
                        preview.appendChild(img);
                    };
                    reader.readAsDataURL(file);
                });
            }
            updateImageSelector();
        }

        function updateImageSelector() {
            const selector = document.getElementById('imageSelector');
            const existingImages = document.querySelectorAll('#existingImages img');
            const newImages = document.querySelectorAll('#imagePreview img');

            selector.innerHTML = '<option value="">بدون صورة (اختياري)</option>';

            existingImages.forEach((img, index) => {
                const option = document.createElement('option');
                option.value = index;
                option.textContent = `صورة ${index + 1} (موجودة)`;
                selector.appendChild(option);
            });

            newImages.forEach((img, index) => {
                const option = document.createElement('option');
                option.value = existingImages.length + index;
                option.textContent = `صورة ${existingImages.length + index + 1} (جديدة)`;
                selector.appendChild(option);
            });
        }

        // Color Management with Image Mapping
        let colors = [];
        const colorsInput = document.getElementById('colorsInput');
        const colorsContainer = document.getElementById('colorsContainer');

        // Initialize colors from hidden input on page load
        document.addEventListener('DOMContentLoaded', function () {
            updateImageSelector();

            if (colorsInput && colorsInput.value) {
                try {
                    const parsedColors = JSON.parse(colorsInput.value);
                    // Handle both old format (array of strings) and new format (array of objects)
                    if (Array.isArray(parsedColors)) {
                        colors = parsedColors.map(c => {
                            if (typeof c === 'string') {
                                return { color: c, imageIndex: null };
                            }
                            return c;
                        });
                    }
                } catch (e) {
                    // Fallback for old comma-separated format
                    colors = colorsInput.value.split(',').filter(c => c.trim() !== '').map(c => ({
                        color: c.trim(),
                        imageIndex: null
                    }));
                }
                renderColors();
            }
        });

        function addColor() {
            const colorPicker = document.getElementById('colorPicker');
            const imageSelector = document.getElementById('imageSelector');
            const color = colorPicker.value;
            const imageIndex = imageSelector.value ? parseInt(imageSelector.value) : null;

            // Check if color already exists
            const existingIndex = colors.findIndex(c => c.color === color);
            if (existingIndex >= 0) {
                // Update existing color's image
                colors[existingIndex].imageIndex = imageIndex;
            } else {
                // Add new color
                colors.push({ color, imageIndex });
            }

            updateColorsInput();
            renderColors();
        }

        function removeColor(index) {
            colors.splice(index, 1);
            updateColorsInput();
            renderColors();
        }

        function updateColorsInput() {
            colorsInput.value = JSON.stringify(colors);
        }

        function renderColors() {
            colorsContainer.innerHTML = '';
            colors.forEach((colorObj, index) => {
                const swatch = document.createElement('div');
                swatch.style.cssText = `
                    display: flex; 
                    align-items: center; 
                    gap: 0.5rem; 
                    background: #f8f9fa; 
                    padding: 0.25rem 0.5rem; 
                    border-radius: 20px; 
                    border: 1px solid #dee2e6;
                `;

                const circle = document.createElement('div');
                circle.style.cssText = `
                    width: 20px; 
                    height: 20px; 
                    border-radius: 50%; 
                    background-color: ${colorObj.color};
                    border: 1px solid #dee2e6;
                `;

                const text = document.createElement('span');
                text.innerText = colorObj.color;
                text.style.fontSize = '0.875rem';

                // Show linked image if exists
                if (colorObj.imageIndex !== null) {
                    const imageIcon = document.createElement('i');
                    imageIcon.className = 'fas fa-image';
                    imageIcon.style.cssText = 'color: #28a745; font-size: 0.75rem;';
                    imageIcon.title = `مرتبط بصورة ${colorObj.imageIndex + 1}`;
                    swatch.appendChild(circle);
                    swatch.appendChild(text);
                    swatch.appendChild(imageIcon);
                } else {
                    swatch.appendChild(circle);
                    swatch.appendChild(text);
                }

                const removeBtn = document.createElement('button');
                removeBtn.innerHTML = '&times;';
                removeBtn.style.cssText = `
                    background: none; 
                    border: none; 
                    color: #dc3545; 
                    font-size: 1.25rem; 
                    cursor: pointer; 
                    line-height: 1;
                    padding: 0 0.25rem;
                `;
                removeBtn.onclick = () => removeColor(index);

                swatch.appendChild(removeBtn);
                colorsContainer.appendChild(swatch);
            });
        }
    </script>

    <%- include('partials/footer') %>