        // === Compress image to max 4MB ===
        function compressImage(file, maxSizeMB = 4) {
            return new Promise((resolve) => {
                const maxSize = maxSizeMB * 1024 * 1024;
                if (file.size <= maxSize) { resolve(file); return; }

                const img = new window.Image();
                const url = URL.createObjectURL(file);
                img.onload = () => {
                    URL.revokeObjectURL(url);
                    let w = img.width, h = img.height;
                    let quality = 0.8;

                    // Scale down if very large
                    const maxDim = 2000;
                    if (w > maxDim || h > maxDim) {
                        const ratio = Math.min(maxDim / w, maxDim / h);
                        w = Math.round(w * ratio);
                        h = Math.round(h * ratio);
                    }

                    const canvas = document.createElement('canvas');
                    canvas.width = w; canvas.height = h;
                    canvas.getContext('2d').drawImage(img, 0, 0, w, h);

                    (function tryCompress() {
                        canvas.toBlob((blob) => {
                            if (blob.size <= maxSize || quality <= 0.3) {
                                resolve(new File([blob], file.name, { type: 'image/jpeg' }));
                            } else {
                                quality -= 0.1;
                                canvas.toBlob((b2) => {
                                    resolve(new File([b2], file.name, { type: 'image/jpeg' }));
                                }, 'image/jpeg', quality);
                            }
                        }, 'image/jpeg', quality);
                    })();
                };
                img.src = url;
            });
        }

        // === Direct Cloudinary Upload on Submit ===
        async function handleProductSubmit(e) {
            e.preventDefault();
            if (!validateForm('productForm')) return false;

            const form = document.getElementById('productForm');
            const submitBtn = form.querySelector('button[type="submit"]');
            const originalText = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري تجهيز الصور...';

            try {
                // 1. Get files to upload
                const filesToUpload = imageState.filter(img => img.type === 'file' && img.file);
                const uploadedUrls = [];

                if (filesToUpload.length > 0) {
                    // Compress image files over 4MB, skip compression for videos
                    for (let i = 0; i < filesToUpload.length; i++) {
                        const isVideo = filesToUpload[i].file.type.startsWith('video/');
                        if (!isVideo && filesToUpload[i].file.size > 4 * 1024 * 1024) {
                            submitBtn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> ضغط صورة ${i + 1}...`;
                            filesToUpload[i].file = await compressImage(filesToUpload[i].file);
                        }
                    }

                    // 2. Prepare Cloudinary parameters
                    const isVideoUpload = filesToUpload.some(img => img.file.type.startsWith('video/'));
                    const videoTransform = 'w_1280,h_720,c_limit,br_500k,q_auto:eco,vc_h264,ac_aac,f_mp4';
                    
                    // 3. Get Cloudinary signature from backend
                    // If we have videos, we need to sign the eager transformation
                    const signUrl = `/api/cloudinary/sign?folder=products${isVideoUpload ? `&eager=${videoTransform}&resource_type=video` : ''}`;
                    const signRes = await fetch(signUrl);
                    const signData = await signRes.json();

                    // 4. Upload each file directly to Cloudinary
                    for (let i = 0; i < filesToUpload.length; i++) {
                        submitBtn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> رفع ملف ${i + 1}/${filesToUpload.length}...`;

                        const file = filesToUpload[i].file;
                        const isVideo = file.type.startsWith('video/');

                        const formData = new FormData();
                        formData.append('file', file);
                        formData.append('api_key', signData.api_key);
                        formData.append('timestamp', signData.timestamp);
                        formData.append('signature', signData.signature);
                        formData.append('folder', signData.folder);
                        
                        // Add eager transformations for videos
                        if (isVideo) {
                            formData.append('eager', videoTransform);
                        }

                        // Let Cloudinary auto-detect if image or video
                        const uploadEndpoint = `https://api.cloudinary.com/v1_1/${signData.cloud_name}/${isVideo ? 'video' : 'image'}/upload`;

                        const cloudRes = await fetch(uploadEndpoint, {
                            method: 'POST',
                            body: formData
                        });
                        const cloudData = await cloudRes.json();
                        
                        let finalUrl = cloudData.secure_url;
                        // Use the compressed (eager) version for videos
                        if (isVideo && cloudData.eager && cloudData.eager.length > 0) {
                            finalUrl = cloudData.eager[0].secure_url;
                            console.log('✅ Using compressed video URL:', finalUrl);
                        }

                        if (finalUrl) {
                            filesToUpload[i].url = finalUrl;
                            filesToUpload[i].type = 'existing';
                        } else {
                            throw new Error(cloudData.error?.message || 'فشل رفع الملف');
                        }
                    }
                }

                // 4. Handle Accessories Uploads
                const accessoryRows = document.querySelectorAll('#accessoriesTable tbody tr');
                if (accessoryRows.length > 0) {
                    for (let i = 0; i < accessoryRows.length; i++) {
                        const row = accessoryRows[i];
                        const fileInput = row.querySelector('.acc-file');
                        if (fileInput && fileInput.files && fileInput.files.length > 0) {
                            submitBtn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> رفع صورة الملحق ${i + 1}...`;
                            const file = fileInput.files[0];
                            
                            // Let's compress it just in case
                            const compressedFile = await compressImage(file, 2); // max 2MB for accessories
                            
                            const signUrl = `/api/cloudinary/sign?folder=accessories`;
                            const signRes = await fetch(signUrl);
                            const signData = await signRes.json();
                            
                            const formData = new FormData();
                            formData.append('file', compressedFile);
                            formData.append('api_key', signData.api_key);
                            formData.append('timestamp', signData.timestamp);
                            formData.append('signature', signData.signature);
                            formData.append('folder', signData.folder);
                            
                            const uploadEndpoint = `https://api.cloudinary.com/v1_1/${signData.cloud_name}/image/upload`;
                            const cloudRes = await fetch(uploadEndpoint, { method: 'POST', body: formData });
                            const cloudData = await cloudRes.json();
                            
                            if (cloudData.secure_url) {
                                row.querySelector('.acc-image').value = cloudData.secure_url;
                            }
                        }
                    }
                    // Sync the inputs into the JSON payload
                    updateAccessoriesInput();
                }

                // 5. Preserve perfect drag-and-drop sort order.
                // We map all imageState objects (which now all have real URLs)
                const finalOrderedUrls = imageState.map(img => img.url);

                // 6. Send the exact ordered sequence to the backend via 'image_urls'
                document.getElementById('directUploadUrls').value = JSON.stringify(finalOrderedUrls);

                // 6. Clear other inputs so backend 'updateProductAdmin' doesn't prepend or append duplicates
                document.getElementById('scrapedImagesInput').value = '[]';
                document.getElementById('retainedImagesInput').value = '[]';

                // 7. Submit form normally
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الحفظ...';
                form.submit();
            } catch (err) {
                console.error('Upload error:', err);
                alert('خطأ في رفع الصور: ' + err.message);
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
            return false;
        }

