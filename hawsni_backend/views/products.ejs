<%- include('partials/header', { title: 'إدارة المنتجات' , pageTitle: 'المنتجات' , page: 'products' }) %>

<style>
    /* Specific Product Page Tweaks */
    .product-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .product-item {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 1.2rem;
        background: var(--bg-card);
        border: 1px solid var(--border-soft);
        border-radius: var(--radius-md);
        transition: var(--trans-base);
    }
    .product-item:hover {
        box-shadow: var(--shadow-md);
        border-color: var(--brand-primary);
    }
    .product-img-small {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: var(--radius-sm);
        border: 1px solid var(--border-soft);
    }
    .product-info-main {
        flex: 1;
        min-width: 0;
    }
    .product-name-link {
        font-weight: 800;
        color: var(--text-main);
        font-size: 1rem;
        display: block;
        margin-bottom: 4px;
    }
    .product-meta-row {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }
    
    @media (max-width: 768px) {
        .product-item { padding: 1rem; gap: 10px; }
        .product-img-small { width: 50px; height: 50px; }
        .product-name-link { font-size: 0.9rem; }
    }
</style>

    <div class="card">
        <div class="card-header">
            <h2 class="card-title">
                <i class="fas fa-box" style="color: var(--brand-primary);"></i>
                <span>المنتجات</span>
                <span class="badge badge-info" style="font-size: 0.7rem; margin-right: 8px;"><%= products ? products.length : 0 %></span>
            </h2>
            <a href="/products/new" class="btn btn-primary btn-sm">
                <i class="fas fa-plus"></i> إضافة منتج
            </a>
        </div>

        <% if (products && products.length > 0) { %>
            <!-- Bulk Action Bar -->
            <div id="bulkBar" class="hidden" style="background: var(--brand-light); border: 1px solid var(--brand-primary); border-radius: var(--radius-md); padding: 12px; margin-bottom: 1.5rem; display: none; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <span id="selectedCount" style="font-weight: 800; color: var(--brand-primary);">0 محدد</span>
                    <button onclick="clearSelection()" class="btn btn-secondary btn-sm" style="padding: 4px 8px;">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                    <select id="bulkCategorySelect" class="form-control" style="height: 36px; padding: 0 10px; font-size: 0.8rem; width: auto;">
                        <option value="">نقل للتصنيف...</option>
                        <% categories.forEach(cat => { %>
                            <option value="<%= cat.id %>"><%= cat.name %></option>
                        <% }) %>
                    </select>
                    <button onclick="bulkChangeCategory()" class="btn btn-primary btn-sm" style="height: 36px;">
                        تطبيق
                    </button>
                    <button onclick="bulkToggleFeatured(true)" class="btn btn-secondary btn-sm" style="height: 36px;">
                        <i class="fas fa-star"></i> تمييز
                    </button>
                    <button onclick="bulkToggleFeatured(false)" class="btn btn-secondary btn-sm" style="height: 36px;">
                        <i class="far fa-star"></i> إزالة التمييز
                    </button>
                    <button onclick="bulkDelete()" class="btn btn-danger btn-sm" style="height: 36px;">
                        <i class="fas fa-trash"></i> حذف
                    </button>
                </div>
            </div>

            <!-- Select All & Filters -->
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; padding: 0 4px;">
                <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; font-weight: 700; color: var(--text-muted); font-size: 0.85rem;">
                    <input type="checkbox" id="selectAll" onchange="toggleAll(this)" style="width: 20px; height: 20px; accent-color: var(--brand-primary);">
                    تحديد الكل
                </label>
            </div>

            <!-- Products List (Card Style) -->
            <div class="product-list">
                <% products.forEach(product => { %>
                    <div class="product-item" id="row-<%= product.id %>">
                        <input type="checkbox" class="product-checkbox" value="<%= product.id %>" onchange="updateBulkBar()" style="width: 18px; height: 18px; accent-color: var(--brand-primary); flex-shrink: 0;">
                        
                        <% if (product.images && product.images.length > 0) { %>
                            <img src="<%= product.images[0] %>" alt="<%= product.name %>" class="product-img-small">
                        <% } else { %>
                            <div class="product-img-small" style="background: var(--bg-main); display: flex; align-items: center; justify-content: center; color: var(--text-muted); font-size: 1.2rem;">
                                <i class="fas fa-image"></i>
                            </div>
                        <% } %>

                        <div class="product-info-main">
                            <a href="/products/<%= product.id %>/edit" class="product-name-link"><%= product.name %></a>
                            <div class="product-meta-row">
                                <span style="font-weight: 900; color: var(--brand-primary); font-size: 0.9rem;">
                                    <%= product.price ? product.price.toFixed(0) : '0' %> ج.م
                                </span>
                                <span class="badge <%= (product.stock > 10) ? 'badge-success' : (product.stock > 0 ? 'badge-warning' : 'badge-danger') %>" style="font-size: 0.65rem; padding: 2px 8px;">
                                    مخزون: <%= product.stock || 0 %>
                                </span>
                                <% if (product.category_name) { %>
                                    <span style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600;">
                                        <i class="fas fa-tag" style="font-size: 0.6rem; opacity: 0.5;"></i> <%= product.category_name %>
                                    </span>
                                <% } %>
                            </div>
                        </div>

                        <div style="display: flex; gap: 8px; flex-shrink: 0;">
                            <a href="/products/<%= product.id %>/edit" class="btn btn-secondary btn-sm" style="padding: 8px; width: 36px; height: 36px;" title="تعديل">
                                <i class="fas fa-pen" style="font-size: 0.8rem;"></i>
                            </a>
                            <button onclick="handleDelete('/products/<%= product.id %>', '<%= product.name %>')" class="btn btn-danger btn-sm" style="padding: 8px; width: 36px; height: 36px;" title="حذف">
                                <i class="fas fa-trash" style="font-size: 0.8rem;"></i>
                            </button>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div style="text-align: center; padding: 3rem; color: var(--medium-gray);">
                <i class="fas fa-box" style="font-size: 3rem; opacity: 0.2; margin-bottom: 0.75rem; display: block;"></i>
                <p style="font-size: 0.95rem; font-weight: 600;">لا توجد منتجات حتى الآن</p>
                <a href="/products/new" class="btn btn-primary btn-sm" style="margin-top: 1rem;">
                    <i class="fas fa-plus"></i> إضافة أول منتج
                </a>
            </div>
        <% } %>
    </div>

    <script>
        function getSelectedIds() {
            return [...document.querySelectorAll('.product-checkbox:checked')].map(cb => cb.value);
        }

        function updateBulkBar() {
            const ids = getSelectedIds();
            const bar = document.getElementById('bulkBar');
            document.getElementById('selectedCount').textContent = ids.length + ' محدد';
            if (ids.length > 0) {
                bar.style.display = 'flex';
                bar.classList.add('visible');
            } else {
                bar.style.display = 'none';
                bar.classList.remove('visible');
            }
            document.getElementById('selectAll').indeterminate =
                ids.length > 0 && ids.length < document.querySelectorAll('.product-checkbox').length;
            document.getElementById('selectAll').checked =
                ids.length === document.querySelectorAll('.product-checkbox').length;
        }

        function toggleAll(cb) {
            document.querySelectorAll('.product-checkbox').forEach(c => c.checked = cb.checked);
            updateBulkBar();
        }

        function clearSelection() {
            document.querySelectorAll('.product-checkbox').forEach(c => c.checked = false);
            document.getElementById('selectAll').checked = false;
            updateBulkBar();
        }

        async function bulkDelete() {
            const ids = getSelectedIds();
            if (!ids.length) return;
            showConfirm(`هل أنت متأكد من حذف ${ids.length} منتج؟`, async () => {
                try {
                    const res = await fetch('/products/bulk-delete', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ ids })
                    });
                    const data = await res.json();
                    if (data.success) {
                        showToast(`تم حذف ${ids.length} منتج بنجاح`, 'success');
                        ids.forEach(id => {
                            const row = document.getElementById('row-' + id);
                            if (row) row.remove();
                        });
                        clearSelection();
                    } else {
                        showToast(data.message || 'فشل الحذف', 'error');
                    }
                } catch (e) {
                    showToast('حدث خطأ أثناء الحذف', 'error');
                }
            });
        }

        async function bulkChangeCategory() {
            const ids = getSelectedIds();
            const categoryId = document.getElementById('bulkCategorySelect').value;
            if (!ids.length) return showToast('اختر منتجات أولاً', 'error');
            if (!categoryId) return showToast('اختر تصنيفاً', 'error');

            try {
                const res = await fetch('/products/bulk-update', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ids, updates: { category_id: categoryId } })
                });
                const data = await res.json();
                if (data.success) {
                    showToast('تم تغيير التصنيف بنجاح', 'success');
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    showToast(data.message || 'فشل التحديث', 'error');
                }
            } catch (e) {
                showToast('حدث خطأ', 'error');
            }
        }

        async function bulkToggleFeatured(isFeatured) {
            const ids = getSelectedIds();
            if (!ids.length) return showToast('اختر منتجات أولاً', 'error');

            try {
                const res = await fetch('/products/bulk-update', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ids, updates: { is_featured: isFeatured } })
                });
                const data = await res.json();
                if (data.success) {
                    showToast('تم تحديث حالة التمييز بنجاح', 'success');
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    showToast(data.message || 'فشل التحديث', 'error');
                }
            } catch (e) {
                showToast('حدث خطأ', 'error');
            }
        }

        // Override handleDelete for products
        async function handleDelete(url, itemName) {
            showConfirm(`هل أنت متأكد من حذف ${itemName}؟`, async () => {
                url = url.replace(/([^:]\/)\//g, "$1");
                try {
                    const res = await fetch(url, {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' }
                    });
                    const data = await res.json();
                    if (res.ok) {
                        showToast('تم الحذف بنجاح', 'success');
                        setTimeout(() => window.location.reload(), 1000);
                    } else {
                        showToast(data.message || 'فشل الحذف', 'error');
                    }
                } catch (error) {
                    console.error('Delete Error:', error);
                    showToast('حدث خطأ أثناء الحذف', 'error');
                }
            });
        }
    </script>

    <%- include('partials/footer') %>