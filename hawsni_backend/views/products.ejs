<%- include('partials/header', { title: 'إدارة المنتجات' , pageTitle: 'المنتجات' , page: 'products' }) %>

    <div class="card">
        <div class="card-header">
            <h2 class="card-title">
                <i class="fas fa-box"></i> جميع المنتجات
            </h2>
            <a href="/products/new" class="btn btn-primary">
                <i class="fas fa-plus"></i> إضافة منتج جديد
            </a>
        </div>

        <% if (products && products.length> 0) { %>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>المنتج</th>
                            <th>السعر</th>
                            <th>الكمية</th>
                            <th>التصنيف</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% products.forEach(product=> { %>
                            <tr>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                                        <% if (product.images && product.images.length> 0) { %>
                                            <img src="<%= product.images[0] %>" alt="<%= product.name %>"
                                                style="width: 60px; height: 60px; border-radius: var(--radius-md); object-fit: cover; border: 2px solid var(--light-gray);">
                                            <% } else { %>
                                                <div
                                                    style="width: 60px; height: 60px; border-radius: var(--radius-md); background: var(--light-gray); display: flex; align-items: center; justify-content: center;">
                                                    <i class="fas fa-image" style="color: var(--medium-gray);"></i>
                                                </div>
                                                <% } %>
                                                    <div>
                                                        <div
                                                            style="font-weight: 600; color: var(--dark-gray); margin-bottom: 0.25rem;">
                                                            <%= product.name %>
                                                        </div>
                                                        <div style="font-size: 0.85rem; color: var(--medium-gray);">
                                                            <%= product.description ? product.description.substring(0,
                                                                40) + '...' : 'لا يوجد وصف' %>
                                                        </div>
                                                    </div>
                                    </div>
                                </td>
                                <td>
                                    <span style="font-weight: 700; color: var(--success); font-size: 1.1rem;">
                                        <%= product.price ? product.price.toFixed(2) : '0.00' %> ج.م
                                    </span>
                                </td>
                                <td>
                                    <span
                                        class="badge <%= (product.stock > 10) ? 'badge-success' : (product.stock > 0 ? 'badge-warning' : 'badge-danger') %>">
                                        <%= product.stock || 0 %> قطعة
                                    </span>
                                </td>
                                <td>
                                    <%= product.category_name || '-' %>
                                </td>
                                <td>
                                    <div style="display: flex; gap: 0.5rem;">
                                        <a href="/products/<%= product.id %>/edit" class="btn btn-secondary btn-sm">
                                            <i class="fas fa-edit"></i> تعديل
                                        </a>
                                        <button
                                            onclick="handleDelete('/products/<%= product.id %>/delete', 'هذا المنتج')"
                                            class="btn btn-danger btn-sm">
                                            <i class="fas fa-trash"></i> حذف
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
                <div class="text-center" style="padding: 3rem; color: var(--medium-gray);">
                    <i class="fas fa-box" style="font-size: 4rem; margin-bottom: 1rem; opacity: 0.3;"></i>
                    <p style="font-size: 1.1rem;">لا توجد منتجات حتى الآن</p>
                    <a href="/products/new" class="btn btn-primary" style="margin-top: 1rem;">
                        <i class="fas fa-plus"></i> إضافة أول منتج
                    </a>
                </div>
                <% } %>
    </div>

    <script>
        // Override handleDelete for products (uses POST to /products/:id/delete)
        // Handles deletion via Fetch API (Modern & Robust)
        async function handleDelete(url, itemName) {
            if (!confirm(`هل أنت متأكد من حذف ${itemName}؟`)) return;

            // Ensure URL has no double slashes (fix for missing ID)
            url = url.replace(/([^:]\/)\/+/g, "$1");

            // Validate URL
            if (url.endsWith('/products/') || url === '/products/delete' || url === '/products') {
                alert('خطأ: المعرف (ID) غير موجود لهذا العنصر!');
                return;
            }

            try {
                // Try sending standard DELETE request first
                const res = await fetch(url, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                if (res.ok) {
                    showToast('تم الحذف بنجاح', 'success');
                    setTimeout(() => window.location.reload(), 1000);
                    return;
                } else if (res.status === 404) {
                    // Fallback: Try POST with _method override (if server expects that)
                    const formRes = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: '_method=DELETE'
                    });
                    if (formRes.ok) {
                        showToast('تم الحذف بنجاح', 'success');
                        setTimeout(() => window.location.reload(), 1000);
                        return;
                    }
                }

                const data = await res.json();
                throw new Error(data.message || 'فشل الحذف');
            } catch (error) {
                console.error('Delete Error:', error);
                showToast(error.message || 'حدث خطأ أثناء الحذف', 'error');
            }
        }
    </script>

    <%- include('partials/footer') %>