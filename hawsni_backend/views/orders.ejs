<%- include('partials/header', { title: 'إدارة الطلبات' , pageTitle: 'الطلبات' , page: 'orders' }) %>

    <div class="card">
        <div class="card-header">
            <h2 class="card-title">
                <i class="fas fa-shopping-cart"></i> جميع الطلبات
            </h2>
        </div>

        <% if (orders && orders.length> 0) { %>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>رقم الطلب</th>
                            <th>المبلغ</th>
                            <th>الحالة</th>
                            <th>التاريخ</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% orders.forEach(order=> { %>
                            <tr>
                                <td>
                                    <span style="font-weight: 600; color: var(--dark-gray);">
                                        #<%= order.id.substring(0, 8) %>
                                    </span>
                                </td>
                                <td>
                                    <span style="font-weight: 700; color: var(--success); font-size: 1.1rem;">
                                        <%= parseFloat(order.total).toFixed(2) %> ج.م
                                    </span>
                                </td>
                                <td>
                                    <% const statusMap={ 'Processing' : 'warning' , 'Shipped' : 'info' , 'In Transit'
                                        : 'info' , 'Delivered' : 'success' , 'Cancelled' : 'danger' }; const
                                        statusClass=statusMap[order.status] || 'warning' ; %>
                                        <span class="badge badge-<%= statusClass %>">
                                            <%= order.status || 'Processing' %>
                                        </span>
                                </td>
                                <td>
                                    <%= new Date(order.created_at).toLocaleDateString('ar-EG', { year: 'numeric' ,
                                        month: 'long' , day: 'numeric' }) %>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
                <div class="text-center" style="padding: 3rem; color: var(--medium-gray);">
                    <i class="fas fa-shopping-cart" style="font-size: 4rem; margin-bottom: 1rem; opacity: 0.3;"></i>
                    <p style="font-size: 1.1rem;">لا توجد طلبات حتى الآن</p>
                </div>
                <% } %>
    </div>

    <%- include('partials/footer') %>