<%- include('partials/header', { title: 'إدارة الطلبات' , pageTitle: 'الطلبات' , page: 'orders' }) %>

    <div class="card">
        <div class="card-header">
            <h2 class="card-title">
                <i class="fas fa-shopping-cart"></i> جميع الطلبات
            </h2>
        </div>

        <% if (orders && orders.length> 0) { %>
            <!-- Bulk Action Bar -->
            <div id="bulkBar"
                style="display:none; background: #f0f4ff; border: 1px solid #c7d7ff; border-radius: 10px; padding: 0.75rem 1.25rem; margin-bottom: 1rem; align-items: center; gap: 1rem; flex-wrap: wrap;">
                <span id="selectedCount" style="font-weight: 600; color: #3b5bdb;">0 محدد</span>
                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
                    <select id="bulkStatusSelect" class="form-control"
                        style="width: auto; padding: 0.3rem 0.75rem; font-size: 0.85rem;">
                        <option value="">-- تغيير الحالة --</option>
                        <option value="Processing">قيد المعالجة</option>
                        <option value="Shipped">تم الشحن</option>
                        <option value="In Transit">في الطريق</option>
                        <option value="Delivered">تم التوصيل</option>
                        <option value="Cancelled">ملغي</option>
                    </select>
                    <button onclick="bulkChangeStatus()" class="btn btn-primary btn-sm">
                        <i class="fas fa-check"></i> تطبيق الحالة
                    </button>
                    <button onclick="clearSelection()" class="btn btn-sm" style="background:#e9ecef; color:#555;">
                        <i class="fas fa-times"></i> إلغاء التحديد
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th style="width:40px;">
                                <input type="checkbox" id="selectAll" onchange="toggleAll(this)"
                                    style="width:16px;height:16px;cursor:pointer;">
                            </th>
                            <th>المنتج</th>
                            <th>العميل</th>
                            <th>رقم الطلب</th>
                            <th>المبلغ</th>
                            <th>الحالة</th>
                            <th>التاريخ</th>
                            <th>تغيير الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% orders.forEach(order=> { %>
                            <tr id="row-<%= order.id %>">
                                <td>
                                    <input type="checkbox" class="order-checkbox" value="<%= order.id %>"
                                        onchange="updateBulkBar()" style="width:16px;height:16px;cursor:pointer;">
                                </td>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                                        <% if (order.product_image) { %>
                                            <img src="<%= order.product_image %>" alt="<%= order.product_name %>"
                                                style="width: 60px; height: 60px; border-radius: var(--radius-md); object-fit: cover; border: 2px solid var(--light-gray);">
                                            <% } else { %>
                                                <div
                                                    style="width: 60px; height: 60px; border-radius: var(--radius-md); background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary-color) 100%); display: flex; align-items: center; justify-content: center;">
                                                    <i class="fas fa-shopping-bag"
                                                        style="color: var(--dark); opacity: 0.3; font-size: 1.5rem;"></i>
                                                </div>
                                                <% } %>
                                                    <div>
                                                        <div style="font-weight: 600; color: var(--dark-gray);">
                                                            <%= order.product_name %>
                                                        </div>
                                                        <% if (order.items_count> 1) { %>
                                                            <small style="color: var(--medium-gray);">
                                                                + <%= order.items_count - 1 %> منتجات أخرى
                                                            </small>
                                                            <% } %>
                                                    </div>
                                    </div>
                                </td>
                                <td>
                                    <% let customerName='غير معروف' ; let customerPhone='-' ; let
                                        displayAddress='بدون عنوان' ; // 1. Try to get from joined users table if
                                        (order.users) { customerName=order.users.name || customerName;
                                        customerPhone=order.users.phone || customerPhone; } // 2. Try to get or override
                                        from shipping_address let shipping=order.shipping_address; if (typeof
                                        shipping==='string' && shipping.trim().startsWith('{')) { try {
                                        shipping=JSON.parse(shipping); } catch (e) { } } if (typeof shipping==='object'
                                        && shipping !==null) { customerName=shipping.name || shipping.guestName ||
                                        customerName; customerPhone=shipping.phone || shipping.guestPhone ||
                                        customerPhone; displayAddress=shipping.address || shipping.shippingAddress ||
                                        displayAddress; } else if (typeof shipping==='string' && shipping.trim() !=='' )
                                        { displayAddress=shipping; } %>
                                        <div style="font-size: 0.9rem;">
                                            <strong>
                                                <%= customerName %>
                                            </strong><br>
                                            <small>
                                                <%= customerPhone %>
                                            </small><br>
                                            <small
                                                style="color: var(--medium-gray); display: block; max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"
                                                title="<%= displayAddress %>">
                                                <%= displayAddress %>
                                            </small>
                                        </div>
                                </td>
                                <td>
                                    <span style="font-weight: 600; color: var(--dark-gray);">
                                        #<%= order.id.substring(0, 8) %>
                                    </span>
                                </td>
                                <td>
                                    <span style="font-weight: 700; color: var(--success); font-size: 1.1rem;">
                                        <%= parseFloat(order.total).toFixed(2) %> ج.م
                                    </span>
                                </td>
                                <td>
                                    <% const statusMap={ 'Processing' : 'warning' , 'Shipped' : 'info' , 'In Transit'
                                        : 'info' , 'Delivered' : 'success' , 'Cancelled' : 'danger' }; const
                                        statusClass=statusMap[order.status] || 'warning' ; %>
                                        <span class="badge badge-<%= statusClass %>" id="status-badge-<%= order.id %>">
                                            <%= order.status || 'Processing' %>
                                        </span>
                                </td>
                                <td>
                                    <%= new Date(order.created_at).toLocaleDateString('ar-EG', { year: 'numeric' ,
                                        month: 'long' , day: 'numeric' }) %>
                                </td>
                                <td>
                                    <form method="POST" action="/orders/<%= order.id %>/status">
                                        <select name="status" class="form-control"
                                            style="width: auto; padding: 0.3rem 0.5rem; font-size: 0.85rem;"
                                            onchange="this.form.submit()">
                                            <option value="Processing" <%=order.status==='Processing' ? 'selected' : ''
                                                %>>قيد المعالجة</option>
                                            <option value="Shipped" <%=order.status==='Shipped' ? 'selected' : '' %>>تم
                                                الشحن</option>
                                            <option value="In Transit" <%=order.status==='In Transit' ? 'selected' : ''
                                                %>>في الطريق</option>
                                            <option value="Delivered" <%=order.status==='Delivered' ? 'selected' : '' %>
                                                >تم التوصيل</option>
                                            <option value="Cancelled" <%=order.status==='Cancelled' ? 'selected' : '' %>
                                                >ملغي</option>
                                        </select>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
                <div class="text-center" style="padding: 3rem; color: var(--medium-gray);">
                    <i class="fas fa-shopping-cart" style="font-size: 4rem; margin-bottom: 1rem; opacity: 0.3;"></i>
                    <p style="font-size: 1.1rem;">لا توجد طلبات حتى الآن</p>
                </div>
                <% } %>
    </div>

    <script>
        function getSelectedIds() {
            return [...document.querySelectorAll('.order-checkbox:checked')].map(cb => cb.value);
        }

        function updateBulkBar() {
            const ids = getSelectedIds();
            const bar = document.getElementById('bulkBar');
            document.getElementById('selectedCount').textContent = ids.length + ' محدد';
            bar.style.display = ids.length > 0 ? 'flex' : 'none';
            document.getElementById('selectAll').indeterminate =
                ids.length > 0 && ids.length < document.querySelectorAll('.order-checkbox').length;
            document.getElementById('selectAll').checked =
                ids.length === document.querySelectorAll('.order-checkbox').length;
        }

        function toggleAll(cb) {
            document.querySelectorAll('.order-checkbox').forEach(c => c.checked = cb.checked);
            updateBulkBar();
        }

        function clearSelection() {
            document.querySelectorAll('.order-checkbox').forEach(c => c.checked = false);
            document.getElementById('selectAll').checked = false;
            updateBulkBar();
        }

        async function bulkChangeStatus() {
            const ids = getSelectedIds();
            const status = document.getElementById('bulkStatusSelect').value;
            if (!ids.length) return showToast('اختر طلبات أولاً', 'error');
            if (!status) return showToast('اختر حالة', 'error');

            try {
                const res = await fetch('/orders/bulk-status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ids, status })
                });
                const data = await res.json();
                if (data.success) {
                    showToast(`تم تحديث ${ids.length} طلب بنجاح`, 'success');
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    showToast(data.message || 'فشل التحديث', 'error');
                }
            } catch (e) {
                showToast('حدث خطأ', 'error');
            }
        }
    </script>

    <%- include('partials/footer') %>