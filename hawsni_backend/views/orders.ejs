<%- include('partials/header', { title: 'إدارة الطلبات' , pageTitle: 'الطلبات' , page: 'orders' }) %>

    <!-- Summary Stats -->
    <div class="stats-grid">
        <% const totalRevenue=orders.reduce((acc, o)=> acc + parseFloat(o.total || 0), 0);
            const pendingOrders = orders.filter(o => o.status === 'Processing').length;
            const completedOrders = orders.filter(o => o.status === 'Delivered').length;
            %>
            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon" style="background: var(--brand-light); color: var(--brand-primary);"><i class="fas fa-dollar-sign"></i></div>
                    <div class="stat-label">إجمالي المبيعات</div>
                </div>
                <div class="stat-value">
                    <%= totalRevenue.toLocaleString() %> ج.م
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon" style="background: var(--warning-bg); color: var(--warning);"><i class="fas fa-clock"></i></div>
                    <div class="stat-label">طلبات قيد المعالجة</div>
                </div>
                <div class="stat-value">
                    <%= pendingOrders %>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon" style="background: var(--success-bg); color: var(--success);"><i class="fas fa-check-circle"></i></div>
                    <div class="stat-label">طلبات مكتملة</div>
                </div>
                <div class="stat-value">
                    <%= completedOrders %>
                </div>
            </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h2 class="card-title">
                <i class="fas fa-list-ul"></i> قائمة الطلبات الحالية
            </h2>

            <div id="bulkBar" style="display:none; align-items: center; gap: 1rem;">
                <span id="selectedCount" class="badge badge-info" style="font-size: 0.9rem;">0 محدد</span>
                <div style="display: flex; gap: 0.5rem; align-items: center;">
                    <select id="bulkStatusSelect" class="form-control" style="width: auto; height: 38px;">
                        <option value="">-- تغيير الحالة --</option>
                        <option value="Processing">قيد المعالجة</option>
                        <option value="In Transit">مع شركة الشحن</option>
                        <option value="Delivered">تم التوصيل</option>
                        <option value="Cancelled">ملغي</option>
                    </select>
                    <button onclick="bulkChangeStatus()" class="btn btn-primary btn-sm">تطبيق</button>
                    <button onclick="bulkDelete()" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i> حذف
                        المحدد</button>
                    <button onclick="clearSelection()" class="btn btn-secondary btn-sm">إلغاء</button>
                </div>
            </div>
        </div>

        <% if (orders && orders.length> 0) { %>
            <div class="table-responsive">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th style="width:40px;">
                                <input type="checkbox" id="selectAll" onchange="toggleAll(this)">
                            </th>
                            <th>المنتج</th>
                            <th>العميل</th>
                            <th>رقم الطلب</th>
                            <th>المبلغ</th>
                            <th>الحالة</th>
                            <th>التاريخ</th>
                            <th style="width: 150px;">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% orders.forEach(order=> { %>
                            <% let cName='غير معروف' ; let cPhone='-' ; let cAddr='بدون عنوان' ; if (order.users) {
                                cName=order.users.name || cName; cPhone=order.users.phone || cPhone; } let
                                ship=order.shipping_address; if (typeof ship==='string' && ship.trim().startsWith('{'))
                                { try { ship=JSON.parse(ship); } catch (e) { } } if (typeof ship==='object' && ship
                                !==null) { cName=ship.name || ship.guestName || cName; cPhone=ship.phone ||
                                ship.guestPhone || cPhone; cAddr=ship.address || ship.shippingAddress || cAddr; } else
                                if (typeof ship==='string' && ship.trim() !=='' ) { cAddr=ship; } const
                                sMap={ 'Processing' : 'warning', 'In Transit' : 'info'
                                , 'Delivered' : 'success' , 'Cancelled' : 'danger' }; 
                                const sClass = sMap[order.status] || 'warning'; 
                                const tMap = { 
                                    'Processing' : 'قيد المعالجة', 
                                    'In Transit' : 'مع شركة الشحن', 
                                    'Delivered' : 'تم التوصيل', 
                                    'Cancelled' : 'ملغي' 
                                };
                                const displayStatus = tMap[order.status] || (order.status ? order.status : 'غير محدد'); %>
                                <tr id="row-<%= order.id %>" class="order-row"
                                    onclick="showOrderDetails('<%= order.id %>')">
                                    <td onclick="event.stopPropagation()">
                                        <input type="checkbox" class="order-checkbox" value="<%= order.id %>"
                                            onchange="updateBulkBar()">
                                    </td>
                                    <td>
                                        <div class="product-cell">
                                            <% if (order.product_image) { %>
                                                <img src="<%= order.product_image %>" class="product-img-lg">
                                                <% } else { %>
                                                    <div class="product-img-placeholder"><i class="fas fa-box"></i>
                                                    </div>
                                                    <% } %>
                                                        <div>
                                                            <div class="product-title">
                                                                <%= order.product_name %>
                                                            </div>
                                                            <% if (order.items_count> 1) { %>
                                                                <div class="product-count">+ <%= order.items_count - 1
                                                                        %> منتجات أخرى</div>
                                                                <% } %>
                                                        </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="customer-cell">
                                            <div class="avatar-small">
                                                <%= cName==='غير معروف' ? '?' : cName.charAt(0) %>
                                            </div>
                                            <div>
                                                <div class="customer-name">
                                                    <%= cName %>
                                                </div>
                                                <div class="customer-phone">
                                                    <%= cPhone %>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="order-id">#<%= order.id.substring(0, 8) %></span>
                                    </td>
                                    <td>
                                        <% 
                                            const total = parseFloat(order.total || 0);
                                            const displayTotal = isNaN(total) ? '0.00' : total.toFixed(2);
                                        %>
                                        <span class="order-amount">
                                            <%= displayTotal %> ج.م
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge badge-<%= sClass %>">
                                            <%= displayStatus %>
                                        </span>
                                    </td>
                                    <td>
                                        <div class="date-cell">
                                            <%= new Date(order.created_at).toLocaleDateString('ar-EG', { day: 'numeric'
                                                , month: 'short' }) %>
                                                <span>
                                                    <%= new Date(order.created_at).getFullYear() %>
                                                </span>
                                        </div>
                                    </td>
                                    <td onclick="event.stopPropagation()">
                                        <div class="action-cell">
                                            <form method="POST" action="/orders/<%= order.id %>/status">
                                                <select name="status" class="status-select select-<%= sClass %>"
                                                    onchange="this.form.submit()">
                                                    <% if (!['Processing', 'In Transit', 'Delivered', 'Cancelled'].includes(order.status)) { %>
                                                        <option value="" selected disabled>-- اختيار الحالة --</option>
                                                    <% } %>
                                                    <option value="Processing" <%=order.status==='Processing'
                                                        ? 'selected' : '' %>>قيد المعالجة</option>
                                                    <option value="In Transit" <%=order.status==='In Transit'
                                                        ? 'selected' : '' %>>مع شركة الشحن</option>
                                                    <option value="Delivered" <%=order.status==='Delivered' ? 'selected'
                                                        : '' %>>تم التوصيل</option>
                                                    <option value="Cancelled" <%=order.status==='Cancelled' ? 'selected'
                                                        : '' %>>ملغي</option>
                                                </select>
                                            </form>
                                            <button class="btn-icon text-danger"
                                                onclick="deleteOrder('<%= order.id %>')" title="حذف الطلب">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                            <button class="btn-icon" onclick="showOrderDetails('<%= order.id %>')">
                                                <i class="fas fa-chevron-left"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-shopping-cart"></i>
                    <p>لا توجد طلبات حتى الآن</p>
                </div>
                <% } %>
    </div>

    <!-- Order Details Modal -->
    <div id="orderModal" class="modal" onclick="closeModal(event)">
        <div class="modal-content" onclick="event.stopPropagation()">
            <div class="modal-header">
                <div class="header-main">
                    <div class="header-id-group">
                        <span class="header-badge">تفاصيل الطلب</span>
                        <h3 id="modalOrderId" class="modal-title"></h3>
                    </div>
                    <p id="modalOrderDate" class="modal-subtitle"></p>
                </div>
                <div class="header-actions">
                    <select id="modalStatusSelect" class="status-select" onchange="changeModalStatus(this.value)" style="margin-left: 10px;">
                        <option value="Processing">قيد المعالجة</option>
                        <option value="In Transit">مع شركة الشحن</option>
                        <option value="Delivered">تم التوصيل</option>
                        <option value="Cancelled">ملغي</option>
                    </select>
                    <div id="modalStatusBadge" class="badge"></div>
                    <button class="modal-close" onclick="closeModal()"><i class="fas fa-times"></i></button>
                </div>
            </div>

            <div class="modal-body">
                <div class="modal-grid">
                    <!-- Left Column: Products & Payment -->
                    <div class="column-main">
                        <div class="detail-section">
                            <h4 class="section-title"><i class="fas fa-shopping-bag"></i> منتجات الطلب</h4>
                            <div id="modalItemsList" class="items-container">
                                <!-- Populated by JS -->
                            </div>
                        </div>

                        <div class="detail-section payment-summary">
                            <h4 class="section-title"><i class="fas fa-receipt"></i> ملخص الدفع</h4>
                            <div class="payment-grid">
                                <div class="payment-item">
                                    <span>المجموع الفرعي:</span>
                                    <span id="modalSubtotal"></span>
                                </div>
                                <div id="discountRow" class="payment-item discount">
                                    <span>الخصم (كوبون):</span>
                                    <span id="modalDiscount"></span>
                                </div>
                                <div class="payment-item total">
                                    <span>الإجمالي:</span>
                                    <span id="modalTotalAmount"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Customer & Shipping -->
                    <div class="column-side">
                        <div class="detail-section customer-info">
                            <h4 class="section-title"><i class="fas fa-user"></i> بيانات العميل</h4>
                            <div class="profile-card">
                                <div id="modalAvatar" class="profile-avatar"></div>
                                <div class="profile-details">
                                    <h5 id="modalCustomerName"></h5>
                                    <p id="modalCustomerPhone" style="direction: ltr; text-align: right; margin-bottom: 2px;"></p>
                                    <p id="modalCustomerPhone2" style="direction: ltr; text-align: right; font-size: 0.8rem; color: #64748b; margin-bottom: 8px; display: none;"></p>
                                    <p id="modalCustomerEmail" class="email-text"></p>
                                </div>
                            </div>
                        </div>

                        <div class="detail-section shipping-info">
                            <h4 class="section-title"><i class="fas fa-map-marked-alt"></i> تفاصيل الشحن</h4>
                            <div class="address-card">
                                <div class="address-item">
                                    <label>المحافظة:</label>
                                    <p id="shipState"></p>
                                </div>
                                <div class="address-item">
                                    <label>المدينة:</label>
                                    <p id="shipCity"></p>
                                </div>
                                <div class="address-item">
                                    <label>العنوان:</label>
                                    <p id="shipStreet"></p>
                                </div>
                                <div class="address-full">
                                    <label>العنوان بالكامل:</label>
                                    <p id="modalAddressFull"></p>
                                </div>
                                <button class="btn-copy-address" onclick="copyAddress()">
                                    <i class="fas fa-copy"></i> نسخ العنوان الكامل
                                </button>
                            </div>
                        </div>

                        <div id="modalNotesSection" class="detail-section" style="display: none;">
                            <h4 class="section-title"><i class="fas fa-sticky-note"></i> ملاحظات الطلب</h4>
                            <div class="address-card" style="border-color: #f59e0b; background: #fffcf0; padding: 15px;">
                                <p id="modalNotesText" style="margin: 0; font-weight: 700; color: #92400e; line-height: 1.6; font-size: 0.9rem;"></p>
                            </div>
                        </div>

                        <div class="detail-section">
                            <h4 class="section-title"><i class="fas fa-credit-card"></i> طريقة الدفع</h4>
                            <div class="method-card">
                                <i class="fas fa-money-bill-wave"></i>
                                <span id="modalPaymentMethod">الدفع عند الاستلام</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- No Answer Email Action -->
            <div style="padding: 16px 30px 24px; border-top: 1px solid #f0f0f0; background: #fafafa;">
                <button id="noAnswerBtn" onclick="sendNoAnswerEmail()"
                    style="display: flex; align-items: center; gap: 8px; background: #fff; border: 1.5px solid #f59e0b; color: #92400e; padding: 10px 20px; border-radius: 12px; font-size: 13px; font-weight: 800; cursor: pointer; transition: all 0.2s; font-family: inherit;">
                    <span>📞</span>
                    <span>إرسال تنبيه "لم يرد"</span>
                </button>
            </div>

            <!-- Custom AI Email Box -->
            <div style="padding: 16px 30px 24px; border-top: 1px solid #f0f0f0; background: #fafafa;">
                <h4 style="margin: 0 0 10px 0; font-size: 14px; color: #1e293b;"><i class="fas fa-robot" style="color:#6366f1;"></i> إنشاء إيميل مخصص بالذكاء الاصطناعي</h4>
                <div style="display: flex; gap: 10px; margin-bottom: 12px;">
                    <input type="text" id="aiEmailPrompt" placeholder="مثال: اعتذر للعميل وبلغه أن المنتج نفذ وسنقوم برد المبلغ..." style="flex: 1; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-family: inherit; font-size: 13px; outline: none;">
                    <button id="generateAiBtn" onclick="generateAiEmail()" style="display: flex; align-items: center; justify-content: center; background: #6366f1; color: white; border: none; padding: 0 20px; border-radius: 8px; font-weight: bold; cursor: pointer; transition: 0.2s; font-family: inherit;">
                        ✨ توليد
                    </button>
                </div>
                
                <div id="aiPreviewBox" style="display: none; background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; margin-bottom: 12px; max-height: 200px; overflow-y: auto;">
                    <div id="aiEmailContent" style="font-size: 13px; color: #334155; line-height: 1.6;"></div>
                </div>
                
                <button id="sendAiEmailBtn" onclick="sendAiEmail()" style="display: none; width: 100%; justify-content: center; align-items: center; gap: 8px; background: #0ea5e9; color: white; border: none; padding: 10px; border-radius: 8px; font-weight: bold; cursor: pointer; transition: 0.2s; font-family: inherit;">
                    <i class="fas fa-paper-plane"></i> إرسال هذا الإيميل للعميل
                </button>
            </div>

            <!-- Bosta Integration Box -->
            <div style="padding: 16px 30px 24px; border-top: 1px solid #f0f0f0; background: #fafafa;">
                <h4 style="margin: 0 0 10px 0; font-size: 14px; color: #1e293b;"><i class="fas fa-truck" style="color:#e11d48;"></i> الشحن عبر بوسطة</h4>
                
                <div id="bostaNotSentBox" style="display: block;">
                    <p style="font-size:13px; color:#64748b; margin-top:0;">إرسال تفاصيل هذا الطلب مباشرة إلى بوسطة لإنشاء بوليصة شحن.</p>
                    <button id="sendBostaBtn" onclick="sendToBosta()" style="display: flex; align-items: center; justify-content: center; gap: 8px; background: #e11d48; color: white; border: none; padding: 10px 20px; border-radius: 8px; font-weight: bold; cursor: pointer; transition: 0.2s; font-family: inherit; width: 100%;">
                        <i class="fas fa-box-open"></i> إرسال الطلب إلى بوسطة
                    </button>
                </div>

                <div id="bostaSentBox" style="display: none; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; padding: 16px;">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
                        <span style="font-size: 13px; font-weight: bold; color: #1e3a8a;"><i class="fas fa-check-circle" style="color: #2563eb;"></i> تم إرسال الشحنة</span>
                        <span style="font-size: 12px; background: #dbeafe; color: #1e40af; padding: 3px 8px; border-radius: 4px;" id="bostaTrackingNumber"></span>
                    </div>
                    <a id="bostaTrackingLink" href="#" target="_blank" style="display: flex; align-items: center; justify-content: center; gap: 8px; background: white; color: #2563eb; border: 1px solid #93c5fd; padding: 8px 16px; border-radius: 6px; font-size: 13px; font-weight: bold; text-decoration: none; transition: 0.2s; width: 100%;">
                        <i class="fas fa-map-marker-alt"></i> تتبع الشحنة
                    </a>
                </div>
            </div>
        </div>
    </div>
    <script id="orders-data" type="application/json">
        <%- JSON.stringify(orders) %>
    </script>
    <script>
        const ordersData = JSON.parse(document.getElementById('orders-data').textContent || '[]');
        const sMap = {
            'Processing': 'warning',
            'In Transit': 'info',
            'Delivered': 'success',
            'Cancelled': 'danger'
        };
        const tMap = {
            'Processing': 'قيد المعالجة',
            'In Transit': 'مع شركة الشحن',
            'Delivered': 'تم التوصيل',
            'Cancelled': 'ملغي'
        };

        let currentOrderId = null;
        function showOrderDetails(orderId) {
            currentOrderId = orderId;
            const order = ordersData.find(o => o.id === orderId);
            if (!order) return;

            // Reset No Answer Button state
            const noAnswerBtn = document.getElementById('noAnswerBtn');
            if (noAnswerBtn) {
                noAnswerBtn.innerHTML = '<span>📞</span><span>إرسال تنبيه "لم يرد"</span>';
                noAnswerBtn.disabled = false;
                noAnswerBtn.style.borderColor = '#f59e0b';
                noAnswerBtn.style.color = '#92400e';
            }

            // Reset AI Box state
            document.getElementById('aiEmailPrompt').value = '';
            document.getElementById('aiPreviewBox').style.display = 'none';
            document.getElementById('aiEmailContent').innerHTML = '';
            document.getElementById('sendAiEmailBtn').style.display = 'none';

            // Check Bosta state
            if (order.bosta_id || order.tracking_number) {
                document.getElementById('bostaNotSentBox').style.display = 'none';
                document.getElementById('bostaSentBox').style.display = 'block';
                document.getElementById('bostaTrackingNumber').textContent = 'رقم التتبع: ' + order.tracking_number;
                document.getElementById('bostaTrackingLink').href = 'https://t.bosta.co/' + order.tracking_number;
            } else {
                document.getElementById('bostaNotSentBox').style.display = 'block';
                document.getElementById('bostaSentBox').style.display = 'none';
                document.getElementById('sendBostaBtn').disabled = false;
                document.getElementById('sendBostaBtn').innerHTML = '<i class="fas fa-box-open"></i> إرسال الطلب إلى بوسطة';
            }

            // Update Header & Badge
            document.getElementById('modalOrderId').textContent = 'طلب رقم #' + order.id.substring(0, 8);
            document.getElementById('modalOrderDate').textContent = new Date(order.created_at).toLocaleString('ar-EG', {
                weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit'
            });

            const statusBadge = document.getElementById('modalStatusBadge');
            const statusText = tMap[order.status] || order.status || 'قيد المعالجة';
            statusBadge.textContent = statusText;
            statusBadge.className = 'badge badge-' + (sMap[order.status] || 'warning');

            const statusSelect = document.getElementById('modalStatusSelect');
            if (statusSelect) {
                statusSelect.value = order.status || 'Processing';
                statusSelect.className = 'status-select select-' + (sMap[order.status] || 'warning');
            }

            // Customer Details logic
            let cName = 'غير معروف';
            let cPhone = '-';
            let cEmail = 'لا يوجد إيميل';
            let ship = order.shipping_address;

            // Try to extract from linked user first
            if (order.users) {
                cName = order.users.name || cName;
                cPhone = order.users.phone || cPhone;
            }

            // Override with structured shipping address if available
            if (ship && typeof ship === 'object') {
                cName = ship.name || ship.guestName || cName;
                cPhone = ship.phone || ship.guestPhone || cPhone;
                cEmail = ship.email || ship.guestEmail || cEmail;

                document.getElementById('shipState').textContent = ship.state || '-';
                document.getElementById('shipCity').textContent = ship.city || '-';
                document.getElementById('shipStreet').textContent = ship.street || ship.address || '-';
                document.getElementById('modalAddressFull').textContent = ship.address || '-';
            } else {
                document.getElementById('shipState').textContent = '-';
                document.getElementById('shipCity').textContent = '-';
                document.getElementById('shipStreet').textContent = '-';
                document.getElementById('modalAddressFull').textContent = ship || 'لا يوجد عنوان';
            }

            document.getElementById('modalCustomerName').textContent = cName;
            document.getElementById('modalCustomerPhone').textContent = cPhone;
            
            const phone2Elem = document.getElementById('modalCustomerPhone2');
            if (ship && ship.alternative_phone) {
                phone2Elem.textContent = 'هاتف بديل: ' + ship.alternative_phone;
                phone2Elem.style.display = 'block';
            } else {
                phone2Elem.style.display = 'none';
            }

            document.getElementById('modalCustomerEmail').textContent = cEmail;
            document.getElementById('modalAvatar').textContent = cName === 'غير معروف' ? '?' : cName.charAt(0).toUpperCase();
            document.getElementById('modalPaymentMethod').textContent = order.payment_method || 'Cash on Delivery';
            
            // Handle Order Notes
            const notesSection = document.getElementById('modalNotesSection');
            const notesText = document.getElementById('modalNotesText');
            if (order.notes && order.notes.trim() !== '') {
                notesText.textContent = order.notes;
                notesSection.style.display = 'block';
            } else {
                notesSection.style.display = 'none';
            }

            // Items List Overhaul
            const itemsList = document.getElementById('modalItemsList');
            itemsList.innerHTML = '';

            (order.order_items || order.items || []).forEach(item => {
                const p = item.products || {};
                let img = item.image_url || ((p.images && p.images.length > 0) ? p.images[0] : '/placeholder.png');

                // Final safety: if the stored URL is a placeholder, try product gallery again
                if (img.includes('placeholder.png') && p.images && p.images.length > 0) {
                    img = p.images[0];
                }

                const itemDiv = document.createElement('div');
                itemDiv.className = 'premium-item-row';
                itemDiv.innerHTML = `
                    <div class="item-visual">
                        <img src="${img}" onerror="this.onerror=null; this.src='/placeholder.png';" class="item-img-detailed">
                    </div>
                    <div class="item-info">
                        <div class="item-name-row">
                            <span class="item-main-name">${p.name || item.name || 'منتج غير معروف'}</span>
                            <span class="item-qty">x${item.quantity}</span>
                        </div>
                        <div class="item-specs">
                            ${item.size ? `<span class="spec-tag">المقاس: ${item.size}</span>` : ''}
                            ${item.color ? `<span class="spec-tag">اللون: ${item.color}</span>` : ''}
                        </div>
                    </div>
                    <div class="item-price-col">
                        <div class="unit-price">${parseFloat(item.price).toFixed(2)} ج.م</div>
                        <div class="total-line">${(item.quantity * item.price).toFixed(2)} ج.م</div>
                    </div>
                `;
                itemsList.appendChild(itemDiv);
            });

            // Financials
            const subtotal = (order.items || []).reduce((acc, item) => acc + (item.price * item.quantity), 0);
            document.getElementById('modalSubtotal').textContent = subtotal.toFixed(2) + ' ج.م';

            const discount = order.discount || 0;
            if (discount > 0) {
                document.getElementById('discountRow').style.display = 'flex';
                document.getElementById('modalDiscount').textContent = '-' + parseFloat(discount).toFixed(2) + ' ج.م';
            } else {
                document.getElementById('discountRow').style.display = 'none';
            }

            const totalAmount = parseFloat(order.total || 0);
            document.getElementById('modalTotalAmount').textContent = (isNaN(totalAmount) ? '0.00' : totalAmount.toFixed(2)) + ' ج.م';

            document.getElementById('orderModal').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        async function changeModalStatus(newStatus) {
            if (!currentOrderId) return;
            const statusSelect = document.getElementById('modalStatusSelect');
            const statusBadge = document.getElementById('modalStatusBadge');
            const originalStatus = statusSelect.value;
            
            // Show loading state
            statusSelect.disabled = true;
            statusBadge.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري التحديث...';
            
            try {
                const res = await fetch(`/orders/${currentOrderId}/status`, {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ status: newStatus })
                });
                
                const data = await res.json();
                
                if (data.success) {
                    // Update order in ordersData local cache
                    const orderIdx = ordersData.findIndex(o => o.id === currentOrderId);
                    if (orderIdx > -1) ordersData[orderIdx].status = newStatus;
                    
                    // Update Modal UI
                    statusBadge.textContent = tMap[newStatus] || newStatus;
                    statusBadge.className = 'badge badge-' + (sMap[newStatus] || 'warning');
                    statusSelect.className = 'status-select select-' + (sMap[newStatus] || 'warning');
                    
                    // Optional: update the row in the main table behind the modal
                    const row = document.getElementById(`row-${currentOrderId}`);
                    if (row) {
                        const rowBadge = row.querySelector('.badge');
                        if (rowBadge) {
                            rowBadge.textContent = tMap[newStatus] || newStatus;
                            rowBadge.className = 'badge badge-' + (sMap[newStatus] || 'warning');
                        }
                        const rowSelect = row.querySelector('.status-select');
                        if (rowSelect) {
                            rowSelect.value = newStatus;
                            rowSelect.className = 'status-select select-' + (sMap[newStatus] || 'warning');
                        }
                    }
                } else {
                    alert('خطأ: ' + (data.message || 'فشل التحديث'));
                    statusSelect.value = originalStatus;
                }
            } catch (err) {
                console.error('Update status error:', err);
                alert('حدث خطأ في الاتصال');
                statusSelect.value = originalStatus;
            } finally {
                statusSelect.disabled = false;
            }
        }

        function closeModal(event) {
            // If an event is passed and the clicked target isn't the backdrop, ignore it.
            if (event && event.target.id !== 'orderModal') {
                return;
            }
            document.getElementById('orderModal').classList.remove('active');
            document.body.style.overflow = '';
        }

        function copyAddress() {
            const addr = document.getElementById('modalAddressFull').textContent;
            navigator.clipboard.writeText(addr);
            alert('تم نسخ العنوان بنجاح');
        }

        // Bulk Actions
        function getSelectedIds() {
            return [...document.querySelectorAll('.order-checkbox:checked')].map(cb => cb.value);
        }

        function updateBulkBar() {
            const ids = getSelectedIds();
            const bar = document.getElementById('bulkBar');
            document.getElementById('selectedCount').textContent = ids.length + ' محدد';
            bar.style.display = ids.length > 0 ? 'flex' : 'none';
        }

        function toggleAll(cb) {
            document.querySelectorAll('.order-checkbox').forEach(c => c.checked = cb.checked);
            updateBulkBar();
        }

        async function bulkChangeStatus() {
            const ids = getSelectedIds();
            const status = document.getElementById('bulkStatusSelect').value;
            if (!ids.length || !status) return;

            try {
                const res = await fetch('/orders/bulk-status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ids, status })
                });
                const data = await res.json();
                if (data.success) {
                    window.location.reload();
                }
            } catch (e) { }
        }

        async function bulkDelete() {
            const ids = getSelectedIds();
            if (!ids.length) {
                alert('الرجاء تحديد طلب واحد على الأقل للحذف.');
                return;
            }

            showConfirm(`تحذير: هل أنت متأكد من حذف ${ids.length} طلب نهائياً؟ لا يمكن التراجع عن هذه الخطوة.`, async () => {
                const deleteBtn = document.querySelector('button[onclick="bulkDelete()"]');
                if (deleteBtn) { deleteBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الحذف...'; deleteBtn.disabled = true; }

                try {
                    const res = await fetch('/orders/bulk-delete', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ ids })
                    });
                    const data = await res.json();
                    if (data.success) {
                        alert('تم الحذف بنجاح');
                        setTimeout(() => window.location.reload(), 200);
                    } else {
                        alert('خطأ من الخادم: ' + (data.message || 'غير معروف'));
                        if (deleteBtn) { deleteBtn.innerHTML = '<i class="fas fa-trash"></i> حذف'; deleteBtn.disabled = false; }
                    }
                } catch (e) {
                    console.error('Fetch error:', e);
                    alert('حدث خطأ في الاتصال أثناء الحذف');
                    if (deleteBtn) { deleteBtn.innerHTML = '<i class="fas fa-trash"></i> حذف'; deleteBtn.disabled = false; }
                }
            });
        }

        async function deleteOrder(orderId) {
            console.log('Attempting delete for:', orderId);
            showConfirm('هل أنت متأكد من حذف هذا الطلب نهائياً؟', async () => {
                // Find the delete button in the row to show loading state
                const row = document.getElementById(`row-${orderId}`);
                const deleteBtn = row ? row.querySelector('.btn-icon.text-danger') : null;
                const originalIcon = deleteBtn ? deleteBtn.innerHTML : '';

                if (deleteBtn) {
                    deleteBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                    deleteBtn.disabled = true;
                }

                try {
                    const res = await fetch(`/orders/${orderId}/delete`, {
                        method: 'POST',
                        headers: { 'Accept': 'application/json' }
                    });

                    console.log(`Frontend: Delete response status: ${res.status}`);

                    if (!res.ok) {
                        const text = await res.text();
                        console.error(`Frontend: Delete failed with status ${res.status}. Response:`, text);
                        alert(`فشل الحذف (Status ${res.status}): يرجى التأكد من صلاحياتك.`);
                        if (deleteBtn) {
                            deleteBtn.innerHTML = originalIcon;
                            deleteBtn.disabled = false;
                        }
                        return;
                    }

                    const data = await res.json();
                    console.log('Frontend: Delete response data:', data);

                    if (data.success) {
                        alert('تم حذف الطلب بنجاح');
                        if (row) row.style.opacity = '0.5';
                        setTimeout(() => window.location.reload(), 300);
                    } else {
                        alert('فشل الحذف: ' + (data.message || 'خطأ غير معروف'));
                        if (deleteBtn) {
                            deleteBtn.innerHTML = originalIcon;
                            deleteBtn.disabled = false;
                        }
                    }
                } catch (err) {
                    console.error('Frontend: Critical error during deleteOrder:', err);
                    alert('حدث خطأ فني أثناء الحذف. راجع الكونسول لمزيد من التفاصيل.');
                    if (deleteBtn) {
                        deleteBtn.innerHTML = originalIcon;
                        deleteBtn.disabled = false;
                    }
                }
            });
        }

        // Close modal on Escape key
        document.addEventListener('keydown', function(event) {
            if (event.key === "Escape") {
                closeModal();
            }
        });

        async function sendNoAnswerEmail() {
            if (!currentOrderId) return;
            const btn = document.getElementById('noAnswerBtn');
            const orig = btn.innerHTML;
            btn.innerHTML = '<span>⏳</span><span>جاري الإرسال...</span>';
            btn.disabled = true;
            try {
                const res = await fetch(`/orders/${currentOrderId}/no-answer`, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    btn.innerHTML = '<span>✅</span><span>تم الإرسال!</span>';
                    btn.style.borderColor = '#16a34a';
                    btn.style.color = '#15803d';
                } else {
                    alert('خطأ: ' + data.message);
                    btn.innerHTML = orig;
                    btn.disabled = false;
                }
            } catch (e) {
                alert('حدث خطأ في الاتصال');
                btn.innerHTML = orig;
                btn.disabled = false;
            }
        }

        let currentGeneratedHtml = '';

        async function generateAiEmail() {
            if (!currentOrderId) return;
            const promptInput = document.getElementById('aiEmailPrompt');
            const prompt = promptInput.value.trim();
            if(!prompt) {
                alert('الرجاء كتابة الفكرة أولاً');
                return;
            }

            const btn = document.getElementById('generateAiBtn');
            const origHTML = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            btn.disabled = true;

            try {
                const res = await fetch(`/orders/${currentOrderId}/generate-ai-email`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ prompt })
                });

                const data = await res.json();
                if (data.success) {
                    currentGeneratedHtml = data.generatedHtml;
                    const emailPreviewTemplate = `
                        <div dir="rtl" style="font-family: 'Segoe UI', Tahoma, sans-serif; max-width: 100%; margin: 0 auto; background: #ffffff; border-radius: 12px; overflow: hidden; border: 1px solid #e8e8e8; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
                            <!-- Header -->
                            <div style="background: linear-gradient(135deg, #0E4435 0%, #1a6b54 100%); padding: 20px; text-align: center;">
                                <h1 style="color: #ffffff; margin: 0; font-size: 18px; font-weight: 900;">Hawsni</h1>
                                <p style="color: rgba(255,255,255,0.6); margin: 5px 0 0 0; font-size: 11px; font-weight: 600;">الفخامة في كل تفصيلة</p>
                            </div>
                            <!-- AI Body Content -->
                            <div style="padding: 24px 20px; font-size: 13px; color: #334155; line-height: 1.6;">
                                <p style="font-size: 11px; color: #94a3b8; margin-bottom: 12px;">إلى: عميل المتجر</p>
                                ${currentGeneratedHtml}
                            </div>
                            <!-- Footer -->
                            <div style="background: #f5f5f5; padding: 15px; text-align: center; border-top: 1px solid #eee;">
                                <p style="color: #0E4435; font-size: 11px; font-weight: 900; margin: 0;">Hawsni — Premium Fashion ✨</p>
                            </div>
                        </div>
                    `;
                    document.getElementById('aiEmailContent').innerHTML = emailPreviewTemplate;
                    // remove visual max height and padding from parent container as preview is self-contained
                    document.getElementById('aiPreviewBox').style.padding = '0';
                    document.getElementById('aiPreviewBox').style.background = 'transparent';
                    document.getElementById('aiPreviewBox').style.border = 'none';
                    document.getElementById('aiPreviewBox').style.display = 'block';
                    document.getElementById('sendAiEmailBtn').style.display = 'flex';
                } else {
                    alert('خطأ: ' + data.message);
                }
            } catch (err) {
                alert('حدث خطأ أثناء التوليد');
            } finally {
                btn.innerHTML = origHTML;
                btn.disabled = false;
            }
        }

        async function sendAiEmail() {
            if (!currentOrderId || !currentGeneratedHtml) return;
            
            const btn = document.getElementById('sendAiEmailBtn');
            const origHTML = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الإرسال...';
            btn.disabled = true;

            try {
                const res = await fetch(`/orders/${currentOrderId}/send-ai-email`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ htmlContent: currentGeneratedHtml })
                });

                const data = await res.json();
                if (data.success) {
                    btn.innerHTML = '<i class="fas fa-check"></i> تم الإرسال بنجاح!';
                    btn.style.background = '#16a34a';
                    setTimeout(() => {
                        document.getElementById('aiPreviewBox').style.display = 'none';
                        document.getElementById('aiEmailPrompt').value = '';
                        btn.style.display = 'none';
                        btn.style.background = '#0ea5e9';
                        btn.innerHTML = origHTML;
                    }, 3000);
                } else {
                    alert('خطأ: ' + data.message);
                    btn.innerHTML = origHTML;
                    btn.disabled = false;
                }
            } catch (err) {
                alert('حدث خطأ في الإرسال');
                btn.innerHTML = origHTML;
                btn.disabled = false;
            }
        }

        async function sendToBosta() {
            if (!currentOrderId) return;
            const btn = document.getElementById('sendBostaBtn');
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري إرسال الطلب...';
            btn.disabled = true;

            try {
                const res = await fetch(`/orders/${currentOrderId}/bosta-ship`, {
                    method: 'POST'
                });
                const data = await res.json();
                
                if (data.success) {
                    // Update Local Data Cache
                    const orderIdx = ordersData.findIndex(o => o.id === currentOrderId);
                    if (orderIdx > -1) {
                        ordersData[orderIdx].tracking_number = data.trackingNumber;
                    }
                    
                    // Update Modal UI successfully
                    document.getElementById('bostaNotSentBox').style.display = 'none';
                    document.getElementById('bostaSentBox').style.display = 'block';
                    document.getElementById('bostaTrackingNumber').textContent = 'رقم التتبع: ' + data.trackingNumber;
                    document.getElementById('bostaTrackingLink').href = 'https://t.bosta.co/' + data.trackingNumber;
                    
                    alert('تم إنشاء الشحنة في بوسطة بنجاح!');
                } else {
                    alert('خطأ: ' + data.message);
                    btn.innerHTML = '<i class="fas fa-box-open"></i> إرسال الطلب إلى بوسطة';
                    btn.disabled = false;
                }
            } catch (err) {
                console.error(err);
                alert('حدث خطأ أثناء إرسال الطلب لبوسطة');
                btn.innerHTML = '<i class="fas fa-box-open"></i> إرسال الطلب إلى بوسطة';
                btn.disabled = false;
            }
        }
    </script>

