<%- include('partials/header', { title: 'إدارة الطلبات' , pageTitle: 'الطلبات' , page: 'orders' }) %>

    <div class="card">
        <div class="card-header">
            <h2 class="card-title">
                <i class="fas fa-shopping-cart"></i> جميع الطلبات
            </h2>
        </div>

        <% if (orders && orders.length> 0) { %>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>المنتج</th>
                            <th>رقم الطلب</th>
                            <th>المبلغ</th>
                            <th>الحالة</th>
                            <th>التاريخ</th>
                            <th>تغيير الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% orders.forEach(order=> { %>
                            <tr>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                                        <% if (order.product_image) { %>
                                            <img src="<%= order.product_image %>" alt="<%= order.product_name %>"
                                                style="width: 60px; height: 60px; border-radius: var(--radius-md); object-fit: cover; border: 2px solid var(--light-gray);">
                                            <% } else { %>
                                                <div
                                                    style="width: 60px; height: 60px; border-radius: var(--radius-md); background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary-color) 100%); display: flex; align-items: center; justify-content: center;">
                                                    <i class="fas fa-shopping-bag"
                                                        style="color: var(--dark); opacity: 0.3; font-size: 1.5rem;"></i>
                                                </div>
                                                <% } %>
                                                    <div>
                                                        <div style="font-weight: 600; color: var(--dark-gray);">
                                                            <%= order.product_name %>
                                                        </div>
                                                        <% if (order.items_count> 1) { %>
                                                            <small style="color: var(--medium-gray);">
                                                                + <%= order.items_count - 1 %> منتجات أخرى
                                                            </small>
                                                            <% } %>
                                                    </div>
                                    </div>
                                </td>
                                <td>
                                    <span style="font-weight: 600; color: var(--dark-gray);">
                                        #<%= order.id.substring(0, 8) %>
                                    </span>
                                </td>
                                <td>
                                    <span style="font-weight: 700; color: var(--success); font-size: 1.1rem;">
                                        <%= parseFloat(order.total).toFixed(2) %> ج.م
                                    </span>
                                </td>
                                <td>
                                    <% const statusMap={ 'Processing' : 'warning' , 'Shipped' : 'info' , 'In Transit'
                                        : 'info' , 'Delivered' : 'success' , 'Cancelled' : 'danger' }; const
                                        statusClass=statusMap[order.status] || 'warning' ; %>
                                        <span class="badge badge-<%= statusClass %>">
                                            <%= order.status || 'Processing' %>
                                        </span>
                                </td>
                                <td>
                                    <%= new Date(order.created_at).toLocaleDateString('ar-EG', { year: 'numeric' ,
                                        month: 'long' , day: 'numeric' }) %>
                                </td>
                                <td>
                                    <form method="POST" action="/orders/<%= order.id %>/status">
                                        <select name="status" class="form-control"
                                            style="width: auto; padding: 0.3rem 0.5rem; font-size: 0.85rem;"
                                            onchange="this.form.submit()">
                                            <option value="Processing" <%=order.status==='Processing' ? 'selected' : ''
                                                %>>قيد المعالجة</option>
                                            <option value="Shipped" <%=order.status==='Shipped' ? 'selected' : '' %>>تم
                                                الشحن</option>
                                            <option value="In Transit" <%=order.status==='In Transit' ? 'selected' : ''
                                                %>>في الطريق</option>
                                            <option value="Delivered" <%=order.status==='Delivered' ? 'selected' : '' %>
                                                >تم التوصيل</option>
                                            <option value="Cancelled" <%=order.status==='Cancelled' ? 'selected' : '' %>
                                                >ملغي</option>
                                        </select>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
                <div class="text-center" style="padding: 3rem; color: var(--medium-gray);">
                    <i class="fas fa-shopping-cart" style="font-size: 4rem; margin-bottom: 1rem; opacity: 0.3;"></i>
                    <p style="font-size: 1.1rem;">لا توجد طلبات حتى الآن</p>
                </div>
                <% } %>
    </div>

    <%- include('partials/footer') %>