<style>
    :root {
        --chat-sidebar-width: 350px;
        --chat-primary: #0E4435;
        --chat-bg: #f0f2f5;
        --chat-header-bg: #f8fafc;
        --chat-bubble-user: #0E4435;
        --chat-bubble-admin: #ffffff;
        --chat-text-main: #1e293b;
        --chat-text-muted: #64748b;
    }

    .admin-layout { height: 100vh; overflow: hidden; }
    .content-wrapper { padding: 0 !important; height: calc(100vh - 70px); }
    .main-content { padding: 0 !important; height: 100%; }

    .chat-master-container {
        display: flex;
        height: 100%;
        background: #fff;
        overflow: hidden;
    }

    /* Sidebar Styles */
    .chat-sidebar {
        width: var(--chat-sidebar-width);
        border-left: 1px solid #e2e8f0;
        display: flex;
        flex-direction: column;
        background: #ffffff;
        z-index: 10;
    }

    .sidebar-search-area {
        padding: 16px;
        border-bottom: 1px solid #f1f5f9;
    }

    .filter-group {
        display: flex;
        gap: 6px;
        padding: 0 16px 16px;
        overflow-x: auto;
    }

    .filter-chip {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        border: 1px solid #e2e8f0;
        background: #fff;
        color: var(--chat-text-muted);
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .filter-chip.active {
        background: var(--chat-primary);
        color: #fff;
        border-color: var(--chat-primary);
    }

    .sessions-scroll {
        flex: 1;
        overflow-y: auto;
    }

    .session-item {
        padding: 16px;
        border-bottom: 1px solid #f8fafc;
        cursor: pointer;
        transition: background 0.2s;
        position: relative;
    }

    .session-item:hover { background: #f8fafc; }
    .session-item.active { background: #f0fdf4; border-right: 4px solid var(--chat-primary); }

    .session-item .unread-dot {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        width: 10px;
        height: 10px;
        background: #ef4444;
        border-radius: 50%;
    }

    /* Chat Content Area */
    .chat-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: var(--chat-bg);
        position: relative;
    }

    .chat-view-header {
        height: 70px;
        background: #ffffff;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        padding: 0 24px;
        justify-content: space-between;
    }

    .messages-viewport {
        flex: 1;
        overflow-y: auto;
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        background-image: url('https://user-images.githubusercontent.com/15075759/28719144-86dc0f70-73b1-11e7-911d-60d70fcded21.png');
        background-blend-mode: overlay;
    }

    /* Bubbles */
    .msg-row { display: flex; width: 100%; margin-bottom: 4px; }
    .msg-row.sent { justify-content: flex-start; }
    .msg-row.received { justify-content: flex-end; }

    .bubble {
        max-width: 70%;
        padding: 10px 14px;
        font-size: 14px;
        line-height: 1.5;
        position: relative;
        box-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }

    .received .bubble {
        background: var(--chat-primary);
        color: #fff;
        border-radius: 12px 12px 2px 12px;
    }

    .sent .bubble {
        background: #fff;
        color: var(--chat-text-main);
        border-radius: 12px 12px 12px 2px;
    }

    .msg-time {
        font-size: 10px;
        margin-top: 4px;
        opacity: 0.7;
        text-align: left;
    }

    /* Input Area */
    .chat-footer {
        padding: 16px 24px;
        background: #f0f2f5;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .input-wrapper {
        flex: 1;
        background: #fff;
        border-radius: 24px;
        padding: 0 16px;
        display: flex;
        align-items: center;
    }

    .chat-input-field {
        flex: 1;
        border: none;
        padding: 12px 0;
        outline: none;
        font-size: 14px;
    }

    .send-btn {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: var(--chat-primary);
        color: #fff;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: transform 0.2s;
    }

    .send-btn:hover { transform: scale(1.05); }

    /* Empty State */
    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: var(--chat-text-muted);
        text-align: center;
    }

    @media (max-width: 768px) {
        .chat-sidebar { width: 100%; position: absolute; inset: 0; display: none; }
        .chat-sidebar.active { display: flex; }
        .chat-main { width: 100%; }
        .chat-sidebar-width { width: 100%; }
    }
</style>

<%- include('partials/header') %>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<div class="chat-master-container">
    
    <!-- Sidebar -->
    <div class="chat-sidebar" id="sidebar-panel">
        <div class="sidebar-search-area">
            <h2 style="font-size: 18px; font-weight: 800; margin-bottom: 16px; color: var(--chat-primary);">المحادثات</h2>
            <div style="position: relative;">
                <i class="fas fa-search" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); color: #94a3b8;"></i>
                <input type="text" placeholder="بحث عن عميل..." style="width: 100%; padding: 10px 40px 10px 12px; border-radius: 10px; border: 1px solid #e2e8f0; background: #f8fafc; font-size: 13px; outline: none;">
            </div>
        </div>

        <div class="filter-group">
            <button onclick="setFilter('all')" class="filter-chip active" id="filter-all">الكل</button>
            <button onclick="setFilter('whatsapp')" class="filter-chip" id="filter-whatsapp"><i class="fab fa-whatsapp"></i> واتساب</button>
            <button onclick="setFilter('web')" class="filter-chip" id="filter-web"><i class="fas fa-globe"></i> الموقع</button>
            <button onclick="switchTab('requests')" class="filter-chip" id="filter-requests"><i class="fas fa-ban"></i> الإلغاء</button>
        </div>

        <div class="sessions-scroll" id="sessions-list">
            <!-- Sessions loaded here -->
        </div>
        <div class="sessions-scroll" id="requests-list" style="display:none;">
            <!-- Requests loaded here -->
        </div>
    </div>

    <!-- Main Chat Area -->
    <div class="chat-main">
        <div id="chat-welcome" class="empty-state">
            <div style="background: #e2e8f0; width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                <i class="fas fa-comments" style="font-size: 32px; color: #64748b;"></i>
            </div>
            <h3 style="font-weight: 800; color: #1e293b;">مرحباً بك في لوحة الدعم</h3>
            <p style="font-size: 14px;">اختر محادثة من القائمة الجانبية للبدء في الرد على العملاء</p>
        </div>

        <div id="active-chat-container" style="display: none; flex: 1; flex-direction: column;">
            <div class="chat-view-header">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <button class="d-md-none" onclick="toggleSidebar()" style="background: none; border: none; font-size: 20px; color: var(--chat-primary);"><i class="fas fa-arrow-right"></i></button>
                    <div id="header-avatar" style="width: 40px; height: 40px; border-radius: 50%; background: #0E4435; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 800;">ع</div>
                    <div>
                        <div id="header-name" style="font-weight: 800; font-size: 15px; color: var(--chat-text-main);">اسم العميل</div>
                        <div id="header-status" style="font-size: 11px; color: #22c55e; font-weight: 700;"><i class="fas fa-circle" style="font-size: 8px;"></i> متصل الآن</div>
                    </div>
                </div>
                <div style="display: flex; gap: 10px;">
                    <button id="take-over-btn" class="btn btn-sm btn-primary" style="background: var(--chat-primary); border-radius: 20px; font-size: 12px; padding: 6px 16px;">إيقاف البوت والرد</button>
                </div>
            </div>

            <div class="messages-viewport" id="messages-container">
                <!-- Messages -->
            </div>

            <div class="chat-footer" id="input-panel" style="display: none;">
                <div class="input-wrapper">
                    <input type="text" id="chat-input" class="chat-input-field" placeholder="اكتب رسالتك هنا...">
                    <button style="background: none; border: none; color: #94a3b8; padding: 0 10px;"><i class="fas fa-paperclip"></i></button>
                </div>
                <button id="send-btn" class="send-btn">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
            <div id="bot-status-msg" style="padding: 10px; text-align: center; background: #fffbe6; color: #856404; font-size: 12px; font-weight: 700; border-top: 1px solid #ffe58f;">
                🤖 البوت يقوم بالرد تلقائياً الآن. اضغط "إيقاف البوت" للتحكم اليدوي.
            </div>
        </div>
    </div>
</div>

<script>
    const SUPABASE_URL = "<%= supabaseUrl %>";
    const SUPABASE_ANON_KEY = "<%= supabaseAnonKey %>";
    const chatSupabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    let activeSessionId = null;
    let sessions = [];
    let messages = [];
    let currentPlatform = 'all';
    let currentTab = 'chats';

    const sessionsListEl = document.getElementById('sessions-list');
    const messagesContainerEl = document.getElementById('messages-container');
    const inputPanel = document.getElementById('input-panel');
    const botStatusMsg = document.getElementById('bot-status-msg');

    window.addEventListener('DOMContentLoaded', async () => {
        await fetchSessions();
        subscribeToSessions();
        subscribeToMessages();
    });

    async function fetchSessions() {
        const { data, error } = await chatSupabase.from('chat_sessions').select('*').order('updated_at', { ascending: false });
        if (!error) { sessions = data; renderSessions(); }
    }

    function subscribeToSessions() {
        chatSupabase.channel('public:chat_sessions').on('postgres_changes', { event: '*', schema: 'public', table: 'chat_sessions' }, payload => {
            if (payload.eventType === 'INSERT') sessions.unshift(payload.new);
            else if (payload.eventType === 'UPDATE') {
                const idx = sessions.findIndex(s => s.session_id === payload.new.session_id);
                if (idx > -1) sessions[idx] = payload.new;
                if (activeSessionId === payload.new.session_id) updateUI(payload.new);
            }
            renderSessions();
        }).subscribe();
    }

    function subscribeToMessages() {
        chatSupabase.channel('public:chat_messages').on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'chat_messages' }, payload => {
            if (payload.new.session_id === activeSessionId) {
                messages.push(payload.new);
                renderMessages();
                scrollBottom();
            }
        }).subscribe();
    }

    function setFilter(platform) {
        currentPlatform = platform;
        document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
        document.getElementById(`filter-${platform}`).classList.add('active');
        switchTab('chats');
        renderSessions();
    }

    function switchTab(tab) {
        currentTab = tab;
        if (tab === 'chats') {
            sessionsListEl.style.display = 'block';
            document.getElementById('requests-list').style.display = 'none';
        } else {
            sessionsListEl.style.display = 'none';
            document.getElementById('requests-list').style.display = 'block';
            document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
            document.getElementById('filter-requests').classList.add('active');
        }
    }

    function renderSessions() {
        sessionsListEl.innerHTML = '';
        const filtered = sessions.filter(s => currentPlatform === 'all' || (s.platform || (s.session_id.match(/^\d+$/) ? 'whatsapp' : 'web')) === currentPlatform);
        
        filtered.forEach(s => {
            const platform = s.platform || (s.session_id.match(/^\d+$/) ? 'whatsapp' : 'web');
            const isWhatsApp = platform === 'whatsapp';
            const isActive = activeSessionId === s.session_id;
            
            const div = document.createElement('div');
            div.className = `session-item ${isActive ? 'active' : ''}`;
            div.innerHTML = `
                <div style="display: flex; gap: 12px; align-items: center;">
                    <div style="width: 45px; height: 45px; border-radius: 50%; background: ${isWhatsApp ? '#25D366' : '#0ea5e9'}; display: flex; align-items: center; justify-content: center; color: #fff;">
                        <i class="${isWhatsApp ? 'fab fa-whatsapp' : 'fas fa-globe'}"></i>
                    </div>
                    <div style="flex: 1;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
                            <span style="font-weight: 800; font-size: 14px; color: var(--chat-text-main);">${isWhatsApp ? s.session_id : 'زائر الموقع'}</span>
                            <span style="font-size: 10px; color: #94a3b8;">${new Date(s.updated_at).toLocaleTimeString('ar-EG', {hour:'2-digit', minute:'2-digit'})}</span>
                        </div>
                        <div style="font-size: 12px; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 180px;">
                            ${s.status === 'human_requested' ? '⚠️ يطلب التحدث مع موظف' : 'محادثة نشطة'}
                        </div>
                    </div>
                </div>
            `;
            div.onclick = () => loadChat(s.session_id);
            sessionsListEl.appendChild(div);
        });
    }

    async function loadChat(sid) {
        activeSessionId = sid;
        document.getElementById('chat-welcome').style.display = 'none';
        document.getElementById('active-chat-container').style.display = 'flex';
        renderSessions();
        
        const session = sessions.find(s => s.session_id === sid);
        updateUI(session);

        const { data } = await chatSupabase.from('chat_messages').select('*').eq('session_id', sid).order('created_at', { ascending: true });
        messages = data || [];
        renderMessages();
        scrollBottom();
    }

    function updateUI(session) {
        if (!session) return;
        document.getElementById('header-name').textContent = session.session_id.match(/^\d+$/) ? `واتساب (${session.session_id})` : 'زائر الموقع';
        
        if (session.status === 'human_active') {
            inputPanel.style.display = 'flex';
            botStatusMsg.style.display = 'none';
            document.getElementById('take-over-btn').style.display = 'none';
        } else {
            inputPanel.style.display = 'none';
            botStatusMsg.style.display = 'block';
            document.getElementById('take-over-btn').style.display = 'block';
        }
    }

    function renderMessages() {
        messagesContainerEl.innerHTML = '';
        messages.forEach(msg => {
            const isMe = msg.sender_type === 'admin' || msg.sender_type === 'bot';
            const row = document.createElement('div');
            row.className = `msg-row ${isMe ? 'received' : 'sent'}`;
            
            let content = msg.content;
            if (content.startsWith('[IMAGE:')) {
                const id = content.match(/\[IMAGE:(.+)\]/)[1];
                content = `<img src="/admin/chat/media/${id}" style="max-width: 100%; border-radius: 8px; cursor: pointer;" onclick="window.open(this.src)">`;
            }

            row.innerHTML = `
                <div class="bubble">
                    ${content}
                    <div class="msg-time">${new Date(msg.created_at).toLocaleTimeString('ar-EG', {hour:'2-digit', minute:'2-digit'})}</div>
                </div>
            `;
            messagesContainerEl.appendChild(row);
        });
    }

    function scrollBottom() {
        setTimeout(() => messagesContainerEl.scrollTop = messagesContainerEl.scrollHeight, 50);
    }

    document.getElementById('send-btn').onclick = async () => {
        const val = document.getElementById('chat-input').value.trim();
        if (!val) return;
        document.getElementById('chat-input').value = '';
        
        const res = await fetch('/admin/chat/send', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sessionId: activeSessionId, content: val })
        });
    };

    document.getElementById('take-over-btn').onclick = async () => {
        await chatSupabase.from('chat_sessions').update({ status: 'human_active' }).eq('session_id', activeSessionId);
    };

    function toggleSidebar() {
        document.getElementById('sidebar-panel').classList.toggle('active');
    }
</script>

