<%- include('partials/header') %>

<style>
    :root { --primary: #0E4435; --primary-light: #1a6b56; --chat-bg: #ece5dd; }

    div.admin-layout > main.main-content { margin-right: 0 !important; width: 100% !important; min-height: 0 !important; }
    div.admin-layout > aside.sidebar {
        display: flex !important; width: 280px !important; right: 0 !important; top: 0 !important;
        height: 100dvh !important; border-radius: 0 !important; z-index: 1100 !important;
        transform: translateX(110%) !important; transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }
    div.admin-layout > aside.sidebar.active { transform: translateX(0) !important; }
    .sidebar-overlay {
        position: fixed; inset: 0; background: rgba(0,0,0,0.4); backdrop-filter: blur(4px);
        z-index: 1099; opacity: 0; pointer-events: none; transition: opacity 0.25s ease;
    }
    .sidebar-overlay.active { opacity: 1; pointer-events: auto; }
    .topbar { display: none !important; }
    .content-wrapper {
        padding: 0 !important; width: 100vw !important; max-width: 100vw !important; margin: 0 !important;
        display: flex !important; flex-direction: column !important;
        height: 100dvh !important; overflow: hidden !important; box-sizing: border-box;
    }

    .chat-wrap { display: flex; flex: 1; min-height: 0; width: 100%; max-width: 100%; overflow: hidden; box-sizing: border-box; }

    /* Sessions List */
    .sessions-panel {
        width: 320px; background: #fff; border-left: 1px solid #e2e8f0;
        display: flex; flex-direction: column; flex-shrink: 0;
    }
    .sp-header { padding: 14px 16px; border-bottom: 1px solid #f1f5f9; }
    .sp-header-top { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
    .sp-header h3 { margin: 0; font-size: 17px; font-weight: 800; color: var(--primary); }
    .header-menu-btn {
        width: 30px; height: 30px; border-radius: 8px; border: none;
        background: #f0f2f5; color: var(--primary); cursor: pointer;
        display: flex; align-items: center; justify-content: center; flex-shrink: 0;
        font-size: 14px; transition: background 0.15s;
    }
    .header-menu-btn:hover { background: #e2e8f0; }
    body.dark .header-menu-btn { background: #2a2a2a; color: #25d366; }
    .sp-search { position: relative; }
    .sp-search input {
        width: 100%; padding: 9px 34px 9px 12px; border-radius: 10px;
        border: none; background: #f0f2f5; outline: none;
        font-size: 13px; font-family: inherit; box-sizing: border-box;
    }
    .sp-search i { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 12px; }

    .sp-filters { display: flex; gap: 6px; padding: 8px 16px; border-bottom: 1px solid #f1f5f9; overflow-x: auto; }
    .sp-filters::-webkit-scrollbar { display: none; }
    .tab-btn {
        padding: 4px 12px; border-radius: 20px; border: none; background: #f0f2f5;
        font-size: 12px; cursor: pointer; font-family: inherit; white-space: nowrap; color: #475569; font-weight: 600;
    }
    .tab-btn.active { background: var(--primary); color: white; }

    .session-list { flex: 1; overflow-y: auto; }
    .s-item {
        padding: 12px 16px; cursor: pointer; display: flex; align-items: center; gap: 12px;
        transition: background 0.1s; border-bottom: 1px solid #f8fafc;
    }
    .s-item:hover { background: #f8fafc; }
    .s-item.active { background: #e8f4ef; }
    .s-avatar {
        width: 46px; height: 46px; border-radius: 50%; background: #e2e8f0;
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; color: var(--primary); font-size: 16px; position: relative; flex-shrink: 0;
    }
    .s-avatar-badge {
        position: absolute; bottom: -1px; left: -1px; width: 18px; height: 18px;
        border-radius: 50%; background: white; border: 2px solid #fff;
        display: flex; align-items: center; justify-content: center; font-size: 9px;
    }
    .s-unread-dot {
        width: 11px; height: 11px; border-radius: 50%; background: #25d366;
        position: absolute; bottom: 0; right: 0; border: 2px solid #fff;
    }
    .s-info { flex: 1; min-width: 0; }
    .s-name { font-weight: 600; font-size: 14px; color: #111; margin-bottom: 3px; display: flex; align-items: center; gap: 6px; }
    .s-preview { font-size: 12px; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .s-time { font-size: 10px; color: #94a3b8; flex-shrink: 0; }
    .unread-count {
        display: inline-flex; align-items: center; justify-content: center;
        min-width: 18px; height: 18px; background: #25d366; color: #fff;
        font-size: 10px; font-weight: 700; border-radius: 9px; padding: 0 5px;
    }

    /* Full Chat */
    .chat-main { flex: 1; display: flex; flex-direction: column; min-width: 0; min-height: 0; }
    .chat-wrap.panel-hidden .sessions-panel { display: none; }

    .chat-top {
        height: 56px; background: var(--primary); color: white; padding: 0 12px;
        display: flex; align-items: center; gap: 8px; flex-shrink: 0;
    }
    .chat-top-back {
        width: 32px; height: 32px; border-radius: 50%; border: none;
        background: transparent; color: white; cursor: pointer; flex-shrink: 0;
        display: none; align-items: center; justify-content: center; font-size: 14px;
    }
    .chat-top-back:hover { background: rgba(255,255,255,0.1); }
    @media (max-width: 768px) { .chat-top-back { display: flex; } }
    .chat-top-avatar {
        width: 38px; height: 38px; border-radius: 50%; background: rgba(255,255,255,0.2);
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 14px; flex-shrink: 0; color: white;
    }
    .chat-top-info { flex: 1; min-width: 0; }
    .chat-top-name { font-weight: 600; font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .chat-top-sub { font-size: 11px; opacity: 0.7; }
    .chat-top-actions { display: flex; gap: 4px; flex-shrink: 0; }
    .chat-top-btn {
        width: 36px; height: 36px; border-radius: 50%; border: none;
        background: rgba(255,255,255,0.15); color: white; cursor: pointer;
        display: flex; align-items: center; justify-content: center; font-size: 14px;
        transition: background 0.15s;
    }
    .chat-top-btn:hover { background: rgba(255,255,255,0.25); }
    .chat-top-btn.active { background: rgba(255,255,255,0.3); }

    .msgs-area {
        flex: 1; overflow-y: auto; padding: 16px 12px;
        display: flex; flex-direction: column; gap: 6px;
        background: var(--chat-bg); scroll-behavior: smooth;
    }
    .msgs-area::-webkit-scrollbar { width: 4px; }
    .msgs-area::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.12); border-radius: 4px; }

    .empty-chat { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; color: #aaa; }
    .empty-chat i { font-size: 44px; margin-bottom: 10px; opacity: 0.2; }

    .msg-row { display: flex; }
    .msg-row.by-user  { justify-content: flex-end; }
    .msg-row.by-agent { justify-content: flex-start; }

    .bubble {
        max-width: 75%; padding: 7px 12px; border-radius: 10px;
        font-size: 14px; line-height: 1.55; position: relative;
    }
    .by-user  .bubble { background: #d9fdd3; color: #111; border-bottom-right-radius: 2px; }
    .by-agent .bubble { background: #fff; color: #111; border-bottom-left-radius: 2px; box-shadow: 0 1px 1px rgba(0,0,0,0.06); }
    .by-agent.is-admin .bubble { background: #e1f3fb; border-bottom-left-radius: 2px; }
    .by-agent.is-bot   .bubble { background: #fff; }
    .bubble img { max-width: 100%; max-height: 220px; border-radius: 6px; cursor: pointer; display: block; margin: 2px 0; }
    .b-label { font-size: 11px; font-weight: 800; margin-bottom: 6px; opacity: 0.5; }
    .b-time  { font-size: 10px; margin-top: 6px; text-align: left; opacity: 0.45; }
    .date-sep { text-align: center; font-size: 11px; font-weight: 700; color: #64748b; padding: 8px 0 4px; position: sticky; top: 0; z-index: 1; }
    .date-sep span { background: #e2e8f0; padding: 3px 14px; border-radius: 8px; display: inline-block; }
    body.dark .date-sep span { background: #2a2a2a; color: #94a3b8; }

    .chat-footer {
        background: #f0f2f5; padding: 6px 10px; flex-shrink: 0;
    }
    .chat-footer .status-text {
        text-align: center; font-size: 12px; color: #64748b; padding: 4px 0;
    }
    .chat-input-row {
        display: flex; align-items: center; gap: 8px; padding: 2px 0;
    }
    .input-pill {
        flex: 1; background: #fff; border-radius: 24px; padding: 0 16px;
        display: flex; align-items: center; height: 44px; box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }
    .input-pill input {
        flex: 1; background: transparent; border: none; outline: none;
        font-size: 15px; font-family: inherit;
    }
    .send-btn {
        width: 44px; height: 44px; border-radius: 50%;
        background: var(--primary); color: white; border: none;
        cursor: pointer; display: flex; align-items: center;
        justify-content: center; flex-shrink: 0; transition: opacity 0.15s;
    }
    .send-btn:active { opacity: 0.7; }

    /* Order Panel */
    .order-panel {
        display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100vh; z-index: 99999;
        background: #fff; flex-direction: column;
    }
    .order-panel.active { display: flex; }
    .order-panel-header {
        height: 56px; background: var(--primary); color: white; padding: 0 12px;
        display: flex; align-items: center; gap: 8px; flex-shrink: 0;
    }
    .order-panel-body { flex: 1; overflow-y: auto; padding: 16px; }
    .order-card {
        background: #f8fafc; border-radius: 12px; padding: 14px; margin-bottom: 12px;
        border: 1px solid #f1f5f9;
    }
    .order-card h4 { margin: 0 0 8px; font-size: 14px; color: var(--primary); display: flex; justify-content: space-between; }
    .order-card .row { display: flex; justify-content: space-between; font-size: 13px; padding: 3px 0; color: #475569; }
    .order-card .status-badge {
        display: inline-block; padding: 2px 10px; border-radius: 12px;
        font-size: 11px; font-weight: 700;
    }

    /* Lightbox */
    #lightbox {
        display: none; position: fixed; inset: 0; z-index: 999999;
        background: rgba(0,0,0,0.93); justify-content: center; align-items: center;
    }
    #lightbox.active { display: flex; }
    #lightbox img { max-width: 95vw; max-height: 92vh; border-radius: 8px; }
    #lightbox .close {
        position: fixed; top: 16px; left: 16px; z-index: 1000000;
        width: 44px; height: 44px; border-radius: 50%; background: rgba(255,255,255,0.12);
        border: none; color: white; font-size: 20px; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
    }

    body.dark { background: #111; color: #ddd; }
    body.dark .sessions-panel,
    body.dark .chat-footer { background: #1a1a1a !important; border-color: #2a2a2a !important; }
    body.dark .sp-header h3 { color: #25d366; }
    body.dark .sp-search input { background: #2a2a2a; color: #ddd; }
    body.dark .tab-btn { background: #2a2a2a; color: #aaa; }
    body.dark .tab-btn.active { background: var(--primary); color: white; }
    body.dark .s-item { border-color: #222 !important; }
    body.dark .s-item.active { background: #1a2a22 !important; }
    body.dark .s-name { color: #ddd !important; }
    body.dark .s-preview { color: #888 !important; }
    body.dark .s-time { color: #666 !important; }
    body.dark .s-avatar { background: #333; color: #25d366; }
    body.dark .msgs-area { background: #0a0a0a !important; }
    body.dark .by-agent .bubble { background: #1e1e1e !important; color: #ddd !important; }
    body.dark .by-user .bubble { background: #054d33 !important; color: #eee !important; }
    body.dark .by-agent.is-admin .bubble { background: #0a2a3a !important; }
    body.dark .input-pill { background: #2a2a2a !important; }
    body.dark .input-pill input { color: #ddd !important; }
    body.dark .order-panel { background: #1a1a1a !important; }
    body.dark .order-card { background: #222 !important; border-color: #333 !important; color: #ccc !important; }
    body.dark .order-card h4 { color: #25d366 !important; }

    @media (max-width: 768px) {
        .sessions-panel { width: 100% !important; }
        .chat-main { display: none; }
        .chat-main.active { display: flex !important; }
        .chat-wrap.chat-open .sessions-panel { display: none; }
        .s-item { padding: 10px 14px; }
        .s-avatar { width: 42px; height: 42px; font-size: 14px; }
        .bubble { max-width: 85%; font-size: 15px; }
        .chat-top { height: 50px; }
        .chat-top-back { width: 36px; height: 36px; }
        .chat-top-avatar { width: 34px; height: 34px; font-size: 12px; }
    }
    @media (max-width: 480px) {
        .s-avatar { width: 38px; height: 38px; }
        .s-item { padding: 8px 12px; }
        .bubble { max-width: 90%; }
    }
</style>

<div class="chat-wrap">
    <div class="sessions-panel">
        <div class="sp-header">
            <div class="sp-header-top">
                <button class="header-menu-btn" onclick="toggleAdminMenu()" title="القائمة"><i class="fas fa-bars"></i></button>
                <h3>المحادثات</h3>
            </div>
            <div class="sp-search">
                <i class="fas fa-search"></i>
                <input type="text" id="search-input" placeholder="بحث...">
            </div>
        </div>
        <div class="sp-filters">
            <button class="tab-btn active" data-filter="all">الكل</button>
            <button class="tab-btn" data-filter="whatsapp"><i class="fab fa-whatsapp"></i> واتساب</button>
            <button class="tab-btn" data-filter="web"><i class="fas fa-globe"></i> الموقع</button>
        </div>
        <div class="session-list" id="session-list"></div>
    </div>

    <div class="chat-main">
        <div class="chat-top" id="chat-top" style="display:none;">
            <button class="chat-top-back" onclick="toggleSessions()" title="رجوع"><i class="fas fa-arrow-right"></i></button>
            <div class="chat-top-avatar" id="h-avatar">?</div>
            <div class="chat-top-info">
                <div class="chat-top-name" id="h-name"></div>
                <div class="chat-top-sub" id="h-sub"></div>
            </div>
            <div class="chat-top-actions">
                <button class="chat-top-btn" onclick="toggleOrders()" title="الطلبات" id="btn-orders"><i class="fas fa-shopping-bag"></i></button>
                <button class="chat-top-btn" onclick="toggleDark()" id="dark-btn" title="الوضع الليلي"><i class="fas fa-moon"></i></button>
                <button id="btn-take" class="chat-top-btn" onclick="takeOver()" style="display:none;" title="استلام"><i class="fas fa-hand-paper"></i></button>
                <button id="btn-end"  class="chat-top-btn" onclick="endConv()"  style="display:none;" title="إنهاء"><i class="fas fa-check"></i></button>
                <button id="btn-bot"  class="chat-top-btn" onclick="toBot()"    style="display:none;" title="للبوت"><i class="fas fa-robot"></i></button>
            </div>
        </div>

        <div class="msgs-area" id="msgs-area">
            <div class="empty-chat">
                <i class="fas fa-comments"></i>
                <p style="color:#94a3b8;font-size:14px;">اختر محادثة</p>
            </div>
        </div>

        <div class="chat-footer" id="chat-footer" style="display:none;">
            <div class="status-text" id="status-text">🤖 البوت يرد آلياً</div>
            <div class="chat-input-row" id="input-row" style="display:none;">
                <div class="input-pill">
                    <input type="text" id="msg-input" placeholder="اكتب رسالتك...">
                </div>
                <button class="send-btn" onclick="sendMsg()"><i class="fas fa-paper-plane"></i></button>
            </div>
        </div>
    </div>
</div>

<!-- Orders Panel -->
<div class="order-panel" id="order-panel">
    <div class="order-panel-header">
        <button class="chat-top-back" onclick="toggleOrders()" style="color:white;"><i class="fas fa-arrow-right"></i></button>
        <span style="font-weight:700;font-size:16px;">طلبات العميل</span>
    </div>
    <div class="order-panel-body" id="order-body">
        <div style="text-align:center;padding:40px 0;color:#94a3b8;">
            <i class="fas fa-spinner fa-spin" style="font-size:24px;margin-bottom:12px;display:block;"></i>
            جاري تحميل الطلبات...
        </div>
    </div>
</div>

<!-- Lightbox -->
<div id="lightbox" onclick="closeLightbox(event)">
    <button class="close" onclick="closeLightbox(event)"><i class="fas fa-times"></i></button>
    <img id="lightbox-img" alt="">
</div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
    const db = supabase.createClient('<%= supabaseUrl %>', '<%= supabaseAnonKey %>');
    const CSRF_TOKEN = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';

    let rawSessions = [], sessions = [], messages = [], activeId = null, filter = 'all', msgCh = null;
    const el = id => document.getElementById(id);
    const elSessionList = el('session-list');
    const elMsgs = el('msgs-area');
    const elFooter = el('chat-footer');
    const elStatus = el('status-text');
    const elInputRow = el('input-row');
    const elMsgInput = el('msg-input');

    (async () => {
        document.body.style.overflow = 'hidden';
        document.body.style.margin = '0';
        document.body.style.padding = '0';
        document.body.style.height = '100dvh';
        await loadSessions();
        subSessions();
        const sid = new URLSearchParams(window.location.search).get('sessionId') || localStorage.getItem('chatSessionId');
        if (sid) { localStorage.setItem('chatSessionId', sid); setTimeout(() => openSession(sid), 500); }
    })();

    async function loadSessions() {
        try {
            const r = await fetch('/admin/chat/sessions');
            rawSessions = (await r.json()).sessions || [];
        } catch (e) { rawSessions = []; }
        sessions = rawSessions;
        renderSessions();
    }

    function previewText(s) {
        if (!s.last_message) return s.status === 'human_requested' ? '⚠️ يطلب موظف' : s.status === 'human_active' ? '🧑‍💼 نشط' : '🤖 نشطة';
        let t = s.last_message;
        if (t.startsWith('[IMAGE:')) return '🖼️ صورة';
        if (t.startsWith('[TEMPLATE:')) return '📋 قالب';
        if (t.startsWith('[CLICKED:')) return '👆 ' + t.slice(8, -1);
        if (t.startsWith('[CHOICES:')) return t.slice(8, -1);
        return t.length > 55 ? t.slice(0, 52) + '...' : t;
    }

    function renderSessions() {
        const q = el('search-input').value.toLowerCase();
        const list = sessions.filter(s => {
            if (filter !== 'all' && s.platform !== filter) return false;
            return !q || s.session_id.toLowerCase().includes(q);
        });
        if (!list.length) return elSessionList.innerHTML = '<div style="padding:30px;text-align:center;color:#94a3b8;font-size:13px;">لا توجد محادثات</div>';
        elSessionList.innerHTML = list.map(s => {
            const wa = s.platform === 'whatsapp';
            const init = s.session_id.charAt(0).toUpperCase();
            const icon = wa ? '<i class="fab fa-whatsapp" style="color:#25d366"></i>' : '<i class="fas fa-globe" style="color:#3b82f6"></i>';
            const u = s.unread_count || 0;
            return `<div class="s-item ${s.session_id === activeId ? 'active' : ''}" onclick="openSession('${s.session_id}')">
                <div class="s-avatar">${init}${u > 0 ? '<span class="s-unread-dot"></span>' : '<span class="s-avatar-badge">' + icon + '</span>'}</div>
                <div class="s-info">
                    <div class="s-name">${wa ? s.session_id : 'زائر الموقع'}${u > 0 ? ' <span class="unread-count">' + (u > 99 ? '99+' : u) + '</span>' : ''}</div>
                    <div class="s-preview">${previewText(s)}</div>
                </div>
                <span class="s-time">${new Date(s.updated_at).toLocaleTimeString('ar-EG', {hour:'2-digit', minute:'2-digit'})}</span>
            </div>`;
        }).join('');
    }

    async function openSession(id) {
        activeId = id;
        localStorage.setItem('chatSessionId', id);
        const s = sessions.find(x => x.session_id === id);
        if (!s) return;
        el('chat-top').style.display = 'flex';
        el('h-avatar').textContent = id.charAt(0).toUpperCase();
        el('h-name').textContent = s.platform === 'whatsapp' ? id : 'زائر الموقع';
        el('h-sub').textContent = s.platform === 'whatsapp' ? 'واتساب' : 'الموقع';

        // Show order button only for WhatsApp (has phone number)
        el('btn-orders').style.display = s.platform === 'whatsapp' ? 'flex' : 'none';

        renderSessions();
        updateBtns(s);
        await loadMessages(id);
        subMessages(id);

        try {
            await fetch('/admin/chat/mark-read', {
                method: 'POST', headers: { 'Content-Type': 'application/json', 'CSRF-Token': CSRF_TOKEN },
                body: JSON.stringify({ sessionId: id })
            });
            const ss = sessions.find(x => x.session_id === id);
            if (ss) { ss.unread_count = 0; renderSessions(); }
        } catch (e) {}

        elFooter.style.display = 'block';
        el('order-panel').classList.remove('active');

        if (window.innerWidth <= 768) {
            document.querySelector('.chat-main').classList.add('active');
            document.querySelector('.chat-wrap').classList.add('chat-open');
        }
    }

    function toggleAdminMenu() {
        const sidebar = document.querySelector('.sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        if (!sidebar || !overlay) return;
        sidebar.classList.toggle('active');
        overlay.classList.toggle('active');
    }

    function toggleSessions() {
        if (window.innerWidth <= 768) {
            document.querySelector('.chat-main').classList.remove('active');
            document.querySelector('.chat-wrap').classList.remove('chat-open');
            el('order-panel').classList.remove('active');
            activeId = null;
            localStorage.removeItem('chatSessionId');
            elFooter.style.display = 'none';
            el('chat-top').style.display = 'none';
            renderSessions();
        } else {
            document.querySelector('.chat-wrap').classList.toggle('panel-hidden');
        }
    }

    function updateBtns(s) {
        const human = s.status === 'human_active';
        el('btn-take').style.display = human ? 'none' : 'flex';
        el('btn-end').style.display  = human ? 'flex' : 'none';
        el('btn-bot').style.display  = human ? 'flex' : 'none';
        elInputRow.style.display = human ? 'flex' : 'none';
        elStatus.style.display = human ? 'none' : 'block';
        elStatus.textContent = s.status === 'human_requested' ? '⚠️ ينتظر رد' : '🤖 البوت يرد آلياً';
    }

    async function loadMessages(id) {
        const { data } = await db.from('chat_messages').select('*').eq('session_id', id).order('created_at', { ascending: true });
        messages = data || [];
        renderMsgs();
    }

    function openLightbox(src) { el('lightbox-img').src = src; el('lightbox').classList.add('active'); }
    function closeLightbox(e) { if (e) e.stopPropagation(); el('lightbox').classList.remove('active'); }
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(e); });

    function fmtDate(d) {
        const now = new Date();
        const day = new Date(d);
        const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        const msgDate = new Date(day.getFullYear(), day.getMonth(), day.getDate());
        const diff = Math.floor((today - msgDate) / (1000*60*60*24));
        if (diff === 0) return 'اليوم';
        if (diff === 1) return 'أمس';
        return day.toLocaleDateString('ar-EG', {weekday:'long', day:'numeric', month:'long', year:'numeric'});
    }
    function renderMsgs() {
        if (!messages.length) {
            elMsgs.innerHTML = '<div class="empty-chat"><i class="fas fa-comment-slash"></i><p style="color:#94a3b8;">لا رسائل بعد</p></div>';
            return;
        }
        let lastDate = '';
        let html = '';
        messages.forEach(m => {
            const d = new Date(m.created_at);
            const dateKey = d.toDateString();
            if (dateKey !== lastDate) {
                lastDate = dateKey;
                html += `<div class="date-sep"><span>${fmtDate(m.created_at)}</span></div>`;
            }
            const u = m.sender_type === 'user';
            const b = m.sender_type === 'bot';
            const cls = u ? 'by-user' : `by-agent ${b ? 'is-bot' : 'is-admin'}`;
            const icon = u ? '👤' : b ? '🤖' : '🧑‍💼';
            const label = u ? 'عميل' : b ? 'هَوَسي' : 'موظف';
            const time = d.toLocaleTimeString('ar-EG', {hour:'2-digit', minute:'2-digit'});
            let txt = (m.content || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\n/g,'<br>');
            const img = txt.match(/\[IMAGE:(.+?)\]/);
            if (img) {
                txt = txt.replace(img[0], `<img src="/admin/chat/media/${img[1]}" onclick="openLightbox(this.src)" onerror="this.outerHTML='<span style=color:#999;font-size:12px;>🖼️ الصورة غير متاحة</span>'">`);
            }
            html += `<div class="msg-row ${cls}"><div class="bubble"><span class="b-label">${icon} ${label}</span>${txt}<div class="b-time">${time}</div></div></div>`;
        });
        elMsgs.innerHTML = html;
        elMsgs.scrollTop = elMsgs.scrollHeight;
    }

    // Toast notification
    function showToast(msg, type) {
        const existing = document.getElementById('wa-toast');
        if (existing) existing.remove();
        const t = document.createElement('div');
        t.id = 'wa-toast';
        t.style.cssText = 'position:fixed;bottom:90px;left:50%;transform:translateX(-50%);z-index:9999;background:#1e293b;color:#fff;padding:10px 20px;border-radius:12px;font-size:0.8rem;font-weight:700;max-width:90%;text-align:center;box-shadow:0 10px 30px rgba(0,0,0,0.3);animation:fadeInUp 0.3s ease;font-family:"Cairo",sans-serif;';
        t.textContent = msg;
        document.body.appendChild(t);
        setTimeout(() => { t.style.opacity = '0'; t.style.transition = 'opacity 0.3s'; setTimeout(() => t.remove(), 400); }, 4000);
    }

    function sendMsg() {
        const c = elMsgInput.value.trim();
        if (!c || !activeId) return;
        elMsgInput.value = '';
        fetch('/admin/chat/send', {
            method: 'POST', headers: { 'Content-Type': 'application/json', 'CSRF-Token': CSRF_TOKEN },
            body: JSON.stringify({ sessionId: activeId, content: c })
        })
        .then(r => r.json())
        .then(d => {
            if (!d.success && d.waError) {
                showToast(d.message || 'فشل إرسال رسالة واتساب', 'warning');
            } else if (d.fallback) {
                showToast('تم الإرسال عبر القالب (قد يختلف الشكل عن النص الأصلي)', 'info');
            }
        })
        .catch(() => {});
    }

    async function callApi(url) {
        try {
            const r = await fetch(url, {
                method: 'POST', headers: { 'Content-Type': 'application/json', 'CSRF-Token': CSRF_TOKEN },
                body: JSON.stringify({ sessionId: activeId })
            });
            return (await r.json()).success;
        } catch (e) { return false; }
    }
    async function takeOver() {
        if (await callApi('/admin/chat/takeover')) { await loadSessions(); if (activeId) openSession(activeId); }
        else { alert('فشل استلام المحادثة'); }
    }
    async function endConv() {
        if (!confirm('إنهاء المحادثة؟')) return;
        if (await callApi('/admin/chat/end')) { await loadSessions(); if (activeId) openSession(activeId); }
        else { alert('فشل إنهاء المحادثة'); }
    }
    async function toBot() {
        if (!confirm('إعادة المحادثة للبوت الذكي؟')) return;
        if (await callApi('/admin/chat/return-to-bot')) { await loadSessions(); if (activeId) openSession(activeId); }
        else { alert('فشل التحويل للبوت'); }
    }

    // Orders
    async function toggleOrders() {
        const panel = el('order-panel');
        if (panel.classList.contains('active')) { panel.classList.remove('active'); return; }
        if (!activeId) { alert('لا توجد محادثة مفتوحة'); return; }
        panel.classList.add('active');
        el('order-body').innerHTML = '<div style="text-align:center;padding:40px 0;color:#94a3b8;"><i class="fas fa-spinner fa-spin" style="font-size:24px;margin-bottom:12px;display:block;"></i>جاري التحميل...</div>';
        const digits = activeId.replace(/\D/g, '');
        try {
            const controller = new AbortController();
            const timeout = setTimeout(() => controller.abort(), 15000);
            const { data, error } = await db
                .from('orders')
                .select('id, order_number, status, total, created_at, shipping_address')
                .gte('created_at', new Date(Date.now() - 90*24*60*60*1000).toISOString())
                .order('created_at', { ascending: false })
                .limit(50)
                .abortSignal(controller.signal);
            clearTimeout(timeout);
            if (error) throw error;
            const matched = (data || []).filter(o => {
                const phone = (o.shipping_address?.phone || '').replace(/\D/g, '');
                return phone.includes(digits) || digits.includes(phone);
            });
            if (!matched.length) {
                el('order-body').innerHTML = '<div style="text-align:center;padding:40px;color:#94a3b8;"><i class="fas fa-box-open" style="font-size:40px;margin-bottom:12px;display:block;opacity:0.3;"></i>لا توجد طلبات لهذا الرقم</div>';
                return;
            }
            el('order-body').innerHTML = matched.map(o => {
                const statusColor = o.status === 'Delivered' ? '#16a34a' : o.status === 'Shipped' ? '#2563eb' : o.status === 'Cancelled' ? '#dc2626' : '#d97706';
                return `<div class="order-card">
                    <h4><span>طلب #${o.order_number || o.id?.slice(0,8)}</span><span class="status-badge" style="background:${statusColor}20;color:${statusColor};">${o.status || 'قيد الانتظار'}</span></h4>
                    <div class="row"><span>العميل</span><span>${o.shipping_address?.name || '—'}</span></div>
                    <div class="row"><span>الإجمالي</span><span>${o.total || 0} ج.م</span></div>
                    <div class="row"><span>التاريخ</span><span>${new Date(o.created_at).toLocaleDateString('ar-EG')}</span></div>
                </div>`;
            }).join('');
        } catch (e) {
            console.error('Orders direct query failed, trying backend fallback:', e);
            try {
                const r = await fetch('/admin/chat/orders/' + encodeURIComponent(activeId));
                const d = await r.json();
                if (!d.success || !d.orders?.length) {
                    el('order-body').innerHTML = '<div style="text-align:center;padding:40px;color:#94a3b8;"><i class="fas fa-box-open" style="font-size:40px;margin-bottom:12px;display:block;opacity:0.3;"></i>لا توجد طلبات لهذا الرقم</div>';
                    return;
                }
                el('order-body').innerHTML = d.orders.map(o => {
                    const statusColor = o.status === 'Delivered' ? '#16a34a' : o.status === 'Shipped' ? '#2563eb' : o.status === 'Cancelled' ? '#dc2626' : '#d97706';
                    return `<div class="order-card">
                        <h4><span>طلب #${o.order_number || o.id?.slice(0,8)}</span><span class="status-badge" style="background:${statusColor}20;color:${statusColor};">${o.status || 'قيد الانتظار'}</span></h4>
                        <div class="row"><span>العميل</span><span>${o.customer_name || '—'}</span></div>
                        <div class="row"><span>الإجمالي</span><span>${o.total || 0} ج.م</span></div>
                        <div class="row"><span>التاريخ</span><span>${new Date(o.created_at).toLocaleDateString('ar-EG')}</span></div>
                    </div>`;
                }).join('');
            } catch (e2) {
                console.error('Orders fallback also failed:', e2);
                el('order-body').innerHTML = '<div style="text-align:center;padding:40px;color:#dc2626;">تعذر تحميل الطلبات. حاول مرة أخرى.</div>';
            }
        }
    }

    function subSessions() {
        db.channel('c-sessions').on('postgres_changes', { event: '*', schema: 'public', table: 'chat_sessions' }, async () => {
            await loadSessions();
            if (activeId) { const s = sessions.find(x => x.session_id === activeId); if (s) updateBtns(s); }
        }).subscribe();
    }

    function subMessages(id) {
        if (msgCh) db.removeChannel(msgCh);
        msgCh = db.channel('c-msgs-' + id).on('postgres_changes', {
            event: 'INSERT', schema: 'public', table: 'chat_messages', filter: `session_id=eq.${id}`
        }, p => {
            messages.push(p.new); renderMsgs();
            if (activeId === id) {
                fetch('/admin/chat/mark-read', {
                    method: 'POST', headers: { 'Content-Type': 'application/json', 'CSRF-Token': CSRF_TOKEN },
                    body: JSON.stringify({ sessionId: id })
                }).catch(() => {}).then(() => loadSessions());
            } else { loadSessions(); }
        }).subscribe();
    }

    document.querySelectorAll('.tab-btn').forEach(b => b.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach(x => x.classList.remove('active'));
        b.classList.add('active');
        filter = b.dataset.filter;
        renderSessions();
    }));
    el('search-input').addEventListener('input', renderSessions);
    elMsgInput.addEventListener('keypress', e => { if (e.key === 'Enter') sendMsg(); });

    function toggleDark() {
        document.body.classList.toggle('dark');
        localStorage.setItem('chatDark', document.body.classList.contains('dark'));
        el('dark-btn').innerHTML = document.body.classList.contains('dark') ? '<i class="fas fa-sun"></i>' : '<i class="fas fa-moon"></i>';
    }
    if (localStorage.getItem('chatDark') === 'true') {
        document.body.classList.add('dark');
        el('dark-btn').innerHTML = '<i class="fas fa-sun"></i>';
    }
</script>
