<%- include('partials/header', { title: 'لوحة التحكم' , pageTitle: 'لوحة التحكم' , page: 'dashboard' }) %>

    <div style="margin-bottom: 2rem;">
        <h2 style="color: var(--dark-gray); font-size: 1.5rem;">👋 أهلاً بك في لوحة التحكم</h2>
        <p style="color: var(--medium-gray);">إليك نظرة عامة على أداء متجرك</p>
    </div>

    <!-- Stats Grid -->
    <div class="stats-grid">
        <a href="/orders" style="text-decoration: none;">
            <div class="stat-card primary">
                <div class="stat-header">
                    <div>
                        <div class="stat-value">
                            <%= revenue %> ج.م
                        </div>
                        <div class="stat-label">إجمالي المبيعات</div>
                    </div>
                    <div class="stat-icon">
                        <i class="fas fa-sack-dollar"></i>
                    </div>
                </div>
            </div>
        </a>

        <a href="/orders" style="text-decoration: none;">
            <div class="stat-card warning">
                <div class="stat-header">
                    <div>
                        <div class="stat-value">
                            <%= ordersCount %>
                        </div>
                        <div class="stat-label">الطلبات</div>
                    </div>
                    <div class="stat-icon" style="background: rgba(243,156,18,0.1); color: var(--warning);">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                </div>
            </div>
        </a>

        <a href="/products" style="text-decoration: none;">
            <div class="stat-card info">
                <div class="stat-header">
                    <div>
                        <div class="stat-value">
                            <%= productsCount %>
                        </div>
                        <div class="stat-label">المنتجات</div>
                    </div>
                    <div class="stat-icon" style="background: rgba(52,152,219,0.1); color: var(--info);">
                        <i class="fas fa-box"></i>
                    </div>
                </div>
            </div>
        </a>

        <a href="/categories" style="text-decoration: none;">
            <div class="stat-card success">
                <div class="stat-header">
                    <div>
                        <div class="stat-value">
                            <%= categoriesCount %>
                        </div>
                        <div class="stat-label">التصنيفات</div>
                    </div>
                    <div class="stat-icon">
                        <i class="fas fa-tags"></i>
                    </div>
                </div>
            </div>
        </a>

        <a href="/users" style="text-decoration: none;">
            <div class="stat-card primary">
                <div class="stat-header">
                    <div>
                        <div class="stat-value">
                            <%= usersCount %>
                        </div>
                        <div class="stat-label">المستخدمين</div>
                    </div>
                    <div class="stat-icon">
                        <i class="fas fa-users"></i>
                    </div>
                </div>
            </div>
        </a>

        <a href="/banners" style="text-decoration: none;">
            <div class="stat-card danger">
                <div class="stat-header">
                    <div>
                        <div class="stat-value">
                            <%= bannersCount %>
                        </div>
                        <div class="stat-label">البنرات</div>
                    </div>
                    <div class="stat-icon" style="background: rgba(231,76,60,0.1); color: var(--danger);">
                        <i class="fas fa-images"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Content Grid -->
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem;">
        <!-- Recent Orders -->
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">
                    <i class="fas fa-shopping-cart"></i> أحدث الطلبات
                </h2>
                <a href="/orders" class="btn btn-secondary btn-sm">عرض الكل</a>
            </div>

            <% if (orders && orders.length> 0) { %>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>رقم الطلب</th>
                                <th>المبلغ</th>
                                <th>الحالة</th>
                                <th>التاريخ</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% orders.forEach(order=> { %>
                                <tr>
                                    <td>#<%= order.id.substring(0, 8) %>
                                    </td>
                                    <td>
                                        <%= parseFloat(order.total).toFixed(2) %> ج.م
                                    </td>
                                    <td>
                                        <% const statusMap={ 'Processing' : 'warning' , 'Shipped' : 'info' , 'Delivered'
                                            : 'success' , 'Cancelled' : 'danger' }; %>
                                            <span class="badge badge-<%= statusMap[order.status] || 'warning' %>">
                                                <%= order.status || 'Processing' %>
                                            </span>
                                    </td>
                                    <td>
                                        <%= new Date(order.created_at).toLocaleDateString('ar-EG') %>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } else { %>
                    <div class="text-center" style="padding: 3rem; color: var(--medium-gray);">
                        <i class="fas fa-shopping-bag" style="font-size: 3rem; opacity: 0.3; margin-bottom: 1rem;"></i>
                        <p>لا توجد طلبات حتى الآن</p>
                    </div>
                    <% } %>
        </div>

        <!-- Quick Actions -->
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">
                    <i class="fas fa-bolt"></i> إجراءات سريعة
                </h2>
            </div>

            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                <a href="/products/new" class="btn btn-primary">
                    <i class="fas fa-plus"></i> إضافة منتج
                </a>
                <a href="/categories" class="btn btn-secondary">
                    <i class="fas fa-tags"></i> إدارة التصنيفات
                </a>
                <a href="/banners/new" class="btn btn-secondary">
                    <i class="fas fa-images"></i> إضافة بنر
                </a>
                <a href="/orders" class="btn btn-secondary">
                    <i class="fas fa-shopping-cart"></i> عرض الطلبات
                </a>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>